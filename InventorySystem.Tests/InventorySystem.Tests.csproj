<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="TestData\ClientCostingSample.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\LatestClientCosting.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\InventorySystem\wwwroot\templates\Bright_Packages_Cost_Sheet_Template.xlsx" Link="TestData\CostSheetTemplate.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventorySystem\InventorySystem.csproj" />
    <ProjectReference Include="..\InventorySystem.Services\InventorySystem.Services.csproj" />
    <ProjectReference Include="..\InventorySystem.Data\InventorySystem.Data.csproj" />
    <ProjectReference Include="..\InventorySystem.Core\InventorySystem.Core.csproj" />
  </ItemGroup>

</Project>
