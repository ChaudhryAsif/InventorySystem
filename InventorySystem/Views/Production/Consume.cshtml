@model InventorySystem.Core.Models.ProductionOrder
@using System.Globalization
@{ Layout = "_Layout"; ViewData["Title"] = "Record Production";
   var materials = Model.Materials?.ToList() ?? [];
   var ready = Model.UsesEstimatedConsumption && Model.Status == "Pending"; }
<link href="~/css/accounts.css" rel="stylesheet" />
<div class="ac-page">
    <h2>Record Boxes Produced — Order #@Model.ProductionOrderId</h2>
    <p><strong>@Model.ProductName</strong> · Ordered: @Model.OrderQty boxes · Status: @Model.Status</p>
    <p>Material usage is an <strong>estimate from the saved cost sheet</strong>, not measured consumption. Posting deducts materials and adds finished boxes together.</p>
    @if (!Model.UsesEstimatedConsumption)
    { <p class="ac-empty">This older order has no saved production estimate. Edit and save an unstarted order first. Orders with previous consumption require an administrator to reconcile their stock.</p> }
    @if (ready)
    {
        <label for="producedQty">Boxes produced</label>
        <input id="producedQty" type="number" min="1" max="@Model.OrderQty" step="1" value="@Model.OrderQty" oninput="previewProduction()" class="ac-input" />
        <p>One posting per order. A smaller quantity closes the order at that quantity; create another order for any balance.</p>
    }
    else { <p>Recorded output: <strong>@Model.ProducedQty boxes</strong>. This order cannot be posted again.</p> }
    <div class="ac-table-card"><table class="ac-table"><thead><tr><th>Estimated material</th><th>Unit</th><th>Qty / Box</th><th>Estimated qty to deduct</th></tr></thead>
        <tbody>@foreach (var m in materials) {
            <tr data-per-box="@m.KgPerUnit.ToString(CultureInfo.InvariantCulture)" data-unit="@m.Unit"><td>@m.ItemName</td><td>@m.Unit</td><td>@m.KgPerUnit.ToString("N6")</td><td class="estimate-kg">—</td></tr>
        }</tbody></table></div>
    @if (ready) { <button id="recordBtn" class="ac-btn ac-btn-primary" onclick="recordProduction()">Record Production &amp; Update Stock</button> }
    <a class="ac-btn ac-btn-outline" href="/Production/Index">Back to Orders</a>
</div>
<script>
function previewProduction() {
    const boxes = Number(document.getElementById('producedQty')?.value || @Model.ProducedQty);
    document.querySelectorAll('[data-per-box]').forEach(row => {
        const raw = Number(row.dataset.perBox) * boxes;
        row.querySelector('.estimate-kg').textContent = row.dataset.unit === 'pcs'
            ? String(Math.ceil(raw - 1e-9))
            : (Math.ceil(raw * 1000 - 1e-9) / 1000).toFixed(3);
    });
}
async function recordProduction() {
    const boxes = Number(document.getElementById('producedQty').value);
    if (!Number.isInteger(boxes) || boxes < 1 || boxes > @Model.OrderQty) { await alertDialog('Enter a whole number between 1 and the ordered quantity.'); return; }
    if (!(await confirmDialog(`Record ${boxes} boxes, deduct estimated materials, and close this order?`))) return;
    const button = document.getElementById('recordBtn'); button.disabled = true;
    try {
        const response = await fetch('/Production/Record', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({productionOrderId:@Model.ProductionOrderId, producedQty:boxes})});
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || 'Production could not be recorded.');
        await alertDialog(data.message); location.href = '/Production/Index';
    } catch(error) { await alertDialog(error.message); button.disabled = false; }
}
previewProduction();
</script>
