@{
    Layout = "_Layout";
    ViewData["Title"] = "Production Orders";
    var orders = Model as IEnumerable<dynamic> ?? new List<dynamic>();
    int pending   = orders.Count(o => (string)o.Status == "Pending");
    int inProd    = orders.Count(o => (string)o.Status == "InProduction");
    int completed = orders.Count(o => (string)o.Status == "Completed");
    int urgent    = orders.Count(o => (int)o.DaysLeft <= 2
                                   && (string)o.Status != "Completed"
                                   && (string)o.Status != "Cancelled" && (string)o.Status != "Reversed");
}

<style>
    .status-badge        { padding:.3rem .8rem; border-radius:20px; font-size:.75rem; font-weight:600; }
    .status-Pending      { background:#fef3c7; color:#92400e; }
    .status-InProduction { background:#dbeafe; color:#1e40af; }
    .status-Completed    { background:#dcfce7; color:#166534; }
    .status-Cancelled    { background:#fee2e2; color:#991b1b; }
    .days-ok     { color:#16a34a; font-weight:600; }
    .days-warn   { color:#d97706; font-weight:600; }
    .days-urgent { color:#dc2626; font-weight:600; }
    .action-btns { display:flex; gap:.4rem; flex-wrap:wrap; }
    .btn-materials { background:#3b82f6; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .btn-consume   { background:#16a34a; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .btn-complete  { background:#7c3aed; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .btn-cancel    { background:#ef4444; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .btn-delete    { background:#6b7280; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .btn-edit      { background:#f59e0b; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .btn-print     { background:#0f172a; color:#fff; border:none; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; cursor:pointer; }
    .summary-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:1.5rem; }
    .summary-card  { background:#fff; border-radius:10px; padding:1rem 1.2rem; box-shadow:0 2px 8px rgba(0,0,0,.07); }
    .summary-card .val { font-size:1.6rem; font-weight:700; color:#1e3a5f; }
    .summary-card .lbl { font-size:.78rem; color:#6b7280; margin-top:.2rem; }
    .prod-table-wrap { background:#fff; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.07); overflow:hidden; }
    .prod-table { width:100%; border-collapse:collapse; font-size:.85rem; }
    .prod-table th { background:#1e3a5f; color:#fff; padding:.7rem .9rem; text-align:left; font-weight:600; white-space:nowrap; }
    .prod-table td { padding:.65rem .9rem; border-bottom:1px solid #f0f0f0; vertical-align:middle; }
    .prod-table tbody tr:hover { background:#f8fafc; }

    .prod-table-wrap { overflow-x:auto; }
    .prod-table { min-width:900px; }
    .prod-table th:last-child, .prod-table td:last-child { position:sticky; right:0; box-shadow:-6px 0 8px -6px rgba(15,23,42,.18); }
    .prod-table td:last-child { background:#fff; }
    .prod-table tbody tr:hover td:last-child { background:#f8fafc; }
    @@media screen and (max-width:768px) {
        .summary-cards { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @@media screen and (max-width:400px) {
        .summary-cards { grid-template-columns:minmax(0,1fr); }
    }

    @@media screen and (max-width:768px) {
        .mobile-page-header { flex-wrap:wrap; gap:1rem; }
        .mobile-page-header > div { min-width:0; }
        .mobile-page-header h2 { overflow-wrap:anywhere; }
    }

</style>

<div class="mobile-page-header" style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.5rem;">
    <div>
        <h2 style="font-size:1.6rem;font-weight:700;color:#1e3a5f;margin:0;">🏭 Production Orders</h2>
        <p style="color:#6b7280;margin:.2rem 0 0;font-size:.9rem;">Manufacturing orders linked to approved cost sheets</p>
    </div>
    <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
        <a href="/Production/Create"
           style="background:#1e3a5f;color:#fff;padding:.55rem 1.4rem;border-radius:8px;text-decoration:none;font-weight:600;font-size:.9rem;">
            + New Production Order
        </a>
    </div>
</div>

<div class="summary-cards">
    <div class="summary-card">
        <div class="val">@pending</div>
        <div class="lbl">⏳ Pending</div>
    </div>
    <div class="summary-card">
        <div class="val" style="color:#1e40af">@inProd</div>
        <div class="lbl">🏭 In Production</div>
    </div>
    <div class="summary-card">
        <div class="val" style="color:#16a34a">@completed</div>
        <div class="lbl">✅ Completed</div>
    </div>
    <div class="summary-card">
        <div class="val" style="color:#dc2626">@urgent</div>
        <div class="lbl">🔴 Urgent (≤2 days)</div>
    </div>
</div>

<div class="prod-table-wrap">
    <table class="prod-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Product / Item</th>
                <th>Box Style</th>
                <th>Ordered / Produced</th>
                <th>Agreed / Box (before GST)</th>
                <th>Agreed Value (incl. GST)</th>
                <th>Order Date</th>
                <th>Delivery Date</th>
                <th>Days Left</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var o in orders)
            {
                string status    = (string)o.Status;
                int    daysLeft  = (int)o.DaysLeft;
                string daysClass = daysLeft <= 1 ? "days-urgent" : daysLeft <= 3 ? "days-warn" : "days-ok";
                string daysText  = daysLeft < 0  ? "Overdue!" : daysLeft == 0 ? "Today!" : $"{daysLeft}d";
                decimal? fRate   = (decimal?)o.AgreedUnitPrice;
                decimal tVal     = (decimal)(o.TotalValue ?? 0m);
                int     orderId  = (int)o.ProductionOrderId;

                <tr>
                    <td>@(i++)</td>
                    <td><strong>#@orderId</strong></td>
                    <td>@o.CustomerName</td>
                    <td>@o.ProductName</td>
                    <td><span style="font-size:.78rem;color:#6b7280">@o.BoxStyle</span></td>
                    <td>@((int)o.OrderQty) / @((int)o.ProducedQty)@if (status == "InProduction") { <small style="display:block;">@(((int)o.OrderQty) - ((int)o.ProducedQty)) remaining</small> }@{ var soldQty = (decimal)o.Invoiced; var unsoldQty = (int)o.ProducedQty - soldQty; }@if (soldQty > 0) { <small style="display:block;color:@(unsoldQty > 0 ? "#b45309" : "#166534")">@(unsoldQty > 0 ? unsoldQty.ToString("0.##") + " unsold" : "fully invoiced")</small> }</td>
                    <td>@(fRate?.ToString("N2") ?? "Not recorded")<small style="display:block;">GST @(((decimal)o.AgreedGstPercent).ToString("0.##"))%</small></td>
                    <td><strong>@(fRate.HasValue ? tVal.ToString("N2") : "Not recorded")</strong></td>
                    <td>@(((DateTime)o.OrderDate).ToString("dd-MMM-yyyy"))</td>
                    <td>@(((DateTime)o.DeliveryDate).ToString("dd-MMM-yyyy"))</td>
                    <td><span class="@daysClass">@daysText</span></td>
                    <td><span class="status-badge status-@status">@(status == "InProduction" ? "In Production" : status)</span>@if (o.ClosedShortUtc != null) { <small style="display:block;">closed short</small> }</td>
                    <td>
                        @{
                            bool canRecord = status == "Pending" || status == "InProduction";
                            bool usesEst   = (status == "Completed" || status == "InProduction") && (bool)o.UsesEstimatedConsumption;
                            decimal invoiced = (decimal)o.Invoiced, unsold = (int)o.ProducedQty - invoiced;
                            bool canSale   = usesEst && fRate.HasValue && unsold > 0;
                            bool hasBatch  = (bool)o.HasBatches;
                        }
                        <div class="am">
                            @if (canRecord)
                            {
                                <button class="btn-consume" onclick="openRecord(@orderId)">📦 @(status == "InProduction" ? "Record Batch" : "Record Production")</button>
                            }
                            else if (canSale)
                            {
                                <a class="btn-materials" style="text-decoration:none;" href="/Sale/Index?productionOrderId=@orderId">Create Sale</a>
                            }
                            else
                            {
                                <button class="btn-materials" onclick="openMaterials(@orderId)">📋 Materials</button>
                            }
                            <button type="button" class="am-toggle" aria-haspopup="menu" aria-expanded="false" title="More actions">&#8943;</button>
                            <div class="am-menu" role="menu">
                                @if (canRecord || canSale)
                                {
                                    <button onclick="openMaterials(@orderId)">📋 Materials</button>
                                }
                                <a href="/Production/Print/@orderId" target="_blank" rel="noopener">🖨 Print</a>
                                @if (status == "Pending" && User.IsInRole("SuperAdmin"))
                                {
                                    <button onclick="location.href='/Production/Edit/@orderId'">✏️ Edit</button>
                                }
                                @if (canRecord && canSale)
                                {
                                    <a href="/Sale/Index?productionOrderId=@orderId">Create Sale</a>
                                }
                                @if (usesEst && hasBatch && status == "Completed")
                                {
                                    <button onclick="openRecord(@orderId)">📦 Batches</button>
                                }
                                @if (usesEst && !hasBatch)
                                {
                                    <button class="am-danger" onclick="reverseOrder(@orderId)">Reverse Production</button>
                                }
                                @if (status == "Pending")
                                {
                                    <hr>
                                    <button class="am-danger" onclick="cancelOrder(@orderId)">✖ Cancel</button>
                                    <button class="am-danger" onclick="deleteOrder(@orderId)">🗑 Delete</button>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
            @if (!orders.Any())
            {
                <partial name="_ListEmptyState" model='new InventorySystem.Models.ListEmptyState(13, "No production orders yet", "Create a production order from a Final cost sheet to plan your finished goods.", "+ Create Production Order", "/Production/Create")' />
            }
        </tbody>
    </table>
</div>

<style>
    .mat-pop { display:none; position:fixed; inset:0; z-index:4000; background:rgba(15,23,42,.55); align-items:center; justify-content:center; padding:1rem; }
    .mat-pop.open { display:flex; }
    .mat-pop-box { width:min(1100px,100%); height:min(86vh,760px); background:#f8fafc; border-radius:12px; box-shadow:0 20px 50px rgba(0,0,0,.35); display:flex; flex-direction:column; overflow:hidden; }
    .mat-pop-bar { display:flex; justify-content:space-between; align-items:center; padding:.6rem 1rem; background:#1e3a5f; color:#fff; font-weight:600; }
    .mat-pop-bar button { background:none; border:none; color:#fff; font-size:1.5rem; line-height:1; cursor:pointer; }
    .mat-pop iframe { flex:1; width:100%; border:0; }
</style>
<div class="mat-pop" id="matPop" onclick="if(event.target===this)closeMaterials()">
    <div class="mat-pop-box" role="dialog" aria-modal="true" aria-label="Material requirements">
        <div class="mat-pop-bar"><span id="matPopTitle">Material Requirements</span><button type="button" aria-label="Close" onclick="closeMaterials()">&times;</button></div>
        <iframe id="matPopFrame" title="Material requirements"></iframe>
    </div>
</div>

<script>
let productionChanged = false;
function markProductionChanged() { productionChanged = true; }
function openPopup(title, url) {
    document.getElementById('matPopTitle').textContent = title;
    document.getElementById('matPopFrame').src = url;
    document.getElementById('matPop').classList.add('open');
}
function openMaterials(id) { openPopup('Material Requirements - Order #' + id, '/Production/Materials/' + id + '?popup=1'); }
function openRecord(id) { openPopup('Record Production - Order #' + id, '/Production/Consume/' + id + '?popup=1'); }
function closeMaterials() {
    document.getElementById('matPop').classList.remove('open');
    document.getElementById('matPopFrame').removeAttribute('src');
    if (productionChanged) location.reload();
}
const newOrderId = Number(new URLSearchParams(location.search).get('record'));
if (newOrderId > 0) { history.replaceState(null, '', '/Production/Index'); openRecord(newOrderId); }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMaterials(); });
async function reverseOrder(id) {
    const reason = await requestOperationReason('Production reversal reason', 'Confirm reason');
    if (!reason || reason.trim().length < 3) return;
    if (!(await confirmDialog('Remove the produced boxes and restore their estimated materials?', {danger:true}))) return;
    const response = await fetch('/Production/Reverse', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({productionOrderId:id, reason})});
    const data = await response.json();
    if (data.success) location.reload(); else await alertDialog(data.message || 'Reversal failed.');
}
async function cancelOrder(id) {
    if (!(await confirmDialog('Cancel this production order?', { danger: true }))) return;
    fetch(`/Production/Cancel/${id}`, { method: 'POST' })
        .then(r => r.json())
        .then(async d => { if (d.success) location.reload(); else await alertDialog(d.message); });
}
async function deleteOrder(id) {
    if (!(await confirmDialog('Permanently delete this order?', { danger: true }))) return;
    fetch(`/Production/Delete/${id}`, { method: 'POST' })
        .then(r => r.json())
        .then(async d => { if (d.success) location.reload(); else await alertDialog(d.message); });
}
</script>
