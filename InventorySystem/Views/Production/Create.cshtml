@model InventorySystem.Core.Models.ProductionOrder
@{
    Layout = "_Layout";
    bool isEdit = Model != null && Model.ProductionOrderId > 0;
    ViewData["Title"] = isEdit ? "Edit Production Order" : "Create Production Order";
    var finalSheets = (ViewBag.FinalSheets as IEnumerable<dynamic>) ?? new List<dynamic>();
    int selectedId  = (int)(ViewBag.SelectedCostSheetId ?? 0);
}

<style>
    .po-card   { background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,.08); padding:1.5rem; margin-bottom:1.2rem; }
    .po-title  { font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em;
                 color:#fff; background:#1e3a5f; padding:.4rem .9rem; border-radius:6px;
                 margin-bottom:1rem; display:inline-block; }
    .po-grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem; }
    .po-fg     { display:flex; flex-direction:column; gap:.3rem; }
    .po-fg label { font-size:.78rem; font-weight:600; color:#374151; }
    .setup-box { border:1px solid #fde68a; background:#fffbeb; }
    .setup-head { display:flex; gap:.8rem; align-items:flex-start; }
    .setup-icon { font-size:1.3rem; line-height:1.2; }
    .setup-head strong { display:block; font-size:1.02rem; color:#92400e; }
    .setup-head p { margin:.2rem 0 0; color:#78350f; font-size:.88rem; }
    .setup-list { list-style:none; margin:.9rem 0 0; padding:0; display:grid; gap:.5rem; }
    .setup-list li { display:flex; gap:.6rem; align-items:flex-start; background:#fff; border:1px solid #fde68a; border-radius:9px; padding:.6rem .8rem; }
    .setup-list .x { color:#dc2626; font-weight:800; line-height:1.3; }
    .setup-list b { display:block; color:#1e293b; font-size:.9rem; }
    .setup-list small { display:block; color:#64748b; font-size:.8rem; margin-top:.1rem; }
    .setup-actions { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin-top:1rem; }
    .setup-btn { border:1px solid #cbd5e1; background:#fff; color:#1e3a5f; border-radius:8px; padding:.5rem 1rem; font-weight:600; font-size:.87rem; cursor:pointer; text-decoration:none; }
    .setup-btn.primary { background:#1e3a5f; color:#fff; border-color:#1e3a5f; }
    .setup-note { color:#78350f; font-size:.85rem; }
    .po-input  { padding:.45rem .7rem; border:1px solid #d1d5db; border-radius:7px; font-size:.87rem; width:100%; box-sizing:border-box; }
    .po-input:focus { outline:none; border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,.12); }
    .po-input[readonly] { background:#f3f4f6; color:#6b7280; }
    .info-box  { background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:1rem; margin-top:.8rem; }
    .info-row  { display:flex; gap:2rem; flex-wrap:wrap; }
    .info-item { font-size:.83rem; }
    .info-item span { font-weight:700; color:#1e40af; }
    .btn-save  { background:#1e3a5f; color:#fff; border:none; padding:.6rem 2rem; border-radius:8px; font-size:.95rem; font-weight:600; cursor:pointer; }
    .btn-save:hover    { background:#2d5a9e; }
    .btn-save:disabled { background:#9ca3af; cursor:not-allowed; }

    @@media screen and (max-width:768px) {
        .po-grid-3 { grid-template-columns:minmax(0,1fr); }
        .po-card { padding:1rem; }
        .po-fg { min-width:0; }
    }

    @@media screen and (max-width:768px) {
        .mobile-page-header { flex-wrap:wrap; gap:1rem; }
        .mobile-page-header > div { min-width:0; }
        .mobile-page-header h2 { overflow-wrap:anywhere; }
    }

</style>

<div class="mobile-page-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
    <div>
        <h2 style="font-size:1.5rem;font-weight:700;color:#1e3a5f;margin:0;">🏭 @(isEdit ? $"Edit Production Order #{Model!.ProductionOrderId}" : "Create Production Order")</h2>
        <p style="color:#6b7280;margin:.2rem 0 0;font-size:.9rem;">@(isEdit ? "Update this order's cost sheet, quantity or dates" : "Create a production order from an approved (Final) Cost Sheet")</p>
    </div>
    <a href="/Production/Index" style="color:#6b7280;font-size:.9rem;">← Back to Orders</a>
</div>

@if (isEdit && Model!.Status != "Pending")
{
    <div style="margin-bottom:1rem;padding:.8rem 1rem;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;font-size:.85rem;color:#991b1b;">
        ⚠️ This order is <strong>@Model.Status</strong> — only Pending orders can be edited. To correct completed production, reverse it first when eligible, then create a new order.
    </div>
}

<input type="hidden" id="editProductionOrderId" value="@(isEdit ? Model!.ProductionOrderId.ToString() : "0")">

<div class="po-card">
    <span class="po-title">📋 Select Cost Sheet</span>
    <div class="po-fg">
        <label>Cost Sheet (Final only)</label>
        <select id="costSheetSelect" class="po-input" onchange="loadCostSheetInfo()">
            <option value="">-- Select a Final Cost Sheet --</option>
            @foreach (var s in finalSheets)
            {
                int sheetId = (int)s.CostSheetId;
                decimal rate = (decimal)(s.FinalRateWithGST ?? 0m);
                if (sheetId == selectedId)
                {
                    <option value="@sheetId" selected>
                        #@sheetId — @s.ItemName (@s.BoxStyle) — Rate: @rate.ToString("N2")
                    </option>
                }
                else
                {
                    <option value="@sheetId">
                        #@sheetId — @s.ItemName (@s.BoxStyle) — Rate: @rate.ToString("N2")
                    </option>
                }
            }
        </select>
    </div>

    @if (!finalSheets.Any())
    {
        <div style="margin-top:.8rem;padding:.8rem 1rem;background:#fef3c7;border:1px solid #fde68a;border-radius:8px;font-size:.85rem;">
            ⚠️ No <strong>Final</strong> cost sheets found.
            <a href="/CostSheet/Index" style="color:#1e40af;">Go to Cost Sheets</a> and mark one as Final first.
        </div>
    }

    <div id="sheetInfoBox" class="info-box" style="display:none;">
        <div class="info-row">
            <div class="info-item">Product: <span id="infoProduct">–</span></div>
            <div class="info-item">Box Style: <span id="infoBoxStyle">–</span></div>
            <div class="info-item">Reusable recipe — select the customer below.</div>
            <div class="info-item">Cost-sheet proposed rate (with taxes): <span id="infoRate">–</span></div>
        </div>
    </div>
</div>

<div id="productionSetup" class="po-card setup-box" hidden>
    <div class="setup-head">
        <span class="setup-icon">⚠️</span>
        <div><strong>This cost sheet is not ready for production yet</strong><p id="setupSummary"></p></div>
    </div>
    <ul id="productionSetupIssues" class="setup-list"></ul>
    <div id="finishedLinkControls"><label for="finishedLinkItem">Finished product (PCS)</label><select id="finishedLinkItem" class="po-input"></select><button type="button" id="linkFinishedButton" class="btn-save" onclick="linkFinishedItem()">Link selected product</button></div>
    <div class="setup-actions">
        <a id="editSetupSheet" class="setup-btn primary" target="_blank" rel="noopener">Open cost sheet to link items</a>
        <span id="setupAskAdmin" class="setup-note" hidden>Only a SuperAdmin can edit a saved cost sheet. Please ask a SuperAdmin to link these items.</span>
        <button type="button" class="setup-btn" onclick="loadCostSheetInfo()">↻ Refresh</button>
    </div>
    <p id="setupFinishedHint" class="setup-note" style="margin:.8rem 0 0" hidden>If the finished product does not exist, <a href="/Item/FinishedGoods" target="_blank" rel="noopener">add it in Finished Goods, Items</a>, then click Refresh.</p>
</div>
<div class="po-card">
    <span class="po-title">📦 Order Details</span>

    <div class="po-grid-3" style="margin-bottom:1rem;">
        <div class="po-fg">
            <label>Product / Item Name</label>
            <input type="text" id="productName" class="po-input"
                   placeholder="Auto-filled from cost sheet">
        </div>
        <div class="po-fg">
            <label for="customerId">Customer *</label>
            <select id="customerId" class="po-input"><option value="">Select an active customer...</option></select>
        </div>
        <div class="po-fg">
            <label>Order Quantity (boxes) *</label>
            <input type="number" id="orderQty" class="po-input"
                   placeholder="e.g. 10000" min="1" max="1000000" step="1" oninput="calcTotal()">
        </div>
    </div>

    <div class="po-grid-3" style="margin-bottom:1rem;">
        <div class="po-fg">
            <label>Order Date *</label>
            <input type="date" id="orderDate" class="po-input"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")">
        </div>
        <div class="po-fg">
            <label>Delivery Date *</label>
            <input type="date" id="deliveryDate" class="po-input">
        </div>
        <div class="po-fg">
            <label>Agreed Order Value (including agreed GST)</label>
            <input type="text" id="totalValue" class="po-input" readonly
                   style="background:#eff6ff;font-weight:700;color:#1e40af;"
                   placeholder="0.00">
        </div>
    </div>

    <div class="po-grid-3" style="margin-bottom:1rem;">
        <div class="po-fg">
            <label for="agreedUnitPrice">Agreed Selling Price / Box (before GST) *</label>
            <input type="number" id="agreedUnitPrice" class="po-input" min="0.01" max="100000000" step="0.01" oninput="calcTotal()" placeholder="Enter price agreed with customer">
        </div>
        <div class="po-fg">
            <label for="agreedGstPercent">Agreed GST %</label>
            <input type="number" id="agreedGstPercent" class="po-input" min="0" max="100" step="0.01" value="0" oninput="calcTotal()">
        </div>
        <div class="po-fg">
            <label for="customerReference">Customer Reference / PO Number</label>
            <input type="text" id="customerReference" class="po-input" maxlength="100" placeholder="Optional customer reference">
        </div>
    </div>
    <p style="font-size:.85rem;color:#526475;">Enter the negotiated price explicitly. The cost-sheet rate is an estimate, not customer agreement. These terms are fixed after production is recorded. Sale Invoice can load this order's price and GST.</p>

    <div class="po-fg" style="margin-bottom:1rem;">
        <label>Remarks</label>
        <textarea id="remarks" class="po-input" rows="2"
                  placeholder="Any special instructions..."></textarea>
    </div>
</div>

<div style="text-align:right;margin-top:1rem;">
    <button class="btn-save" id="saveBtn" onclick="saveOrder()">
        @(isEdit ? "💾 Save Changes" : "🏭 Create Production Order")
    </button>
</div>

<script>
let currentRate = 0;
const editId = parseInt(document.getElementById('editProductionOrderId').value) || 0;

async function loadOrderCustomers() {
    const select = document.getElementById('customerId');
    select.disabled = true;
    try {
        const response = await fetch('/Production/GetCustomerOptions'+(editId?'?orderId='+editId:''));
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error('Customers could not be loaded. Refresh before saving.');
        select.replaceChildren(new Option('Select an active customer...', ''));
        for (const customer of data.customers || []) {const option=new Option(customer.partyName,customer.selectionId);option.dataset.partyId=customer.partyId??'';select.add(option);}
        return true;
    } catch (error) { await alertDialog(error.message, {type:'error'}); return false; }
    finally { select.disabled = false; }
}

let sheetInfoRequest=0,setupReady=false;
function loadCostSheetInfo() {
    const request=++sheetInfoRequest;setupReady=false;document.getElementById("saveBtn").disabled=true;document.getElementById("productionSetup").hidden=true;
    const id = document.getElementById('costSheetSelect').value;
    document.getElementById('sheetInfoBox').style.display = 'none';

    if (!id) {
        currentRate = 0;
        document.getElementById('productName').value  = '';
        document.getElementById('totalValue').value   = '';
        return;
    }

    return fetch(`/Production/GetCostSheetInfo?id=${id}`)
        .then(r => r.json())
        .then(d => {
            if(request!==sheetInfoRequest)return;
            if (!d.success) throw new Error('Sheet unavailable');
            const s = d.data;
            setupReady=s.issues.length===0;document.getElementById('saveBtn').disabled=!setupReady;
            document.getElementById('productionSetup').hidden=setupReady;
            const problems=s.problems||s.issues.map(t=>({key:'',title:t,detail:''}));
            const issues=document.getElementById('productionSetupIssues');issues.replaceChildren();
            for(const p of problems){const li=document.createElement('li'),mark=document.createElement('span'),box=document.createElement('div'),t=document.createElement('b');
                mark.className='x';mark.textContent='✕';t.textContent=p.title;box.append(t);
                if(p.detail){const d=document.createElement('small');d.textContent=p.detail;box.append(d);}
                li.append(mark,box);issues.append(li);}
            document.getElementById('setupSummary').textContent=problems.length===1?'1 thing needs fixing before you can create the order. Link it, then click Refresh.':problems.length+' things need fixing before you can create the order. Fix them, then click Refresh.';
            document.getElementById('editSetupSheet').hidden=!s.canEditSheet;
            document.getElementById('setupAskAdmin').hidden=!!s.canEditSheet;
            document.getElementById('setupFinishedHint').hidden=!problems.some(p=>p.key==='finished');
            document.getElementById('finishedLinkControls').hidden=s.finishedReady||Boolean(s.finishedItemId);
            const products=document.getElementById('finishedLinkItem');products.replaceChildren(new Option('Select the matching finished product...', ''));for(const p of s.products)products.add(new Option(p.name+' — '+p.group,p.id));
            document.getElementById('editSetupSheet').href='/CostSheet/Edit/'+s.costSheetId;
            currentRate = parseFloat(s.finalRateWithGST || 0);

            document.getElementById('infoProduct').textContent  = s.itemName     || '–';
            document.getElementById('infoBoxStyle').textContent = s.boxStyle     || '–';
            document.getElementById('infoRate').textContent     = currentRate.toFixed(2);

            document.getElementById('productName').value  = s.itemName     || '';

            document.getElementById('sheetInfoBox').style.display = 'flex';
            calcTotal();
        })
        .catch(async () => await alertDialog('❌ Failed to load cost sheet info.'));
}

function calcTotal() {
    const qty   = parseInt(document.getElementById('orderQty').value) || 0;
    const price = Number(document.getElementById('agreedUnitPrice').value) || 0;
    const gst = Number(document.getElementById('agreedGstPercent').value) || 0;
    const base = qty * price;
    const total = base + Math.round((base * gst / 100 + Number.EPSILON) * 100) / 100;
    document.getElementById('totalValue').value = total > 0 ? total.toFixed(2) : '';
}

async function linkFinishedItem(){
    const item=Number(document.getElementById('finishedLinkItem').value);if(!item){await alertDialog('Select the matching finished product.');return;}
    const button=document.getElementById('linkFinishedButton');button.disabled=true;
    try{const response=await fetch('/CostSheet/UpdateFinishedItemLink',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({costSheetId:Number(document.getElementById('costSheetSelect').value),finishedItemId:item})});if(response.status===403)throw new Error('Cost Sheet edit permission is required to complete this product link. Ask your administrator for access.');if(response.status===401)throw new Error('Your session expired. Sign in again.');const data=await response.json();if(!response.ok||!data.success)throw new Error(data.message||'Product link could not be saved. Please refresh and retry.');await loadCostSheetInfo();}catch(e){await alertDialog(e.message,{type:'error'});}finally{button.disabled=false;}
}
async function saveOrder() {
    if(!setupReady){await alertDialog('Complete the cost-sheet setup above, then refresh it before creating production.');return;}
    const costSheetId  = parseInt(document.getElementById('costSheetSelect').value);
    const orderQty     = Number(document.getElementById('orderQty').value);
    const orderDate    = document.getElementById('orderDate').value;
    const deliveryDate = document.getElementById('deliveryDate').value;
    const productName  = document.getElementById('productName').value.trim();
    const customerId   = document.getElementById('customerId').value;
    const remarks      = document.getElementById('remarks').value;
    const agreedUnitPrice = Number(document.getElementById('agreedUnitPrice').value);
    const agreedGstPercent = Number(document.getElementById('agreedGstPercent').value);

    if (!costSheetId)              { await alertDialog('Please select a Cost Sheet.', { type: 'warning' });      return; }
    if (!customerId)               { await alertDialog('Please select the customer for this order.', {type:'warning'}); return; }
    if (!Number.isInteger(orderQty) || orderQty < 1 || orderQty > 1000000) { await alertDialog('Enter a whole box quantity from 1 to 1,000,000.', { type: 'warning' }); return; }
    if (!orderDate)                { await alertDialog('Please enter order date.', { type: 'warning' });          return; }
    if (!deliveryDate)             { await alertDialog('Please enter delivery date.', { type: 'warning' });       return; }
    if (!Number.isFinite(agreedUnitPrice) || agreedUnitPrice <= 0 || !Number.isFinite(agreedGstPercent) || agreedGstPercent < 0 || agreedGstPercent > 100) {
        await alertDialog('Enter the agreed price before GST and a valid GST percentage.', {type:'warning'}); return;
    }
    if (new Date(deliveryDate) < new Date(orderDate)) {
        await alertDialog('Delivery date must be on or after order date.', { type: 'warning' });
        return;
    }

    const btn = document.getElementById('saveBtn');
    const defaultLabel = editId > 0 ? '💾 Save Changes' : '🏭 Create Production Order';
    btn.disabled    = true;
    btn.textContent = editId > 0 ? '⏳ Saving...' : '⏳ Creating...';

    const payload = {
        ProductionOrderId : editId,
        CostSheetId  : costSheetId,
        CustomerId   : customerId,
        ProductName  : productName,
        OrderQty     : orderQty,
        OrderDate    : orderDate,
        DeliveryDate : deliveryDate,
        Remarks      : remarks,
        AgreedUnitPrice: agreedUnitPrice,
        AgreedGstPercent: agreedGstPercent,
        CustomerReference: document.getElementById('customerReference').value.trim()
    };

    fetch(editId > 0 ? '/Production/Update' : '/Production/Save', {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify(payload)
    })
    .then(r => r.json())
    .then(async d => {
        if (d.success) {
            await alertDialog(`✅ ${d.message}`);
            window.location.href = `/Production/Index?record=${d.id || editId}`;
        } else {
            await alertDialog('❌ ' + (d.message || 'Unknown error'));
            btn.disabled    = false;
            btn.textContent = defaultLabel;
        }
    })
    .catch(async () => {
        await alertDialog('❌ Error saving order. Please try again.');
        btn.disabled    = false;
        btn.textContent = defaultLabel;
    });
}

function loadOrderForEdit(id) {
    return fetch(`/Production/GetById?id=${id}`)
        .then(r => r.json())
        .then(async d => {
            if (!d.success) { await alertDialog('❌ Could not load order for editing.'); return; }
            const o = d.data;

            document.getElementById('costSheetSelect').value = o.costSheetId;
            return loadCostSheetInfo().then(() => {
                document.getElementById('productName').value  = o.productName || '';
                const customerSelect = document.getElementById('customerId');
                const selectedCustomer=[...customerSelect.options].find(option=>option.value===String(o.customerId)||option.dataset.partyId===String(o.customerId));
                if (o.customerId && !selectedCustomer) {
                    customerSelect.add(new Option((o.customerName || o.customerId) + ' (inactive — select an active customer)', o.customerId));
                }
                document.getElementById('customerId').value   = selectedCustomer?.value || o.customerId || '';
                document.getElementById('orderQty').value      = o.orderQty;
                document.getElementById('orderDate').value     = o.orderDate ? o.orderDate.substring(0, 10) : '';
                document.getElementById('deliveryDate').value  = o.deliveryDate ? o.deliveryDate.substring(0, 10) : '';
                document.getElementById('remarks').value       = o.remarks || '';
                document.getElementById('agreedUnitPrice').value = o.agreedUnitPrice ?? '';
                document.getElementById('agreedGstPercent').value = o.agreedGstPercent ?? 0;
                document.getElementById('customerReference').value = o.customerReference || '';
                calcTotal();
            });
        })
        .catch(async () => await alertDialog('❌ Failed to load order for editing.'));
}

window.addEventListener('DOMContentLoaded', async () => {
    if (!await loadOrderCustomers()) { document.getElementById('saveBtn').disabled = true; return; }
    if (editId > 0) {
        await loadOrderForEdit(editId);
        return;
    }
    const sel = document.getElementById('costSheetSelect');
    if (sel.value) loadCostSheetInfo();
});
</script>
