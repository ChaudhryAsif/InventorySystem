@using InventorySystem.Core.Models
@model ProductionOrder
@{
    Layout = "_Layout";
    ViewData["Title"] = "Material Requirements";
    string customerName = ViewBag.CustomerName ?? Model.CustomerId;
    decimal totalValue  = ViewBag.TotalOrderValue ?? 0;
}

<style>
    .mat-card  { background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,.08); padding:1.5rem; margin-bottom:1.2rem; }
    .mat-title { font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em;
                 color:#fff; background:#1e3a5f; padding:.4rem .9rem; border-radius:6px;
                 margin-bottom:1rem; display:inline-block; }
    .summary-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:1rem; margin-bottom:1.5rem; }
    .sum-card  { background:#fff; border-radius:10px; padding:1rem; box-shadow:0 2px 8px rgba(0,0,0,.07); text-align:center; }
    .sum-val   { font-size:1.3rem; font-weight:700; color:#1e3a5f; }
    .sum-lbl   { font-size:.75rem; color:#6b7280; margin-top:.2rem; }
    .stock-ok       { background:#dcfce7; color:#166534; padding:.2rem .6rem; border-radius:10px; font-size:.75rem; font-weight:600; }
    .stock-Low      { background:#fef3c7; color:#92400e; padding:.2rem .6rem; border-radius:10px; font-size:.75rem; font-weight:600; }
    .stock-Critical { background:#fee2e2; color:#991b1b; padding:.2rem .6rem; border-radius:10px; font-size:.75rem; font-weight:600; }
    .status-badge        { padding:.3rem .8rem; border-radius:20px; font-size:.78rem; font-weight:600; }
    .status-Pending      { background:#fef3c7; color:#92400e; }
    .status-InProduction { background:#dbeafe; color:#1e40af; }
    .status-Completed    { background:#dcfce7; color:#166534; }
    .mat-table { width:100%; border-collapse:collapse; font-size:.85rem; }
    .mat-table th { background:#1e3a5f; color:#fff; padding:.7rem .9rem; text-align:left; font-weight:600; }
    .mat-table td { padding:.65rem .9rem; border-bottom:1px solid #f0f0f0; vertical-align:middle; }
    .mat-table tbody tr:hover { background:#f8fafc; }
</style>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
    <div>
        <h2 style="font-size:1.5rem;font-weight:700;color:#1e3a5f;margin:0;">
            📋 Material Requirements — Order #@Model.ProductionOrderId
        </h2>
        <p style="color:#6b7280;margin:.2rem 0 0;font-size:.9rem;">
            @Model.ProductName | Customer: @customerName |
            Delivery: @Model.DeliveryDate.ToString("dd-MMM-yyyy") |
            <span class="status-badge status-@Model.Status">@Model.Status</span>
        </p>
    </div>
    <div style="display:flex;gap:.8rem;align-items:center;">
        @if (Model.Status == "Pending" || Model.Status == "InProduction")
        {
            <a href="/Production/Consume/@Model.ProductionOrderId"
               style="background:#16a34a;color:#fff;padding:.5rem 1.2rem;border-radius:8px;text-decoration:none;font-size:.9rem;font-weight:600;">
                🏭 Record Consumption
            </a>
        }
        <a href="/Production/Index" style="color:#6b7280;font-size:.9rem;padding:.5rem 0;">← Back</a>
    </div>
</div>

@{
    var mats      = Model.Materials?.ToList() ?? new List<InventorySystem.Core.Models.ProductionMaterial>();
    int okCount   = mats.Count(m => m.StockStatus == "OK");
    int lowCount  = mats.Count(m => m.StockStatus == "Low");
    int critCount = mats.Count(m => m.StockStatus == "Critical");
}

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-val">@Model.OrderQty.ToString("N0")</div>
        <div class="sum-lbl">📦 Order Qty (boxes)</div>
    </div>
    <div class="sum-card">
        <div class="sum-val">@mats.Count</div>
        <div class="sum-lbl">🧪 Raw Materials</div>
    </div>
    <div class="sum-card">
        <div class="sum-val" style="color:#16a34a">@okCount</div>
        <div class="sum-lbl">✅ Stock OK</div>
    </div>
    <div class="sum-card">
        <div class="sum-val" style="color:#d97706">@lowCount</div>
        <div class="sum-lbl">⚠️ Stock Low</div>
    </div>
    <div class="sum-card">
        <div class="sum-val" style="color:#dc2626">@critCount</div>
        <div class="sum-lbl">🔴 Critical / Buy Now</div>
    </div>
</div>

@if (critCount > 0 || lowCount > 0)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:1rem;margin-bottom:1rem;">
        ⚠️ <strong>@(critCount + lowCount) material(s)</strong> need purchasing before production can start.
        <a href="/Purchase/Create" style="margin-left:1rem;background:#dc2626;color:#fff;padding:.3rem .8rem;border-radius:6px;text-decoration:none;font-size:.83rem;">
            🛒 Go to Purchase Invoice
        </a>
    </div>
}
else if (mats.Any())
{
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:1rem;margin-bottom:1rem;">
        ✅ <strong>All materials are in stock.</strong> Ready for production!
    </div>
}

<div class="mat-card">
    <span class="mat-title">🧪 Raw Material Plan</span>
    <table class="mat-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Item Name</th>
                <th>Specification</th>
                <th>KG / Box</th>
                <th>Required KG<br /><small>(@Model.OrderQty boxes)</small></th>
                <th>Available KG<br /><small>(Live Stock)</small></th>
                <th>Shortfall KG</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{ int r = 1; }
            @foreach (var m in mats)
            {
                <tr>
                    <td>@(r++)</td>
                    <td><strong>@m.ItemName</strong></td>
                    <td>@m.Specification</td>
                    <td>@m.KgPerUnit.ToString("N3")</td>
                    <td><strong>@m.RequiredKg.ToString("N2")</strong></td>
                    <td style="color:@(m.AvailableKg >= m.RequiredKg ? "#16a34a" : "#dc2626");font-weight:600;">
                        @m.AvailableKg.ToString("N2")
                    </td>
                    <td style="color:@(m.ShortfallKg > 0 ? "#dc2626" : "#16a34a");font-weight:600;">
                        @(m.ShortfallKg > 0 ? m.ShortfallKg.ToString("N2") : "–")
                    </td>
                    <td><span class="stock-@m.StockStatus">@m.StockStatus</span></td>
                </tr>
            }
            @if (!mats.Any())
            {
                <tr>
                    <td colspan="8" style="text-align:center;padding:2rem;color:#9ca3af;">
                        No ply items linked. Make sure Cost Sheet plies have items selected via 🔍.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>