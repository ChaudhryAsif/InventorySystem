@model IEnumerable<InventorySystem.Core.Models.Role>

@{
    ViewData["Title"] = "Manage Roles";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <span class="admin-page-icon">🎭</span>
    <div>
        <h1 class="admin-page-title">Roles Management</h1>
        <p class="admin-page-subtitle">Manage system roles and their permissions</p>
    </div>
</div>

<div class="admin-table-container">
    <div class="admin-table-header">
        <h3 class="admin-table-title">All Roles</h3>
        <a asp-action="ManageRolePermissions" class="admin-btn admin-btn-success">
            🔐 Manage Permissions
        </a>
    </div>

    @if (Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Role Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>
                            <strong>@role.Name</strong>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <span>@role.Description</span>
                            }
                            else
                            {
                                <span style="color: var(--text-secondary); font-style: italic;">No description</span>
                            }
                        </td>
                        <td>
                            @if (role.IsActive)
                            {
                                <span class="admin-table .status-badge admin-table .status-active">Active</span>
                            }
                            else
                            {
                                <span class="admin-table .status-badge admin-table .status-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="admin-table-actions">
                                <a asp-action="ManageRolePermissions" asp-route-id="@role.Id" class="admin-btn admin-btn-primary">
                                    🔐 Permissions
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
            <p>No roles found.</p>
        </div>
    }
</div>