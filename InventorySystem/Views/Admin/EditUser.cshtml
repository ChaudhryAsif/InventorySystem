@model InventorySystem.Core.Models.AppUser

@{
    ViewData["Title"] = "Edit User";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <span class="admin-page-icon">✏️</span>
    <div>
        <h1 class="admin-page-title">Edit User</h1>
        <p class="admin-page-subtitle">Update user details and permissions for: <strong style="color: var(--primary-color);">@Model.FullName</strong></p>
    </div>
</div>

<!-- SINGLE FORM FOR BOTH USER DETAILS AND ROLES -->
<form method="post" id="editUserForm">
    @Html.AntiForgeryToken()

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1200px;">
        <!-- User Details Section -->
        <div class="admin-form">
            <h3 style="margin-bottom: 1.5rem; color: var(--text-primary); font-size: 1.1rem;">
                👤 User Details
            </h3>

            @Html.HiddenFor(m => m.Id)

            <div class="admin-form-group">
                <label class="admin-form-label">Username</label>
                <input type="text" class="admin-form-input" value="@Model.Username" disabled
                       style="background-color: #f8fafc; cursor: not-allowed;">
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label" for="FullName">Full Name *</label>
                <input type="text" id="FullName" asp-for="FullName" class="admin-form-input" required>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Account Status</label>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <input type="checkbox" id="isActive" asp-for="IsActive"
                           style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary-color);">
                    <label for="isActive" style="margin: 0; cursor: pointer; color: var(--text-primary);">
                        Active User
                    </label>
                </div>
            </div>
        </div>

        <!-- Role Assignment Section -->
        <div class="admin-form">
            <h3 style="margin-bottom: 1.5rem; color: var(--text-primary); font-size: 1.1rem;">
                🎭 Assign Roles
            </h3>

            @if (ViewBag.AllRoles != null && ViewBag.AllRoles.Count > 0)
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var role in ViewBag.AllRoles)
                    {
                        var isChecked = ViewBag.UserRoleIds != null && ViewBag.UserRoleIds.Contains(role.Id);
                        <div class="permission-item" style="padding: 0.8rem; background: #f8fafc; border-radius: var(--radius-sm); border-left: 3px solid var(--border-color);">
                            <input type="checkbox" name="selectedRoles" value="@role.Id"
                                   id="role@role.Id" @(isChecked ? "checked" : "")
                                   style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary-color);">
                            <label for="role@role.Id" style="margin: 0; cursor: pointer; color: var(--text-primary); font-weight: 500;">
                                @role.Name
                            </label>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.3rem;">
                                    @role.Description
                                </div>
                            }
                        </div>
                    }
                </div>

                <div style="margin-top: 1.5rem; padding: 1rem; background: rgba(45, 95, 127, 0.05); border-radius: var(--radius-sm); border-left: 3px solid var(--primary-color);">
                    <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary);">
                        💡 <strong>Tip:</strong> Select one or more roles for this user. Changes will be saved with user details.
                    </p>
                </div>
            }
            else
            {
                <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
                    <p>No roles available.</p>
                </div>
            }
        </div>
    </div>

    <!-- Action Buttons - OUTSIDE GRID, FULL WIDTH -->
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 2px solid var(--border-color); display: flex; gap: 1rem; justify-content: flex-end;">
        <a href="javascript:history.back()" class="admin-btn admin-btn-secondary">
            ← Back
        </a>
        <button type="submit" class="admin-btn admin-btn-success" id="submitBtn">
            💾 Save All Changes
        </button>
    </div>
</form>

@section Scripts {
    <script>
        // Form validation before submit
        document.getElementById('editUserForm').addEventListener('submit', function (e) {
            const fullName = document.getElementById('FullName').value.trim();

            if (!fullName) {
                e.preventDefault();
                alert('Full name is required!');
                document.getElementById('FullName').focus();
                return false;
            }

            // Optional: Check if at least one role is selected
            const rolesChecked = document.querySelectorAll('input[name="selectedRoles"]:checked').length;
            if (rolesChecked === 0) {
                const confirmed = confirm('No roles selected. Continue without assigning roles?');
                if (!confirmed) {
                    e.preventDefault();
                    return false;
                }
            }

            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').textContent = '⏳ Saving...';
        });

        // Real-time role change feedback
        document.querySelectorAll('input[name="selectedRoles"]').forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                console.log('Role ' + this.value + ' ' + (this.checked ? 'selected' : 'deselected'));
            });
        });
    </script>
}