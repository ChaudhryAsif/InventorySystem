@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <span class="admin-page-icon">⚙️</span>
    <div>
        <h1 class="admin-page-title">Admin Dashboard</h1>
        <p class="admin-page-subtitle">Manage roles, permissions, and users</p>
    </div>
</div>

<!-- Stats Cards Grid -->
<div class="admin-cards-grid">
    <div class="admin-card">
        <div class="admin-card-icon">👥</div>
        <div class="admin-card-label">Total Users</div>
        <div class="admin-card-value">@ViewBag.Stats.TotalUsers</div>
    </div>

    <div class="admin-card">
        <div class="admin-card-icon">🎭</div>
        <div class="admin-card-label">Total Roles</div>
        <div class="admin-card-value">@ViewBag.Stats.TotalRoles</div>
    </div>

    <div class="admin-card">
        <div class="admin-card-icon">🔐</div>
        <div class="admin-card-label">Total Permissions</div>
        <div class="admin-card-value">@ViewBag.Stats.TotalPermissions</div>
    </div>

    <div class="admin-card">
        <div class="admin-card-icon">📋</div>
        <div class="admin-card-label">Menu Items</div>
        <div class="admin-card-value">@ViewBag.Stats.TotalMenuItems</div>
    </div>
</div>

<!-- Quick Management Links -->
<div class="admin-quick-management">
    <h3 class="admin-quick-title">
        <span>⚡</span>Quick Management
    </h3>
    <div class="admin-quick-links">
        <a asp-action="Users" class="admin-quick-link">
            <span class="admin-quick-link-icon">👥</span>
            Manage Users
        </a>
        <a asp-action="Roles" class="admin-quick-link">
            <span class="admin-quick-link-icon">🎭</span>
            Manage Roles
        </a>
        <a asp-action="MenuItems" class="admin-quick-link">
            <span class="admin-quick-link-icon">📋</span>
            Manage Menus
        </a>
    </div>
</div>