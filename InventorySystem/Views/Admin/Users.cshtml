@model IEnumerable<InventorySystem.Core.Models.AppUser>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
    var roles = ViewBag.Roles as List<InventorySystem.Core.Models.Role> ?? [];
    var me = ViewBag.Me as int?;
    var list = Model.ToList();
}
<link rel="stylesheet" href="~/css/access-admin.css" asp-append-version="true" />

<div class="admin-page-header">
    <span class="admin-page-icon">👥</span>
    <div>
        <h1 class="admin-page-title">Users</h1>
        <p class="admin-page-subtitle">Each person signs in with their own username and password. Their roles decide what they can do.</p>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="acc-alert ok" role="status">✅ @TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="acc-alert bad" role="alert">❌ @TempData["Error"]</div> }

<form method="get" class="acc-toolbar">
    <input class="grow" type="search" name="q" value="@ViewBag.Q" placeholder="Search username or name" aria-label="Search users" />
    <select name="roleId" aria-label="Role">
        <option value="">All roles</option>
        @foreach (var role in roles) { <option value="@role.Id" selected="@(ViewBag.RoleId == role.Id)">@role.Name</option> }
    </select>
    <select name="status" aria-label="Status">
        <option value="all" selected="@(ViewBag.Status == "all")">All users</option>
        <option value="active" selected="@(ViewBag.Status == "active")">Active</option>
        <option value="inactive" selected="@(ViewBag.Status == "inactive")">Disabled</option>
    </select>
    <button type="submit" class="admin-btn admin-btn-primary">Filter</button>
    <a asp-action="Users" class="admin-btn admin-btn-secondary">Clear</a>
    <a asp-action="CreateUser" class="admin-btn admin-btn-success" style="margin-left:auto">➕ Create New User</a>
</form>

<div class="admin-table-container">
    @if (list.Count > 0)
    {
        <table class="admin-table">
            <thead>
                <tr><th>Username</th><th>Full Name</th><th>Roles</th><th>Status</th><th>Created</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var user in list)
            {
                <tr>
                    <td><strong>@user.Username</strong>@if (me == user.Id) { <span class="acc-pill role">You</span> }</td>
                    <td>@user.FullName</td>
                    <td>
                        @if (user.UserRoles?.Count > 0) { foreach (var role in user.UserRoles) { <span class="acc-pill role">@role.Role?.Name</span> } }
                        else { <span class="acc-pill">No role</span> }
                    </td>
                    <td>@if (user.IsActive) { <span class="acc-pill ok">Active</span> } else { <span class="acc-pill off">Disabled</span> }</td>
                    <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="acc-actions">
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="admin-btn admin-btn-primary">✏️ Edit</a>
                            <a asp-action="UserAccess" asp-route-id="@user.Id" class="admin-btn admin-btn-primary">🔎 Access</a>
                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="admin-btn admin-btn-primary">🔑 Password</a>
                            @if (user.IsActive)
                            {
                                if (me != user.Id) { <button type="button" class="admin-btn admin-btn-danger" onclick="deleteLogin(@user.Id,this)">⛔ Disable</button> }
                            }
                            else
                            {
                                <form asp-action="EnableUser" asp-route-id="@user.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="admin-btn admin-btn-success">✅ Enable</button></form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
            <p>No users match. <a asp-action="Users" style="color: var(--primary-color); text-decoration: underline;">Clear the filters</a> or <a asp-action="CreateUser" style="color: var(--primary-color); text-decoration: underline;">create a user</a>.</p>
        </div>
    }
</div>
@section Scripts {
<script>
async function deleteLogin(id,button){
    if(!await confirmDialog('Disable this login? The person can no longer sign in, and their history is kept. You can enable it again.',{danger:true,confirmText:'Disable'}))return;
    button.disabled=true;
    try{const response=await fetch('/Admin/Users/'+id+'/Delete',{method:'POST'});const result=await response.json();if(response.ok&&result.success){location.reload();return;}await alertDialog(result.message||'The login could not be disabled.',{type:'error'});}
    catch{await alertDialog('Request interrupted. Reload to check whether the user was disabled.');}finally{button.disabled=false;}
}
</script>
}
