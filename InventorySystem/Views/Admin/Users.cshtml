@model IEnumerable<InventorySystem.Core.Models.AppUser>

@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <span class="admin-page-icon">👥</span>
    <div>
        <h1 class="admin-page-title">User Management</h1>
        <p class="admin-page-subtitle">Manage system users and their roles</p>
    </div>
</div>

<div class="admin-table-container">
    <div class="admin-table-header">
        <h3 class="admin-table-title">All Users</h3>
        <a asp-action="CreateUser" class="admin-btn admin-btn-success">
            ➕ Create New User
        </a>
    </div>
    
    @if (Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <strong>@user.Username</strong>
                        </td>
                        <td>@user.FullName</td>
                        <td>
                            @if (user.UserRoles?.Count > 0)
                            {
                                @foreach (var role in user.UserRoles)
                                {
                                    <span class="admin-table .status-badge" style="background: rgba(45, 95, 127, 0.15); color: var(--primary-color);">
                                        @role.Role?.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="admin-table .status-badge" style="background: rgba(108, 117, 125, 0.15); color: var(--text-secondary);">
                                    No Role
                                </span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="admin-table .status-badge admin-table .status-active">Active</span>
                            }
                            else
                            {
                                <span class="admin-table .status-badge admin-table .status-inactive">Inactive</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="admin-table-actions">
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="admin-btn admin-btn-primary">
                                    ✏️ Edit
                                </a>
                                <button type="button" class="admin-btn admin-btn-danger" onclick="deleteLogin(@user.Id,this)">🗑️ Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
            <p>No users found. <a asp-action="CreateUser" style="color: var(--primary-color); text-decoration: underline;">Create one now</a>.</p>
        </div>
    }
</div>
@section Scripts {
<script>
async function deleteLogin(id,button){
    if(!await confirmDialog('Delete this user? Their login will be disabled and audit history retained.',{danger:true}))return;
    button.disabled=true;
    try{const response=await fetch('/Admin/Users/'+id+'/Delete',{method:'POST'});const result=await response.json();if(response.ok&&result.success){await alertDialog(result.message);location.reload();}else await alertDialog(result.message||'User could not be deleted.');}
    catch{await alertDialog('Request interrupted. Reload to check whether the user was disabled.');}finally{button.disabled=false;}
}
</script>
}
