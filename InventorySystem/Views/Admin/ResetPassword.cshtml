@model InventorySystem.Controllers.AdminController.PasswordInput
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/access-admin.css" asp-append-version="true" />

<div class="admin-page-header">
    <span class="admin-page-icon">🔑</span>
    <div>
        <h1 class="admin-page-title">Reset password</h1>
        <p class="admin-page-subtitle">For <strong>@ViewBag.FullName</strong> (@ViewBag.UserName). Their old password stops working at once.</p>
    </div>
</div>

<form method="post" class="admin-form acc-form" autocomplete="off">
    @Html.AntiForgeryToken()
    <div class="admin-form-group">
        <label class="admin-form-label" for="NewPassword">New password *</label>
        <input id="NewPassword" name="NewPassword" type="password" minlength="6" required class="admin-form-input" autocomplete="new-password" />
        @if (ViewData.ModelState["NewPassword"]?.Errors.Count > 0) { <div class="acc-error">@ViewData.ModelState["NewPassword"]!.Errors[0].ErrorMessage</div> }
        <div class="acc-muted">At least 6 characters.</div>
    </div>
    <div class="admin-form-group">
        <label class="admin-form-label" for="ConfirmPassword">Repeat the new password *</label>
        <input id="ConfirmPassword" name="ConfirmPassword" type="password" minlength="6" required class="admin-form-input" autocomplete="new-password" />
        @if (ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0) { <div class="acc-error">@ViewData.ModelState["ConfirmPassword"]!.Errors[0].ErrorMessage</div> }
    </div>
    <div class="acc-actions" style="margin-top:1rem">
        <button type="submit" class="admin-btn admin-btn-success">💾 Set new password</button>
        <a asp-action="Users" class="admin-btn admin-btn-secondary">Cancel</a>
    </div>
    <p class="acc-muted" style="margin-top:1rem">The password is never shown or stored in the access log. Give it to the person privately; they can change it themselves with the Password button at the top.</p>
</form>
