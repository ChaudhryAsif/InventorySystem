@model IEnumerable<InventorySystem.Core.Models.Permission>

@{
    ViewData["Title"] = "Permissions";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <span class="admin-page-icon">🔐</span>
    <div>
        <h1 class="admin-page-title">Permissions</h1>
        <p class="admin-page-subtitle">Manage system permissions and access controls</p>
    </div>
</div>

<div class="admin-table-container">
    <div class="admin-table-header">
        <h3 class="admin-table-title">All Permissions</h3>
    </div>

    @if (Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Module</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <code style="background: #f8fafc; padding: 0.25rem 0.5rem; border-radius: 4px;">@p.Code</code>
                        </td>
                        <td><strong>@p.Name</strong></td>
                        <td>
                            <span style="background: rgba(45, 95, 127, 0.1); padding: 0.35rem 0.75rem; border-radius: 4px; font-size: 0.85rem;">
                                @p.Module
                            </span>
                        </td>
                        <td>@p.Action</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
            <p>No permissions found.</p>
        </div>
    }
</div>