@{
    ViewData["Title"] = "Manage Role Permissions";
    var role = ViewBag.Role as InventorySystem.Core.Models.Role;
    var groupedPermissions = ViewBag.GroupedPermissions;
    var rolePermissionIds = ViewBag.RolePermissionIds as List<int>;
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>🔐 Manage Permissions for: <strong>@role?.Name</strong></h2>
        </div>
    </div>

    <form method="post" class="row">
        @Html.AntiForgeryToken()

        @foreach (var group in groupedPermissions)
        {
            var module = group.Key;
            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">📦 @module</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var permission in group)
                        {
                            var isChecked = rolePermissionIds?.Contains(permission.Id) ?? false;
                            <div class="form-check">
                                <input type="checkbox" name="permissions" value="@permission.Id"
                                       class="form-check-input" id="perm@permission.Id" @(isChecked ? "checked" : "")>
                                <label class="form-check-label" for="perm@permission.Id">
                                    <strong>@permission.Name</strong>
                                    @if (!string.IsNullOrEmpty(permission.Description))
                                    {
                                        <small class="text-muted d-block">@permission.Description</small>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a asp-action="Roles" class="btn btn-secondary">← Back</a>
                <button type="submit" class="btn btn-primary">💾 Save Permissions</button>
            </div>
        </div>
    </form>
</div>