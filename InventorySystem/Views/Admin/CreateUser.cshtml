@model InventorySystem.Core.Models.AppUser

@{
    ViewData["Title"] = "Create New User";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <span class="admin-page-icon">➕</span>
    <div>
        <h1 class="admin-page-title">Create New User</h1>
        <p class="admin-page-subtitle">Add a new user to the system with roles and permissions</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1200px;">
    <!-- User Details Section -->
    <div class="admin-form">
        <h3 style="margin-bottom: 1.5rem; color: var(--text-primary); font-size: 1.1rem;">
            👤 User Information
        </h3>

        <form method="post" id="createUserForm">
            @Html.AntiForgeryToken()

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div style="background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.3); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
                    <strong style="color: var(--danger-color);">❌ Validation Errors:</strong>
                    <ul style="margin: 0.5rem 0 0 1.5rem; color: var(--danger-color);">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <div class="admin-form-group">
                <label class="admin-form-label" for="Username">Username *</label>
                <input type="text" id="Username" name="Username" asp-for="Username" class="admin-form-input" 
                       placeholder="Enter username" required pattern="^[a-zA-Z0-9_.-]{3,}$"
                       title="Username must be at least 3 characters (letters, numbers, underscore, dot, or hyphen)">
                <span style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.3rem; display: block;">
                    💡 Must be unique and at least 3 characters
                </span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label" for="FullName">Full Name *</label>
                <input type="text" id="FullName" name="FullName" asp-for="FullName" class="admin-form-input" 
                       placeholder="Enter full name" required>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label" for="password">Password *</label>
                <input type="password" id="password" name="password" class="admin-form-input" 
                       placeholder="Enter password" required minlength="6">
                <span style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.3rem; display: block;">
                    💡 Must be at least 6 characters long
                </span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label" for="confirmPassword">Confirm Password *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="admin-form-input" 
                       placeholder="Confirm password" required minlength="6">
            </div>

            <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 2px solid var(--border-color); display: flex; gap: 1rem; justify-content: flex-end;">
                <a href="javascript:history.back()" class="admin-btn admin-btn-secondary">
                    ← Cancel
                </a>
                <button type="submit" class="admin-btn admin-btn-success" id="submitBtn">
                    ✅ Create User
                </button>
            </div>
        </form>
    </div>

    <!-- Role Assignment Section -->
    <div class="admin-form">
        <h3 style="margin-bottom: 1.5rem; color: var(--text-primary); font-size: 1.1rem;">
            🎭 Assign Roles
        </h3>

        <form method="post" style="margin: 0;">
            @Html.AntiForgeryToken()

            @if (ViewBag.AllRoles != null && ViewBag.AllRoles.Count > 0)
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var role in ViewBag.AllRoles)
                    {
                        <div class="permission-item" style="padding: 0.8rem; background: #f8fafc; border-radius: var(--radius-sm); border-left: 3px solid var(--border-color);">
                            <input type="checkbox" name="selectedRoles" value="@role.Id"
                                   id="role@role.Id"
                                   style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary-color);">
                            <label for="role@role.Id" style="margin: 0; cursor: pointer; color: var(--text-primary); font-weight: 500;">
                                @role.Name
                            </label>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                    @role.Description
                                </div>
                            }
                        </div>
                    }
                </div>

                <div style="margin-top: 1.5rem; padding: 1rem; background: rgba(45, 95, 127, 0.05); border-radius: var(--radius-sm); border-left: 3px solid var(--primary-color);">
                    <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary);">
                        💡 <strong>Tip:</strong> Select at least one role for the user. The first selected role will be the primary role.
                    </p>
                </div>
            }
            else
            {
                <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
                    <p>No roles available. Please create roles first.</p>
                    <a asp-action="Roles" class="admin-btn admin-btn-primary" style="margin-top: 1rem; display: inline-block;">
                        Create Roles
                    </a>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        document.getElementById('createUserForm').addEventListener('submit', function (e) {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (password !== confirmPassword) {
                e.preventDefault();
                alert('Passwords do not match!');
                document.getElementById('confirmPassword').focus();
                return false;
            }

            if (password.length < 6) {
                e.preventDefault();
                alert('Password must be at least 6 characters long!');
                return false;
            }

            // Check at least one role is selected
            const rolesChecked = document.querySelectorAll('input[name="selectedRoles"]:checked').length;
            if (rolesChecked === 0) {
                e.preventDefault();
                alert('Please select at least one role for the user!');
                return false;
            }

            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').textContent = '⏳ Creating...';
        });

        // Real-time password confirmation
        document.getElementById('confirmPassword').addEventListener('input', function () {
            const password = document.getElementById('password').value;
            if (this.value && password !== this.value) {
                this.style.borderColor = 'var(--danger-color)';
            } else {
                this.style.borderColor = 'var(--border-color)';
            }
        });
    </script>
}