@model InventorySystem.Core.Models.GatePass
@{Layout=null;}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="referrer" content="no-referrer" /><meta name="robots" content="noindex,nofollow" />
<title>@Model.PassNumber — @Model.Direction Gate Pass receipt</title>
<link rel="stylesheet" href="~/css/company-brand.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/gatepass-sheet.css" asp-append-version="true" />
<style>
.exporting{margin:0!important;max-width:none!important;padding:0!important}
.exporting #receiptSheet{width:780px;max-width:none}
.exporting .meta{grid-template-columns:repeat(4,minmax(0,1fr))}
.exporting .field.wide{grid-column:span 2}
@@media(max-width:640px){body:not(.exporting) {margin:8px;padding:0 8px;font-size:12px}body:not(.exporting) .gp-print-actions{text-align:left}body:not(.exporting) .meta{grid-template-columns:repeat(2,minmax(0,1fr))}body:not(.exporting) .field.wide{grid-column:span 2}body:not(.exporting) #receiptSheet table{min-width:0;table-layout:auto}body:not(.exporting) #receiptSheet thead{display:none}body:not(.exporting) #receiptSheet tr{display:block;border:1px solid #9cabb5;border-radius:6px;margin:6px 0;padding:4px 8px}body:not(.exporting) #receiptSheet td{display:flex;justify-content:space-between;gap:12px;border:0;padding:2px 0;text-align:right;font-size:12px}body:not(.exporting) #receiptSheet td::before{content:attr(data-label);color:#526575;text-align:left}}
@@media print{.gp-print-actions{display:none}}
</style></head><body>
<div class="gp-print-actions"><button type="button" id="pdfBtn">Download PDF</button> <button type="button" onclick="window.print()">Print</button></div>
<div id="receiptSheet"><partial name="~/Views/GatePass/_GatePassSheet.cshtml" model="Model" /></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="~/js/pdf-pages.js" asp-append-version="true"></script>
<script>
(function () {
    const sheet = document.getElementById('receiptSheet');
    const options = { margin: [10, 10, 10, 10], filename: '@(Model.PassNumber).pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2, useCORS: true, width: 780 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }, pagebreak: window.PdfPages ? PdfPages.options : undefined };
    // Captured at a fixed 780px sheet width. Do not set windowWidth or scroll offsets: they cut the receipt on wide or zoomed windows.
    async function exporting(job) {
        document.body.classList.add('exporting', 'pdf-exporting');
        try { return await job(html2pdf().set(options).from(sheet)); }
        finally { document.body.classList.remove('exporting', 'pdf-exporting'); }
    }
    window.GPReceipt = { blob: () => exporting(job => job.outputPdf('blob')) };
    document.getElementById('pdfBtn').addEventListener('click', async event => {
        const button = event.currentTarget, label = button.textContent;
        button.disabled = true; button.textContent = 'Preparing…';
        try { await exporting(job => job.save()); }
        catch { alert('The PDF could not be created. Please use Print and choose Save as PDF.'); }
        finally { button.disabled = false; button.textContent = label; }
    });
})();
</script>
</body></html>
