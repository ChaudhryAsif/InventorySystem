@{
    Layout = "_Layout";
    ViewData["Title"] = "Consumption Voucher";
}

<link href="~/css/sale.css" rel="stylesheet" />

<div class="main-wrapper">
    <div class="page-header">
        <h2>🏭 Raw Material Consumption</h2>
        <p>Record raw material usage and deduct from purchase stock</p>
    </div>

    <div class="card">
        <form id="consumeForm">

            <!-- ── Voucher Header ──────────────────────────────────────────── -->
            <div class="invoice-header-section">
                <div class="form-section">
                    <div class="form-group">
                        <label class="form-label">User</label>
                        <input type="text" class="form-control" value="Admin" disabled>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Voucher No</label>
                        <input type="text" class="form-control" id="voucherNo" value="1" disabled>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Ref No</label>
                        <input type="text" class="form-control" id="refNo"
                               placeholder="Enter reference number">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Voucher Date</label>
                        <input type="date" class="form-control" id="voucherDate"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-group">
                        <label class="form-label">Purpose / Department</label>
                        <input type="text" class="form-control" id="purpose"
                               placeholder="e.g. Production Line A, Batch #123">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" id="remarks"
                                  placeholder="Enter remarks..."></textarea>
                    </div>
                </div>
            </div>

            <!-- ── Items Table ─────────────────────────────────────────────── -->
            <div class="items-section">
                <h3 class="section-title">Raw Materials Consumed</h3>

                <div class="table-container">
                    <table class="items-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th style="width: 120px;">Item ID</th>
                                <th style="width: 300px;">Item Name</th>
                                <th style="width: 130px;">Avail. Stock</th>
                                <th style="width: 130px;">Qty Consumed</th>
                                <th style="width: 60px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            <!-- rows injected by JS -->
                        </tbody>
                    </table>
                </div>

                <button type="button" class="add-row-btn" id="addRowBtn">
                    ➕ Add Raw Material
                </button>
            </div>

            <!-- ── Footer ──────────────────────────────────────────────────── -->
            <div class="footer-grid">
                <div class="totals-box" style="margin-left:auto;">
                    <div class="total-row">
                        <span class="total-label">Total Items:</span>
                        <input type="text" class="total-input" id="totalItems" value="0" readonly>
                    </div>
                    <div class="total-row">
                        <span class="total-label">Total Qty Consumed:</span>
                        <input type="text" class="total-input" id="totalQty" value="0" readonly>
                    </div>
                </div>
            </div>

            <!-- ── Action Buttons ──────────────────────────────────────────── -->
            <div class="btn-group">
                <button type="button" class="btn btn-primary" id="newBtn">➕ New</button>
                <button type="submit" class="btn btn-success">💾 Save</button>
            </div>
        </form>
    </div>

    <!-- ── Item Modal ─────────────────────────────────────────────────────── -->
    <div class="modal item-modal" id="itemModal">
        <div class="item-modal-dialog">
            <div class="item-modal-header">
                <h3 class="item-modal-title">Select Raw Material</h3>
                <button class="item-modal-close" onclick="closeItemModal()">&times;</button>
            </div>
            <div class="item-modal-body">
                <div class="item-search-filters">
                    <input type="text" class="item-search-input" id="itemSearchInput"
                           placeholder="🔍 Search by name or barcode..."
                           onkeyup="filterItems()">
                    <select class="item-filter-select" id="categoryFilter" onchange="filterItems()">
                        <option value="">All Categories</option>
                    </select>
                    <select class="item-filter-select" id="stockFilter" onchange="filterItems()">
                        <option value="">All Stock</option>
                        <option value="instock">In Stock</option>
                        <option value="lowstock">Low Stock</option>
                        <option value="outofstock">Out of Stock</option>
                    </select>
                </div>
                <div class="item-table-container">
                    <table class="item-table">
                        <thead>
                            <tr>
                                <th style="width: 60px;">ID</th>
                                <th style="width: 60px;">Image</th>
                                <th>Item Name</th>
                                <th>Category</th>
                                <th>Barcode</th>
                                <th style="width: 100px;">Stock</th>
                            </tr>
                        </thead>
                        <tbody id="itemTableBody">
                            <tr>
                                <td colspan="6" style="text-align:center;padding:2rem;">
                                    Loading items...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div id="itemEmptyState" class="item-empty-state" style="display:none;">
                    <div class="item-empty-icon">📦</div>
                    <p>No items found</p>
                </div>
            </div>
            <div class="item-modal-footer">
                <button type="button" class="btn btn-danger" onclick="closeItemModal()">✖ Cancel</button>
                <button type="button" class="btn-select-item" id="selectItemBtn"
                        onclick="selectItem()" disabled>
                    ✓ Select Item
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/consumeinvoice.js"></script>