@{
    Layout = "_Layout";
    ViewData["Title"] = "Consumption Vouchers";
}

<style>
    .sl-wrap { padding: 1rem 1.5rem; }
    .sl-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem; }
    .sl-header h2 { margin:0; }
    .sl-filters { display:flex; gap:.5rem; flex-wrap:wrap; align-items:end; margin-bottom:1rem; background:#f8fafc; padding:1rem; border-radius:10px; }
    .sl-filters .fg { display:flex; flex-direction:column; gap:.25rem; }
    .sl-filters label { font-size:.75rem; color:#64748b; font-weight:600; }
    .sl-filters input { padding:.5rem .75rem; border:1px solid #cbd5e1; border-radius:8px; }
    .sl-table { width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .sl-table th, .sl-table td { padding:.7rem .9rem; text-align:left; border-bottom:1px solid #eef2f7; font-size:.9rem; }
    .sl-table th { background:#0f172a; color:#fff; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; }
    .sl-table tbody tr:hover { background:#f1f5f9; }
    .sl-num { text-align:right; font-variant-numeric:tabular-nums; }
    .sl-btn { border:none; border-radius:7px; padding:.35rem .6rem; cursor:pointer; font-size:.78rem; font-weight:600; color:#fff; }
    .sl-view { background:#0ea5e9; } .sl-edit { background:#f59e0b; } .sl-del { background:#ef4444; } .sl-print { background:#64748b; }
    .sl-actions { display:flex; gap:.35rem; flex-wrap:wrap; }
    .sl-modal-bg { position:fixed; inset:0; background:rgba(0,0,0,.5); display:none; align-items:center; justify-content:center; z-index:1000; }
    .sl-modal-bg.show { display:flex; }
    .sl-modal { background:#fff; border-radius:12px; width:min(760px,94vw); max-height:90vh; overflow:auto; padding:1.5rem; }
    .sl-modal h3 { margin-top:0; }
    .sl-meta { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:.6rem; margin-bottom:1rem; }
    .sl-meta div span { display:block; font-size:.72rem; color:#64748b; }
    .sl-meta div b { font-size:.95rem; }
    .sl-empty { text-align:center; padding:2.5rem; color:#94a3b8; }
</style>

<div class="sl-wrap">
    <div class="sl-header">
        <h2>🏭 Consumption Vouchers</h2>
        <a href="/Consume/Index" class="sl-btn" style="background:#16a34a;text-decoration:none;">➕ New Voucher</a>
    </div>

    <div class="sl-filters">
        <div class="fg"><label>Search</label><input type="text" id="fSearch" placeholder="Purpose, Ref, or #" onkeyup="if(event.key==='Enter')loadVouchers()"></div>
        <div class="fg"><label>From</label><input type="date" id="fFrom"></div>
        <div class="fg"><label>To</label><input type="date" id="fTo"></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#0f172a;" onclick="loadVouchers()">🔍 Filter</button></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#94a3b8;" onclick="clearFilters()">✖ Clear</button></div>
    </div>

    <table class="sl-table">
        <thead>
            <tr>
                <th style="width:70px;">Voucher #</th>
                <th>Date</th>
                <th>Purpose</th>
                <th>Ref No</th>
                <th class="sl-num">Items</th>
                <th class="sl-num">Total Qty</th>
                <th style="width:230px;">Actions</th>
            </tr>
        </thead>
        <tbody id="vouchersBody">
            <tr><td colspan="7" class="sl-empty">Loading…</td></tr>
        </tbody>
    </table>
</div>

<!-- View modal -->
<div class="sl-modal-bg" id="viewModal" onclick="if(event.target===this)closeView()">
    <div class="sl-modal">
        <h3 id="vmTitle">Voucher</h3>
        <div class="sl-meta" id="vmMeta"></div>
        <table class="sl-table">
            <thead><tr><th>#</th><th>Item</th><th class="sl-num">Qty</th></tr></thead>
            <tbody id="vmBody"></tbody>
        </table>
        <div style="text-align:right;margin-top:1rem;display:flex;gap:.5rem;justify-content:flex-end;">
            <a id="vmPrint" class="sl-btn sl-print" target="_blank" style="text-decoration:none;">🖨 Print</a>
            <button class="sl-btn" style="background:#0f172a;" onclick="closeView()">Close</button>
        </div>
    </div>
</div>

<script>
function fmt(n){ return (parseFloat(n)||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }

async function loadVouchers(){
    const s = document.getElementById('fSearch').value.trim();
    const f = document.getElementById('fFrom').value;
    const t = document.getElementById('fTo').value;
    const qs = new URLSearchParams();
    if(s) qs.append('search', s);
    if(f) qs.append('from', f);
    if(t) qs.append('to', t);

    const body = document.getElementById('vouchersBody');
    body.innerHTML = '<tr><td colspan="7" class="sl-empty">Loading…</td></tr>';
    try{
        const res = await fetch('/Consume/GetConsumeVouchers?' + qs.toString());
        const payload = await res.json();
        const data = payload.data || [];
        if(!data || data.length === 0){
            body.innerHTML = '<tr><td colspan="7" class="sl-empty">No vouchers found.</td></tr>';
            return;
        }
        body.innerHTML = data.map(c => `
            <tr>
                <td><strong>#${c.consumeId}</strong></td>
                <td>${c.consumeDate || '-'}</td>
                <td>${c.purpose || '-'}</td>
                <td>${c.refNo || '-'}</td>
                <td class="sl-num">${c.itemCount}</td>
                <td class="sl-num">${fmt(c.totalQty)}</td>
                <td>
                    <div class="sl-actions">
                        <button class="sl-btn sl-view" onclick="viewVoucher(${c.consumeId})">👁 View</button>
                        <a class="sl-btn sl-edit" style="text-decoration:none;" href="/Consume/Index?id=${c.consumeId}">✏ Edit</a>
                        <a class="sl-btn sl-print" style="text-decoration:none;" target="_blank" href="/Consume/Print/${c.consumeId}">🖨</a>
                        <button class="sl-btn sl-del" onclick="deleteVoucher(${c.consumeId})">🗑</button>
                    </div>
                </td>
            </tr>`).join('');
    }catch(e){
        body.innerHTML = '<tr><td colspan="7" class="sl-empty" style="color:#dc2626;">Error loading vouchers.</td></tr>';
    }
}

function clearFilters(){
    document.getElementById('fSearch').value='';
    document.getElementById('fFrom').value='';
    document.getElementById('fTo').value='';
    loadVouchers();
}

async function viewVoucher(id){
    try{
        const res = await fetch('/Consume/GetConsumeById?id=' + id);
        if(!res.ok){ await alertDialog('Voucher not found.'); return; }
        const v = await res.json();
        document.getElementById('vmTitle').textContent = 'Consumption Voucher #' + v.consumeId;
        document.getElementById('vmPrint').href = '/Consume/Print/' + v.consumeId;
        document.getElementById('vmMeta').innerHTML = `
            <div><span>Date</span><b>${v.consumeDate||'-'}</b></div>
            <div><span>Purpose</span><b>${v.purpose||'-'}</b></div>
            <div><span>Ref No</span><b>${v.refNo||'-'}</b></div>`;
        document.getElementById('vmBody').innerHTML = (v.items||[]).map((it,i)=>`
            <tr>
                <td>${i+1}</td>
                <td>${it.descr||('#'+it.itemId)}</td>
                <td class="sl-num">${fmt(it.quantity)}</td>
            </tr>`).join('');
        document.getElementById('viewModal').classList.add('show');
    }catch(e){ await alertDialog('Error loading voucher.'); }
}
function closeView(){ document.getElementById('viewModal').classList.remove('show'); }

async function deleteVoucher(id){
    if(!(await confirmDialog(`Delete Consumption Voucher #${id}? This will restore stock.`, { danger: true }))) return;
    try{
        const res = await fetch('/Consume/Delete?id=' + id, { method:'POST' });
        const data = await res.json();
        if(data.success){ await alertDialog('✅ ' + data.message); loadVouchers(); }
        else await alertDialog('❌ ' + (data.message || 'Delete failed.'));
    }catch(e){ await alertDialog('Error deleting voucher.'); }
}

document.addEventListener('DOMContentLoaded', loadVouchers);
</script>
