@model InventorySystem.Core.Models.ConsumeInvoice
@{
    Layout = null;
    var bodies = Model.ConsumeInvoiceBodies ?? new List<InventorySystem.Core.Models.ConsumeInvoiceBody>();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Consumption Voucher #@Model.ConsumeId</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color:#1e293b; margin:0; padding:2rem; }
        .inv { max-width:800px; margin:0 auto; }
        .inv-head { display:flex; justify-content:space-between; border-bottom:3px solid #0f172a; padding-bottom:1rem; margin-bottom:1.5rem; }
        .inv-head h1 { margin:0; font-size:1.6rem; }
        .muted { color:#64748b; font-size:.85rem; }
        .meta { display:grid; grid-template-columns:1fr 1fr; gap:.5rem 2rem; margin-bottom:1.5rem; }
        .meta div span { display:block; font-size:.72rem; color:#64748b; text-transform:uppercase; }
        table { width:100%; border-collapse:collapse; }
        th, td { padding:.55rem .7rem; border-bottom:1px solid #e2e8f0; font-size:.9rem; text-align:left; }
        th { background:#0f172a; color:#fff; text-transform:uppercase; font-size:.75rem; }
        .num { text-align:right; font-variant-numeric:tabular-nums; }
        .actions { text-align:center; margin-bottom:1rem; }
        .actions button { padding:.5rem 1.2rem; border:none; border-radius:8px; background:#0f172a; color:#fff; cursor:pointer; font-size:.9rem; }
        @@media print { .actions { display:none; } body { padding:0; } }
    </style>
</head>
<body>
    <div class="actions"><button onclick="window.print()">🖨 Print</button></div>
    <div class="inv">
        <div class="inv-head">
            <div>
                <h1>CONSUMPTION VOUCHER</h1>
                <div class="muted">Voucher #@Model.ConsumeId</div>
            </div>
            <div style="text-align:right;">
                <div class="muted">Date</div>
                <strong>@(Model.ConsumeDate?.ToString("dd MMM yyyy") ?? "-")</strong>
            </div>
        </div>

        <div class="meta">
            <div><span>Purpose</span><strong>@(Model.Purpose ?? "-")</strong></div>
            <div><span>Ref No</span><strong>@(Model.RefNo ?? "-")</strong></div>
            <div><span>Remarks</span><strong>@(Model.Remarks ?? "-")</strong></div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Item</th>
                    <th class="num">Qty</th>
                </tr>
            </thead>
            <tbody>
                @{ var i = 1; }
                @foreach (var b in bodies)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@(b.Descr ?? ("#" + b.ItemId))</td>
                        <td class="num">@b.Quantity.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
