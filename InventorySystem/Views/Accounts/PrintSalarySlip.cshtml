@model InventorySystem.Core.Models.SalarySlip
@{ Layout=null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Salary Slip SS-@Model.SalarySlipId.ToString("D6")</title>
<link rel="stylesheet" href="~/css/company-brand.css" asp-append-version="true" />
<style>body{font:16px 'Segoe UI',Arial,sans-serif;color:#23394b;margin:24px}main{max-width:720px;margin:auto}header{border-bottom:3px solid #2d5f7f;padding-bottom:15px}h1{font-size:26px}dl{display:grid;grid-template-columns:1fr 1fr;gap:15px}dt{font-size:13px;color:#526474}dd{margin:4px 0 0;font-weight:600}table{width:100%;border-collapse:collapse;margin:24px 0}td,th{padding:14px;border-bottom:1px solid #cbd5e1;text-align:left}td:last-child{text-align:right}.net{font-weight:700;font-size:20px}.signatures{display:flex;justify-content:space-between;margin-top:70px}.note{font-size:13px;color:#526474;white-space:pre-wrap}button{padding:10px 18px;cursor:pointer}@@media print{button{display:none}body{margin:12mm}}@@media(max-width:480px){dl{grid-template-columns:1fr}}</style></head><body><main>
<button class="no-print-btn" onclick="window.print()">Print / Save PDF</button> <button class="no-print-btn" onclick="window.close()">Close</button>
<header><partial name="_CompanyPrintHeader" /><h1>Salary Slip</h1><strong>@Model.Status — SS-@Model.SalarySlipId.ToString("D6")</strong></header>
<dl><div><dt>Employee</dt><dd>@Model.EmployeeName</dd></div><div><dt>Employee code</dt><dd>@Model.EmployeeCode</dd></div><div><dt>Designation</dt><dd>@Model.Designation</dd></div><div><dt>Salary month</dt><dd>@Model.Period.ToString("MMMM yyyy")</dd></div><div><dt>Slip date</dt><dd>@Model.SlipDate.ToString("dd MMM yyyy")</dd></div><div><dt>Prepared by</dt><dd>@Model.PreparedBy</dd></div></dl>
<table><tbody><tr><th>Basic salary</th><td>@Model.BasicSalary.ToString("N2")</td></tr><tr><th>Allowances</th><td>@Model.Allowances.ToString("N2")</td></tr><tr><th>Deductions</th><td>@Model.Deductions.ToString("N2")</td></tr><tr class="net"><th>Net salary</th><td>@Model.NetSalary.ToString("N2")</td></tr></tbody></table>
@if(!string.IsNullOrWhiteSpace(Model.Remarks)){<p class="note">@Model.Remarks</p>}
<p class="note">This salary slip is not proof of payment.</p><div class="signatures"><span>Authorized signature</span><span>Employee signature</span></div>
</main></body></html>
