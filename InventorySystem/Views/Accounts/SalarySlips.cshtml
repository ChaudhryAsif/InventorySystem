@{ ViewData["Title"]="Salary Slips"; Layout="_Layout"; }
<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />
<div class="pr-page" data-payroll="slips">
<header class="pr-header"><div><h1>Salary Slips</h1><p>View and print salary slips. Slips are created from Monthly Payroll.</p></div><div class="pr-actions"><a class="pr-link pr-secondary" href="/Accounts/Employees">Employee data</a><button type="button" id="prNew" hidden disabled>+ New Salary Slip</button><a class="pr-link" href="/Accounts/MonthlyPayroll">Monthly Payroll</a></div></header>
<p id="prMessage" class="pr-message" role="status" hidden></p>
<dialog id="prModal" class="pr-modal" aria-labelledby="prHeading"><header class="pr-modal-header"><h2 id="prHeading">New salary slip</h2><button type="button" class="pr-secondary" data-close-modal aria-label="Close salary slip form">×</button></header><p id="prModalMessage" class="pr-message" role="alert" hidden></p>
<form id="prForm"><input type="hidden" id="salarySlipId" value="0" /><input type="hidden" id="rowVersion" />
<div class="pr-grid">
<label>Employee<select id="employeeId" required><option value="">Select employee</option></select></label>
<label>Salary month<input id="period" type="month" required /></label>
<label>Slip date<input id="slipDate" type="date" required /></label>
<label>Basic salary<input id="basicSalary" type="number" min="0" max="1000000000" step="0.01" value="0" required /></label>
<label>Allowances<input id="allowances" type="number" min="0" max="1000000000" step="0.01" value="0" required /></label>
<label>Deductions<input id="deductions" type="number" min="0" max="1000000000" step="0.01" value="0" required /></label>
<label class="pr-full">Remarks<textarea id="remarks" maxlength="500"></textarea></label>
</div><p>Net salary: <output id="netSalary" class="pr-net">0.00</output></p>
<p class="pr-note">Issuing locks the slip. Salary slips do not record a payment or post accounting entries.</p>
<div class="pr-actions"><button type="submit" id="prSave">Save draft</button><button type="button" id="prIssue" hidden>Issue salary slip</button><a id="prPrint" class="pr-link" target="_blank" rel="noopener" hidden>Print slip</a><button type="button" class="pr-secondary" data-close-modal data-close-footer>Cancel</button></div>
</form></dialog>
<section class="pr-card pr-list"><div class="pr-grid pr-filters"><label>Employee filter<select id="prEmployeeFilter"><option value="">All employees</option></select></label><label>Year<input id="prYear" type="number" min="1900" max="2100" /></label><label>Month<select id="prMonth"><option value="">All months</option><option value="1">January</option><option value="2">February</option><option value="3">March</option><option value="4">April</option><option value="5">May</option><option value="6">June</option><option value="7">July</option><option value="8">August</option><option value="9">September</option><option value="10">October</option><option value="11">November</option><option value="12">December</option></select></label><label hidden>Status<select id="prStatus"><option value="">All statuses</option><option value="Draft">Draft</option><option value="Issued">Issued</option></select></label></div><div class="pr-scroll"><table><thead><tr><th>Slip</th><th>Month</th><th>Employee</th><th>Net salary</th><th>Status</th><th>Action</th></tr></thead><tbody id="prRows"></tbody></table></div></section>
</div>
@section Scripts { <script src="~/js/payroll.js" asp-append-version="true"></script> }
