@{ ViewData["Title"]="Employee Data"; Layout="_Layout"; }
<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />
<div class="pr-page" data-payroll="employees">
<header class="pr-header"><div><h1>Employee Data</h1><p>Maintain employee details and basic monthly salary.</p></div><div class="pr-actions"><a class="pr-link pr-secondary" href="/Accounts/SalarySlips">Salary slips</a><button type="button" id="prNew" disabled>+ Add Employee</button></div></header>
<p id="prMessage" class="pr-message" role="status" hidden></p>
<dialog id="prModal" class="pr-modal" aria-labelledby="prHeading"><header class="pr-modal-header"><h2 id="prHeading">Add employee</h2><button type="button" class="pr-secondary" data-close-modal aria-label="Close employee form">×</button></header><p id="prModalMessage" class="pr-message" role="alert" hidden></p>
<form id="prForm"><input type="hidden" id="employeeId" value="0" /><input type="hidden" id="rowVersion" />
<div class="pr-grid">
<label>Employee code<input id="employeeCode" maxlength="30" required /></label>
<label>Full name<input id="fullName" maxlength="120" required /></label>
<label>Designation<input id="designation" maxlength="100" /></label>
<label>Phone<input id="phone" maxlength="40" /></label>
<label>Joining date<input id="joiningDate" type="date" required /></label>
<label>Basic monthly salary<input id="basicSalary" type="number" min="0" max="1000000000" step="0.01" value="0" required /></label>
<label><span>Employment status</span><span><input id="isActive" type="checkbox" checked /> Active</span></label>
</div><div class="pr-actions"><button type="submit">Save employee</button><button type="button" class="pr-secondary" data-close-modal>Cancel</button></div>
</form></dialog>
<section class="pr-card pr-list"><div class="pr-filters"><label>Find employee<input id="prSearch" placeholder="Search by code or name" /></label><label>Status<select id="prStatus"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label></div><div class="pr-scroll"><table><thead><tr><th>Code</th><th>Name</th><th>Designation</th><th>Basic salary</th><th>Status</th><th>Action</th></tr></thead><tbody id="prRows"></tbody></table></div></section>
</div>
@section Scripts { <script src="~/js/payroll.js" asp-append-version="true"></script> }
