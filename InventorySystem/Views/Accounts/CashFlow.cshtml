@{
    Layout = "_Layout";
    ViewData["Title"] = "Cash Flow Statement";
}
<link href="~/css/Accounts.css" rel="stylesheet" />

<div class="ac-page">

    <div class="page-header">
        <div class="page-title">
            <h2>💧 Cash Flow Statement</h2>
            <p>Movement of cash and bank for a given period</p>
        </div>
        <button class="btn btn-outline" onclick="window.print()">🖨️ Print</button>
    </div>

    <!-- Filter -->
    <div class="filter-section">
        <div class="filter-grid">
            <div class="form-group">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" id="fromDate">
            </div>
            <div class="form-group">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" id="toDate">
            </div>
            <div class="form-group" style="align-self:end">
                <button class="btn btn-primary" onclick="loadReport()">📊 Generate</button>
            </div>
        </div>
    </div>

    <div id="reportSection" style="display:none;margin-top:1.2rem">

        <!-- Summary Cards -->
        <div class="summary-cards">
            <div class="summary-card blue">
                <div class="summary-label">🏁 Opening Cash</div>
                <div class="summary-value" id="openingCash"></div>
            </div>
            <div class="summary-card green">
                <div class="summary-label">📥 Total Inflows</div>
                <div class="summary-value" id="totalInflows"></div>
            </div>
            <div class="summary-card red">
                <div class="summary-label">📤 Total Outflows</div>
                <div class="summary-value" id="totalOutflows"></div>
            </div>
            <div class="summary-card" id="closingCard">
                <div class="summary-label">🏦 Closing Cash</div>
                <div class="summary-value" id="closingCash"></div>
            </div>
        </div>

        <!-- Activities Sections -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-top:1.2rem">

            <!-- Operating -->
            <div class="card">
                <div class="section-header" style="background:linear-gradient(135deg,#28a745,#155724)">
                    <span>⚙️ Operating Activities</span>
                    <span id="operatingNet" style="font-family:monospace"></span>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th style="text-align:right">Inflow</th>
                                <th style="text-align:right">Outflow</th>
                                <th style="text-align:right">Net</th>
                            </tr>
                        </thead>
                        <tbody id="operatingBody"></tbody>
                        <tfoot>
                            <tr class="report-total-row">
                                <td style="text-align:right">Net Operating</td>
                                <td style="text-align:right" id="opInflow"></td>
                                <td style="text-align:right" id="opOutflow"></td>
                                <td style="text-align:right;font-weight:700" id="opNet"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Financing + Other -->
            <div>
                <div class="card" style="margin-bottom:1.2rem">
                    <div class="section-header" style="background:linear-gradient(135deg,#6f42c1,#3d1a78)">
                        <span>🏦 Financing Activities</span>
                        <span id="financingNet" style="font-family:monospace"></span>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th style="text-align:right">Inflow</th>
                                    <th style="text-align:right">Outflow</th>
                                    <th style="text-align:right">Net</th>
                                </tr>
                            </thead>
                            <tbody id="financingBody"></tbody>
                            <tfoot>
                                <tr class="report-total-row">
                                    <td style="text-align:right">Net Financing</td>
                                    <td style="text-align:right" id="finInflow"></td>
                                    <td style="text-align:right" id="finOutflow"></td>
                                    <td style="text-align:right;font-weight:700" id="finNet"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="section-header" style="background:linear-gradient(135deg,#f0ad4e,#856404)">
                        <span>📝 Other Adjustments</span>
                        <span id="otherNet" style="font-family:monospace"></span>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th style="text-align:right">Inflow</th>
                                    <th style="text-align:right">Outflow</th>
                                    <th style="text-align:right">Net</th>
                                </tr>
                            </thead>
                            <tbody id="otherBody"></tbody>
                            <tfoot>
                                <tr class="report-total-row">
                                    <td style="text-align:right">Net Other</td>
                                    <td style="text-align:right" id="othInflow"></td>
                                    <td style="text-align:right" id="othOutflow"></td>
                                    <td style="text-align:right;font-weight:700" id="othNet"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reconciliation Row -->
        <div class="card" style="margin-top:1.2rem">
            <div class="section-header">
                <span>🔁 Cash Position Reconciliation</span>
            </div>
            <div style="padding:1.2rem 1.5rem">
                <table style="width:100%;border-collapse:collapse;max-width:500px;margin:0 auto">
                    <tr style="border-bottom:1px solid var(--border-color)">
                        <td style="padding:0.6rem;font-weight:600">Opening Cash Balance</td>
                        <td style="padding:0.6rem;text-align:right" id="recOpening"></td>
                    </tr>
                    <tr style="border-bottom:1px solid var(--border-color)">
                        <td style="padding:0.6rem;color:#28a745">+ Total Inflows</td>
                        <td style="padding:0.6rem;text-align:right;color:#28a745" id="recInflows"></td>
                    </tr>
                    <tr style="border-bottom:2px solid var(--border-color)">
                        <td style="padding:0.6rem;color:#dc3545">− Total Outflows</td>
                        <td style="padding:0.6rem;text-align:right;color:#dc3545" id="recOutflows"></td>
                    </tr>
                    <tr style="background:#f0f4f8">
                        <td style="padding:0.7rem;font-weight:700;font-size:1.05rem">= Closing Cash Balance</td>
                        <td style="padding:0.7rem;text-align:right;font-weight:700;font-size:1.05rem" id="recClosing"></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const today = new Date().toISOString().split('T')[0];
        const foy   = new Date(new Date().getFullYear(), 0, 1).toISOString().split('T')[0];
        document.getElementById('fromDate').value = foy;
        document.getElementById('toDate').value   = today;

        const fmt = n => Number(n).toLocaleString('en-US', { minimumFractionDigits: 2 });

        function renderRows(rows, tbodyId, inflowId, outflowId, netId) {
            const tbody = document.getElementById(tbodyId);
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--text-secondary);padding:1rem">No transactions</td></tr>';
                document.getElementById(inflowId).textContent  = fmt(0);
                document.getElementById(outflowId).textContent = fmt(0);
                document.getElementById(netId).textContent     = fmt(0);
                return;
            }
            tbody.innerHTML = rows.map(r => `
                <tr>
                    <td>${r.description}</td>
                    <td style="text-align:right;color:#155724">${r.inflow  > 0 ? fmt(r.inflow)  : '—'}</td>
                    <td style="text-align:right;color:#721c24">${r.outflow > 0 ? fmt(r.outflow) : '—'}</td>
                    <td style="text-align:right;font-weight:600;color:${r.net >= 0 ? '#155724' : '#721c24'}">${fmt(r.net)}</td>
                </tr>`).join('');

            const ti = rows.reduce((s, r) => s + r.inflow,  0);
            const to = rows.reduce((s, r) => s + r.outflow, 0);
            const tn = rows.reduce((s, r) => s + r.net,     0);
            document.getElementById(inflowId).textContent  = fmt(ti);
            document.getElementById(outflowId).textContent = fmt(to);
            document.getElementById(netId).textContent     = fmt(tn);
            return tn;
        }

        async function loadReport() {
            const from = document.getElementById('fromDate').value;
            const to   = document.getElementById('toDate').value;
            if (!from || !to) { alert('Please select both dates.'); return; }

            const res  = await fetch(`/Accounts/GetCashFlow?from=${from}&to=${to}`);
            const json = await res.json();
            if (!json.success) { alert('Failed to load cash flow.'); return; }

            const d = json.data;
            document.getElementById('reportSection').style.display = '';

            document.getElementById('openingCash').textContent   = fmt(d.openingCash);
            document.getElementById('totalInflows').textContent  = fmt(d.totalInflows);
            document.getElementById('totalOutflows').textContent = fmt(d.totalOutflows);
            document.getElementById('closingCash').textContent   = fmt(d.closingCash);

            const cc = document.getElementById('closingCard');
            cc.className = 'summary-card ' + (d.closingCash >= 0 ? 'green' : 'red');

            const opNet  = renderRows(d.operatingRows,  'operatingBody',  'opInflow',  'opOutflow',  'opNet')  ?? 0;
            const finNet = renderRows(d.financingRows,  'financingBody',  'finInflow', 'finOutflow', 'finNet') ?? 0;
            const othNet = renderRows(d.otherRows,      'otherBody',      'othInflow', 'othOutflow', 'othNet') ?? 0;

            document.getElementById('operatingNet').textContent = fmt(opNet);
            document.getElementById('financingNet').textContent = fmt(finNet);
            document.getElementById('otherNet').textContent     = fmt(othNet);

            document.getElementById('recOpening').textContent  = fmt(d.openingCash);
            document.getElementById('recInflows').textContent  = fmt(d.totalInflows);
            document.getElementById('recOutflows').textContent = fmt(d.totalOutflows);
            document.getElementById('recClosing').textContent  = fmt(d.closingCash);
        }
    </script>
}