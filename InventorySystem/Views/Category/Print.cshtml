@model InventorySystem.Models.PrintPage<InventorySystem.Models.GroupPrintRow>
@{
    Layout = null;
    string Type(string? t) => t == "RawMaterial" ? "Raw Material" : t == "FinishedGoods" ? "Finished Goods" : "Not set";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Groups - B. Packages</title>
    <link rel="stylesheet" href="~/css/company-brand.css" asp-append-version="true" />
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color:#1e293b; margin:0; padding:@(Model.Popup ? "1rem" : "2rem"); }
        .inv { max-width:960px; margin:0 auto; }
        .inv-head { border-bottom:3px solid #1e3a5f; padding-bottom:.8rem; margin-bottom:1rem; }
        .inv-head h1 { margin:0; font-size:1.4rem; color:#1e3a5f; }
        .muted { color:#64748b; font-size:.85rem; }
        table { width:100%; border-collapse:collapse; }
        th, td { padding:.5rem .7rem; border-bottom:1px solid #e2e8f0; font-size:.9rem; text-align:left; vertical-align:top; }
        th { background:#1e3a5f; color:#fff; text-transform:uppercase; font-size:.75rem; }
        .card { border:1px solid #e2e8f0; border-radius:10px; padding:1rem; margin-bottom:1rem; break-inside:avoid; }
        .grid { display:grid; grid-template-columns:1fr 1fr; gap:.5rem 2rem; }
        .grid div span { display:block; font-size:.72rem; color:#64748b; text-transform:uppercase; }
        .badge { padding:.15rem .6rem; border-radius:10px; font-size:.78rem; font-weight:600; }
        .on { background:#dcfce7; color:#166534; } .off { background:#fee2e2; color:#991b1b; }
        .actions { text-align:center; margin-bottom:1rem; }
        .actions button { padding:.5rem 1.2rem; border:none; border-radius:8px; background:#1e3a5f; color:#fff; cursor:pointer; font-size:.9rem; }
        @@media print { .actions { display:none; } body { padding:0; } }
    </style>
</head>
<body>
    @if (!Model.Popup)
    {
        <div class="actions"><button onclick="window.print()">🖨 Print</button> <button style="background:#64748b" onclick="window.close()">Close</button></div>
    }
    <div class="inv">
        @if (!Model.Popup) { <partial name="_CompanyPrintHeader" /> }
        <div class="inv-head">
            <h1>@(Model.Detail ? "GROUP DETAILS" : "GROUPS")</h1>
            <div class="muted">@Model.Rows.Count record(s) · Printed @DateTime.Now.ToString("dd MMM yyyy HH:mm")</div>
        </div>
        @if (!Model.Rows.Any())
        {
            <p class="muted">No groups found.</p>
        }
        else if (Model.Detail)
        {
            foreach (var r in Model.Rows)
            {
                <div class="card">
                    <div class="grid">
                        <div><span>Group Name</span><strong>@r.CategoryName</strong></div>
                        <div><span>Group Type</span><strong>@Type(r.GroupType)</strong></div>
                        <div><span>Status</span><strong class="badge @(r.IsActive ? "on" : "off")">@(r.IsActive ? "Active" : "Inactive")</strong></div>
                        <div><span>Items in this group</span><strong>@r.ItemCount</strong></div>
                        <div><span>Contact Number</span><strong>@(string.IsNullOrEmpty(r.ContactNumber) ? "-" : r.ContactNumber)</strong></div>
                        <div><span>Created</span><strong>@(r.CreatedDate?.ToString("dd MMM yyyy") ?? "-")</strong></div>
                        <div style="grid-column:1 / -1"><span>Address / Location</span><strong>@(string.IsNullOrEmpty(r.Address) ? "-" : r.Address)</strong></div>
                        <div style="grid-column:1 / -1"><span>Description</span><strong>@(string.IsNullOrEmpty(r.Description) ? "-" : r.Description)</strong></div>
                    </div>
                </div>
            }
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Group Name</th><th>Group Type</th><th>Description</th><th>Address / Location</th><th>Contact Number</th><th>Created Date</th><th>Status</th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.CategoryName</td>
                        <td>@Type(r.GroupType)</td>
                        <td>@r.Description</td>
                        <td>@r.Address</td>
                        <td>@r.ContactNumber</td>
                        <td>@(r.CreatedDate?.ToString("yyyy-MM-dd"))</td>
                        <td><span class="badge @(r.IsActive ? "on" : "off")">@(r.IsActive ? "Active" : "Inactive")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</body>
</html>
