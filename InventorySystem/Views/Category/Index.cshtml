@{ var pageGroupType=(string?)ViewBag.GroupType??"RawMaterial"; var pageLabel=pageGroupType=="FinishedGoods"?"Finished Goods":"Raw Material"; ViewData["Title"] = pageLabel+" Groups"; }
@model IEnumerable<InventorySystem.Core.Models.ItemCategory>

@{
    Layout = "_Layout";
}

<link href="~/css/itemcategory.css" rel="stylesheet" asp-append-version="true" />

<!-- Main Content -->
<div>
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title">
            <h2>@pageLabel Groups</h2>
            <p>Organize inventory items into groups</p>
        </div>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="printGroups(true)" title="Print the ticked rows">🖨 Print Selected</button>
            <button class="btn btn-primary" onclick="printGroups(false)" title="Print the groups shown on screen">🖨 Print List</button>
            <button class="btn btn-success" onclick="openModal()">
                ➕ Add Group
            </button>
        </div>
    </div>

    <!-- Search Section -->
    <div class="search-section" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;">
        <select id="groupNameFilter" class="search-input" aria-label="Group Name" onchange="searchTable()" style="width:240px;">
            <option value="">All Groups</option>
            @foreach (var group in Model.OrderBy(g => g.CategoryName))
            {
                <option value="@group.CategoryId">@group.CategoryName</option>
            }
        </select>
        <select id="groupTypeFilter" class="search-input" aria-label="Group Type" disabled><option value="@pageGroupType">@pageLabel</option></select>
        <div class="search-box">
            <span style="font-size: 1.2rem;">🔍</span>
            <input type="text" class="search-input" placeholder="Search groups..." id="searchInput" oninput="searchTable()">
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card">
        <div class="table-container">
            <table class="data-table" id="categoryTable">
                <thead>
                    <tr>
                        @* <th style="width: 100px;">Category ID</th> *@
                        <th style="width: 40px;"><input type="checkbox" id="pickAll" aria-label="Select all groups" onchange="toggleAllGroups(this.checked)"></th>
                        <th>Group Name</th>
                        <th>Group Type</th>
                        <th>Description</th>
                        <th>Address / Location</th>
                        <th>Contact Number</th>
                        <th style="width: 150px;">Created Date</th>
                        <th style="width: 120px;">Status</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
                    @foreach (var category in Model)
                    {
                        <tr data-category-id="@category.CategoryId" data-group-type="@category.GroupType">
                            <td><input type="checkbox" class="group-pick" value="@category.CategoryId" aria-label="Select group" onchange="syncPickAll()"></td>
                            <td>@category.CategoryName</td>
                            <td>@(category.GroupType == "RawMaterial" ? "Raw Material" : category.GroupType == "FinishedGoods" ? "Finished Goods" : "Not set")</td>
                            <td>@category.Description</td>
                            <td>@category.Address</td>
                            <td>@category.ContactNumber</td>
                            <td>@(category.CreatedDate != null ? category.CreatedDate.Value.ToString("yyyy-MM-dd") : "")</td>
                            <td>
                                <span class="badge @(category.IsActive != null && category.IsActive.Value ? "badge-success" : "badge-danger")">
                                    @(category.IsActive != null && category.IsActive.Value ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @{ var canEditGroup = User.IsInRole("SuperAdmin"); var canDeleteGroup = ViewBag.CanDelete == true; }
                                <div class="am">
                                    <button class="btn btn-sm btn-info" onclick="viewGroup(@category.CategoryId)">👁️ View</button>
                                    @if (canEditGroup || canDeleteGroup)
                                    {
                                        <button type="button" class="am-toggle" aria-haspopup="menu" aria-expanded="false" title="More actions">&#8943;</button>
                                        <div class="am-menu" role="menu">
                                            @if (canEditGroup) { <button onclick="editCategory(@category.CategoryId)">✏️ Edit</button> }
                                            @if (canEditGroup && canDeleteGroup) { <hr> }
                                            @if (canDeleteGroup) { <button class="am-danger" onclick="deleteCategory('@category.CategoryId')">🗑️ Delete</button> }
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <partial name="_ListEmptyState" model='new InventorySystem.Models.ListEmptyState(9, "No groups yet", "Create your first group to organize your inventory.", "+ Add Group", ActionId: "emptyAddGroup")' />
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal" id="categoryModal">
    <div class="modal-dialog">
        <div class="modal-header">
            <h3 class="modal-title" id="modalTitle">Add Group</h3>
            <button class="modal-close" onclick="closeModal('categoryModal')">&times;</button>
        </div>
        <form id="categoryForm" onsubmit="saveCategory(event)">
            <div class="modal-body">
                <input type="hidden" id="categoryId">

                <div class="form-group">
                    <label class="form-label required">Group Name</label>
                    <input type="text" class="form-control" id="categoryName" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="groupAddress">Address / Location</label>
                    <textarea class="form-control" id="groupAddress" rows="2" maxlength="500" autocomplete="street-address"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label" for="groupContactNumber">Contact Number</label>
                    <input type="tel" class="form-control" id="groupContactNumber" maxlength="32" autocomplete="tel">
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" id="categoryDescription" rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label required" for="groupType">Group Type</label>
                    <select class="form-control" id="groupType" required disabled>
                        <option value="@pageGroupType">@pageLabel</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-control" id="categoryStatus">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <p class="category-status-help">Changing group status also changes all linked items. You will review the item names and confirm before anything is saved.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="closeModal('categoryModal')">✖ Cancel</button>
                <button type="submit" class="btn btn-success" id="saveCategoryButton">💾 Save</button>
            </div>
        </form>
    </div>
</div>

<dialog id="categoryStatusConfirmation" aria-labelledby="categoryStatusTitle" aria-describedby="categoryStatusSummary categoryStatusWarning">
    <div class="modal-header">
        <h3 class="modal-title" id="categoryStatusTitle"></h3>
        <button type="button" class="modal-close" aria-label="Cancel status change" onclick="document.getElementById('categoryStatusConfirmation').close('cancel')">&times;</button>
    </div>
    <div class="modal-body">
        <p id="categoryStatusSummary"></p>
        <p id="categoryStatusWarning" class="category-status-warning"></p>
        <p id="categoryStatusCount" class="category-status-help"></p>
        <ul id="categoryStatusItems" aria-label="Linked items and current status"></ul>
        <p class="category-status-help">Existing invoices, stock quantities and balances stay unchanged. Returns against existing invoices remain available.</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-primary" autofocus onclick="document.getElementById('categoryStatusConfirmation').close('cancel')">Cancel</button>
        <button type="button" class="btn" id="confirmCategoryStatusButton" onclick="document.getElementById('categoryStatusConfirmation').close('confirm')"></button>
    </div>
</dialog>

<script>
    const pageGroupType=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageGroupType));
    const canEditGroups = @(User.IsInRole("SuperAdmin") ? "true" : "false");

    function viewGroup(id) {
        const type = encodeURIComponent(pageGroupType);
        ViewPopup.open('Group Details', `/Category/Print?ids=${id}&groupType=${type}&detail=true&popup=true`, `/Category/Print?ids=${id}&groupType=${type}&detail=true`);
    }
    function toggleAllGroups(checked) { document.querySelectorAll('.group-pick').forEach(c => { if (!c.closest('tr').hidden) c.checked = checked; }); }
    function syncPickAll() {
        const picks = [...document.querySelectorAll('.group-pick')].filter(c => !c.closest('tr').hidden);
        document.getElementById('pickAll').checked = picks.length > 0 && picks.every(c => c.checked);
    }
    async function printGroups(selectedOnly) {
        const picks = [...document.querySelectorAll('.group-pick')].filter(c => selectedOnly ? c.checked : !c.closest('tr').hidden);
        if (!picks.length) { await alertDialog(selectedOnly ? 'Tick at least one group to print.' : 'There are no groups to print.'); return; }
        window.open(`/Category/Print?ids=${picks.map(c => c.value).join(',')}&groupType=${encodeURIComponent(pageGroupType)}`, '_blank', 'noopener');
    }

    // Load all categories
function loadCategories() {
    fetch('/Category/GetList?groupType='+pageGroupType)
        .then(response => { if (!response.ok) throw new Error('Load failed'); return response.json(); })
        .then(result => {
            if (result.success) {
                const tableBody = document.getElementById("categoryTableBody");
                tableBody.innerHTML = ""; // Clear old rows

                const groupSelect = document.getElementById('groupNameFilter');
                const selectedGroup = groupSelect.value;
                groupSelect.innerHTML = '<option value="">All Groups</option>';
                result.data.forEach(category => {
                    const option = document.createElement('option'); option.value=category.categoryId; option.textContent=category.categoryName; groupSelect.appendChild(option);
                    const row = document.createElement("tr");
                    row.dataset.categoryId = category.categoryId;
                    row.dataset.groupType = category.groupType || "";
                    row.innerHTML = `
                        <td><input type="checkbox" class="group-pick" value="${category.categoryId}" aria-label="Select group" onchange="syncPickAll()"></td>
                        <td>${escapeHtml(category.categoryName)}</td>
                        <td>${category.groupType === "RawMaterial" ? "Raw Material" : category.groupType === "FinishedGoods" ? "Finished Goods" : "Not set"}</td>
                        <td>${escapeHtml(category.description || "")}</td>
                        <td>${escapeHtml(category.address || "")}</td>
                        <td>${escapeHtml(category.contactNumber || "")}</td>
                        <td>${category.createdDate ? category.createdDate.split('T')[0] : ""}</td>
                        <td>
                            <span class="badge ${category.isActive ? "badge-success" : "badge-danger"}">
                                ${category.isActive ? "Active" : "Inactive"}
                            </span>
                        </td>
                        <td>
                            ${AM.wrap(`<button class="btn btn-sm btn-info" onclick="viewGroup(${category.categoryId})">👁️ View</button>`, [
                                canEditGroups ? `<button onclick="editCategory(${category.categoryId})">✏️ Edit</button>` : '',
                                result.canDelete === true ? '-' : '',
                                result.canDelete === true ? `<button class="am-danger" onclick="deleteCategory(${category.categoryId})">🗑️ Delete</button>` : ''])}
                        </td>
                    `;

                    tableBody.appendChild(row);
                });
                groupSelect.value = selectedGroup;
                searchTable();
            } else {
                throw new Error('Load failed');
            }
        })
        .catch(() => PosListState.show(document.getElementById('categoryTableBody'), { columns:9, error:true, title:'Groups could not be loaded', message:'Check your connection and try again.', actionText:'Try again', onAction:loadCategories }));
}

            let categorySaveInProgress = false;

            function openModal() {
                document.getElementById('modalTitle').textContent = 'Add Group';
                document.getElementById('categoryForm').reset();
                document.getElementById('categoryId').value = '0';
                document.getElementById('categoryModal').classList.add('show');
            }

            function closeModal() {
                document.getElementById('categoryModal').classList.remove('show');
            }

            async function editCategory(id) {
                try {
                const response = await fetch(`/Category/GetById?id=${id}&groupType=${pageGroupType}`);
                if (!response.ok) throw new Error('Group could not be loaded. Refresh the list and try again.');
                const category = await response.json();
                document.getElementById('modalTitle').textContent = 'Edit Group';
                document.getElementById('categoryId').value = category.categoryId;
                document.getElementById('categoryName').value = category.categoryName;
                document.getElementById('categoryDescription').value = category.description || '';
                document.getElementById('groupAddress').value = category.address || '';
                document.getElementById('groupContactNumber').value = category.contactNumber || '';
                document.getElementById('groupType').value = category.groupType || '';
                document.getElementById('categoryStatus').value = (category.isActive === true).toString();
                document.getElementById('categoryModal').classList.add('show');
                } catch (error) { await alertDialog(error.message, { type: 'error' }); }
            }

    function confirmCategoryStatus(preview) {
        const dialog = document.getElementById('categoryStatusConfirmation');
        const action = preview.targetActive ? 'Activate' : 'Deactivate';
        document.getElementById('categoryStatusTitle').textContent = `${action} group and its items?`;
        document.getElementById('categoryStatusSummary').textContent = `${action} "${preview.categoryName}" and all ${preview.items.length} linked item(s)?`;
        document.getElementById('categoryStatusWarning').textContent = preview.targetActive
            ? 'All linked items will become active, including items previously disabled individually. They will be available for purchases and sales.'
            : 'All linked items will become inactive and unavailable for purchases and sales.';
        document.getElementById('categoryStatusCount').textContent = `${preview.changedItemCount} item status(es) will change. ${preview.message}`;
        const list = document.getElementById('categoryStatusItems');
        list.replaceChildren();
        for (const item of preview.items) {
            const li = document.createElement('li');
            const name = document.createElement('span');
            name.textContent = `${item.itemName} (ID ${item.itemId})`;
            const status = document.createElement('small');
            status.textContent = `${item.isActive ? 'Active' : 'Inactive'} → ${preview.targetActive ? 'Active' : 'Inactive'}`;
            li.append(name, status); list.appendChild(li);
        }
        if (!preview.items.length) {
            const li = document.createElement('li'); li.textContent = 'No linked items. Only the group status will change.'; list.appendChild(li);
        }
        const confirmButton = document.getElementById('confirmCategoryStatusButton');
        confirmButton.textContent = `${action} group${preview.items.length ? ' and all items' : ''}`;
        confirmButton.className = `btn ${preview.targetActive ? 'btn-success' : 'btn-danger'}`;
        return new Promise(resolve => {
            dialog.addEventListener('close', () => resolve(dialog.returnValue === 'confirm'), { once: true });
            dialog.returnValue = 'cancel';
            dialog.showModal();
        });
    }

    async function saveCategory(event) {
        event.preventDefault();
        if (categorySaveInProgress) return;

        const name = document.getElementById('categoryName').value.trim();
        const description = document.getElementById('categoryDescription').value;
        const status = document.getElementById('categoryStatus').value;
        const id = Number(document.getElementById('categoryId').value) || 0;
        // Simple validation
        if (name === "") {
            await alertDialog("Please enter group name", { type: 'warning' });
            return;
        }

        const groupType = document.getElementById('groupType').value;
        if (!groupType) { await alertDialog('Please select a group type.', { type:'warning' }); return; }
        const category = {
            CategoryId: id,
            CategoryName: name,
            Description: description,
            Address: document.getElementById('groupAddress').value.trim(),
            ContactNumber: document.getElementById('groupContactNumber').value.trim(),
            GroupType: pageGroupType,
            PageGroupType: pageGroupType,
            IsActive: status
        };

        categorySaveInProgress = true;
        const button = document.getElementById('saveCategoryButton');
        button.disabled = true;
        try {
            while (true) {
                const response = await $.ajax({ url: '/Category/Save', type: 'POST', data: category });
                if (response.requiresConfirmation) {
                    if (!await confirmCategoryStatus(response)) return;
                    category.StatusConfirmationToken = response.confirmationToken;
                    continue;
                }
                if (response.success) {
                    loadCategories(); closeModal();
                    await alertDialog(response.message, { type: 'success' });
                } else {
                    await alertDialog(response.message || 'Group could not be saved.', { type: 'error' });
                }
                return;
            }
        } catch (error) {
            await alertDialog('Group could not be saved. Check your connection and try again.', { type: 'error' });
        } finally {
            categorySaveInProgress = false; button.disabled = false;
        }
    }

    async function deleteCategory(id) {
        if (await confirmDialog('Are you sure you want to delete this group?', { danger: true })) {
            try {
                    const response = await fetch(`/Category/Delete?id=${id}&groupType=${pageGroupType}`, { method: 'POST' });

                const result = await response.json();

                if (result.success) {
                    // Remove row from table
                    const row = document.querySelector(`#categoryTableBody tr[data-category-id="${id}"]`);
                    if (row) row.remove();
                    searchTable();

                    await alertDialog(result.message);
                } else {
                    await alertDialog(result.message || 'Delete failed.');
                }
            } catch (error) {
                console.error('Error:', error);
                await alertDialog('An error occurred while deleting the group.', { type: 'error' });
            }
        }
    }

    function searchTable() {
        const body = document.getElementById('categoryTableBody');
        if (body.querySelector('[data-list-state="error"]')) return;
        PosListState.clear(body);
        const filter = document.getElementById('searchInput').value.trim().toLowerCase();
        const rows = [...body.querySelectorAll('tr[data-category-id]')];
        const type = document.getElementById('groupTypeFilter').value;
        const groupSelect = document.getElementById('groupNameFilter');
        const selectedGroup = groupSelect.value;
        const availableRows = rows.filter(row => !type || row.dataset.groupType === type);
        groupSelect.replaceChildren(new Option('All Groups', ''));
        availableRows.slice().sort((a,b)=>a.cells[1].textContent.localeCompare(b.cells[1].textContent)).forEach(row=>groupSelect.add(new Option(row.cells[1].textContent.trim(),row.dataset.categoryId)));
        groupSelect.value = availableRows.some(row=>row.dataset.categoryId === selectedGroup) ? selectedGroup : '';
        const groupId = groupSelect.value;
        rows.forEach(row => row.hidden = !row.textContent.toLowerCase().includes(filter) || (groupId && row.dataset.categoryId !== groupId) || (type && row.dataset.groupType !== type));
        if (!rows.some(row => !row.hidden)) {
            const matching = rows.length > 0 || !!filter;
            PosListState.show(body, { columns:9,
                title:matching ? 'No matching groups found' : 'No groups yet',
                message:matching ? 'Try a different search or clear the search.' : 'Create your first group to organize your inventory.',
                actionText:matching ? 'Clear search' : '+ Add Group',
                onAction:matching ? () => { document.getElementById('searchInput').value=''; document.getElementById('groupNameFilter').value=''; document.getElementById('groupTypeFilter').value=pageGroupType; searchTable(); document.getElementById('searchInput').focus(); } : openModal });
        }
    }
    document.getElementById('emptyAddGroup')?.addEventListener('click', openModal);

            // Close modal on outside click
            document.getElementById('categoryModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closeModal("categoryModal");
                }
            });

            // Close modal with Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (document.getElementById('categoryStatusConfirmation').open) return;
                    closeModal("categoryModal");
                }
            });
</script>
