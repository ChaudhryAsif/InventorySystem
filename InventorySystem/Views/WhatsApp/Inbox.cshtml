@model List<InventorySystem.Core.Models.AgentThread>
@{
    Layout = "_Layout";
    ViewData["Title"] = "WhatsApp Inbox";
    string currentStatus = ViewBag.Status ?? "all";
    var activeThread = ViewBag.ActiveThread as InventorySystem.Core.Models.AgentThread;
    int lastMsgId = activeThread?.Messages?.LastOrDefault()?.Id ?? 0;
}

<style>

.bubble-ai {
    background: #e3f2fd;
    color: #0d47a1;
    border: 1px solid #90caf9;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
}
.bubble-ai .wa-bubble-meta {
    color: #1565c0 !important;
    opacity: 0.7;
}
.bubble-ai .wa-sender-tag {
    color: #1565c0 !important;
    border-color: rgba(13, 71, 161, 0.15) !important;
}

</style>
<div class="wa-shell">

    <div class="wa-left">
        <div class="wa-left-header">
            <div class="wa-left-title">
                <span style="font-size:1.3rem;">💬</span>
                <span>Chats</span>
                @if (ViewBag.AiPausedCount != null && (int)ViewBag.AiPausedCount > 0)
                {
                    <span class="badge-urgent">@ViewBag.AiPausedCount</span>
                }
            </div>
            <a asp-action="Configure" class="wa-icon-btn" title="Configure">⚙️</a>
        </div>

        <div class="wa-tabs">
            <a asp-action="Inbox" asp-route-status="all"
               class="wa-tab @(currentStatus == "all" ? "active" : "")">All</a>
            <a asp-action="Inbox" asp-route-status="ai_paused"
               class="wa-tab @(currentStatus == "ai_paused" ? "active" : "")">
                AI Paused
                @if (ViewBag.AiPausedCount != null && (int)ViewBag.AiPausedCount > 0)
                { <span class="tab-count">@ViewBag.AiPausedCount</span> }
            </a>
            <a asp-action="Inbox" asp-route-status="active"
               class="wa-tab @(currentStatus == "active" ? "active" : "")">Active</a>
            @* <a asp-action="Inbox" asp-route-status="closed"
               class="wa-tab @(currentStatus == "closed" ? "active" : "")">Closed</a> *@
        </div>

        <div class="wa-search">
            <input type="text" id="searchInput" placeholder="🔍 Search chats..." class="wa-search-input" />
        </div>

        <div class="wa-thread-list" id="threadList">
            @if (!Model.Any())
            {
                <div class="wa-empty-list">
                    <div style="font-size:2rem;">💬</div>
                    <p>No conversations yet</p>
                    <a asp-action="Configure">Configure webhook →</a>
                </div>
            }
            @foreach (var thread in Model)
            {
                var lastMsg  = thread.Messages.FirstOrDefault();
                var isActive = activeThread?.Id == thread.Id;

                var (dotClass, dotLabel) = thread.IsAiPaused
                    ? ("dot-red",   "AI Paused")
                    : thread.Status == "closed"
                        ? ("dot-grey",  "Closed")
                        : ("dot-green", "AI Active");

                <a asp-action="Inbox"
                   asp-route-status="@currentStatus"
                   asp-route-threadId="@thread.Id"
                   class="wa-thread @(isActive ? "wa-thread-active" : "") @(thread.UnreadCount > 0 ? "wa-thread-unread" : "")"
                   data-name="@thread.CustomerName.ToLower()" data-phone="@thread.CustomerPhone">

                    <div class="wa-avatar">@thread.CustomerName.Substring(0,1).ToUpper()</div>
                    <div class="wa-thread-info">
                        <div class="wa-thread-top">
                            <span class="wa-thread-name">@thread.CustomerName</span>
                            <span class="wa-thread-time">@thread.LastMessageAt.ToString("hh:mm tt")</span>
                        </div>
                        <div class="wa-thread-bottom">
                           <span class="wa-thread-preview">
                                @{
                                    var previewMsg = lastMsg?.MessageText;
                                    if (string.IsNullOrEmpty(previewMsg) || previewMsg == "[NEEDS_HUMAN]")
                                        previewMsg = "No messages";
                                }
                                @(previewMsg.Length > 40 ? previewMsg[..40] + "…" : previewMsg)
                            </span>
                            @if (thread.UnreadCount > 0)
                            {
                                <span class="wa-unread-badge">@thread.UnreadCount</span>
                            }
                        </div>
                        <div class="wa-thread-tags">
                            <span class="wa-dot @dotClass"></span>
                            <span class="wa-tag-label">@dotLabel</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>

    <div class="wa-right">
        @if (activeThread == null)
        {
            <div class="wa-no-chat">
                <div style="font-size:4rem;">💬</div>
                <h4>Select a conversation</h4>
                <p>Choose a chat from the left to view messages</p>
                @if (!Model.Any())
                {
                    <a asp-action="Configure" class="btn-wa-primary mt-2">⚙️ Configure WhatsApp</a>
                    <a asp-action="TestMessage" class="btn-wa-secondary mt-2">🧪 Send Test Message</a>
                }
            </div>
        }
        else
        {
            <div class="wa-chat-header">
                <div class="wa-avatar wa-avatar-lg">@activeThread.CustomerName.Substring(0,1).ToUpper()</div>
                <div class="wa-chat-header-info">
                    <div class="wa-chat-name">@activeThread.CustomerName</div>
                    <div class="wa-chat-phone">📞 @activeThread.CustomerPhone</div>
                </div>
                <div class="wa-chat-header-actions">

                    <span class="wa-status-pill @(activeThread.IsAiPaused ? "status-red" : "status-green")">
                        @(activeThread.IsAiPaused ? "🔴 AI Paused" : "🟢 AI Active")
                    </span>

                    @if (activeThread.Status != "closed")
                    {
                        <form asp-action="ToggleAI" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="threadId" value="@activeThread.Id" />
                            <input type="hidden" name="status"   value="@currentStatus" />
                            @if (activeThread.IsAiPaused)
                            {
                                <button type="submit" class="btn-wa-resume" title="Resume AI — AI will auto-reply again">
                                    ▶ Resume AI
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn-wa-pause" title="Pause AI — you will reply manually">
                                    ⏸ Pause AI
                                </button>
                            }
                        </form>

                       @*  <form asp-action="CloseThread" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="threadId" value="@activeThread.Id" />
                            <input type="hidden" name="status"   value="@currentStatus" />
                            <button type="submit" class="btn-wa-outline"
                                    onclick="return confirm('Close this conversation?')">✔️ Close</button>
                        </form> *@
                    }

                    @* <a asp-action="TestMessage" class="btn-wa-outline">🧪 Test</a> *@
                </div>
            </div>

            @if (activeThread.IsAiPaused && activeThread.Status != "closed")
            {
                <div class="wa-human-bar">
                    ⏸ <strong>AI is Paused</strong> — You are in control. Type below to reply.
                    Click <strong>▶ Resume AI</strong> to hand back to AI.
                </div>
            }

            <div class="wa-messages" id="chatWindow">
                @if (!activeThread.Messages.Any())
                {
                    <div class="wa-no-messages">No messages yet in this conversation.</div>
                }
@{
    DateTime? lastDate       = null;
    string?   prevSenderType = null;
}
@foreach (var msg in activeThread.Messages)
{
    // ── [NEEDS_HUMAN] internal flag → small inline badge, skip bubble ──
    if (msg.Status == "ai_paused" || msg.MessageText == "[NEEDS_HUMAN]")
    {
        <div class="wa-needs-human-badge">
            <span>🔴 AI handed over to human agent</span>
        </div>
        continue;
    }

    // ── Date separator ──────────────────────────────────────────────────
    if (lastDate == null || msg.SentAt.Date != lastDate.Value.Date)
    {
        <div class="wa-date-sep">
            <span>@msg.SentAt.ToString("dd MMM yyyy")</span>
        </div>
        lastDate = msg.SentAt.Date;
    }

    // ── Human Takeover separator ────────────────────────────────────────
    if (msg.SenderType == "human" && prevSenderType != "human" && prevSenderType != null)
    {
        <div class="wa-takeover-sep">
            <span>👤 Human Takeover</span>
        </div>
    }

    // ── AI Resumed separator ────────────────────────────────────────────
    if (msg.SenderType == "ai" && prevSenderType == "human")
    {
        <div class="wa-takeover-sep wa-takeover-ai">
            <span>🤖 AI Resumed</span>
        </div>
    }

    prevSenderType = msg.SenderType;

    var isInbound = msg.Direction == "inbound";
    var senderTag = msg.SenderType switch {
        "ai"    => "🤖 AI Agent",
        "human" => "👤 Agent",
        _       => ""
    };

    <div class="wa-msg-row @(isInbound ? "row-in" : "row-out")">
        @if (isInbound)
        {
            <div class="wa-msg-avatar">@activeThread.CustomerName.Substring(0,1).ToUpper()</div>
        }
        <div class="wa-bubble @(isInbound ? "bubble-in" : "bubble-out")
                              @(msg.SenderType == "ai"    ? "bubble-ai"    : "")
                              @(msg.SenderType == "human" ? "bubble-human" : "")">
            @if (!isInbound && !string.IsNullOrEmpty(senderTag))
            {
                <div class="wa-sender-tag">@senderTag</div>
            }
            <div class="wa-bubble-text">@msg.MessageText</div>
            <div class="wa-bubble-meta">
                <span>@msg.SentAt.ToString("hh:mm tt")</span>
                @if (!isInbound)
                {
                    <span class="@(msg.Status == "failed" ? "meta-fail" : "meta-sent")">
                        @(msg.Status == "failed" ? "⚠️" : "✓")
                    </span>
                }
            </div>
        </div>
    </div>
}
</div>

            @if (activeThread.Status != "closed")
            {
                <div class="wa-reply-bar">
                    @if (!activeThread.IsAiPaused)
                    {
                        <div class="wa-reply-notice">⚠️ Sending a message will automatically pause AI for this chat.</div>
                    }
                    <form asp-action="HumanReply" method="post" class="wa-reply-form" id="replyForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="threadId" value="@activeThread.Id" />
                        <input type="hidden" name="status"   value="@currentStatus" />
                        <textarea name="replyText" id="replyText" class="wa-reply-input"
                                  placeholder="@(activeThread.IsAiPaused ? "Type your reply..." : "Type a message to take over...")"
                                  rows="1" required></textarea>
                        <button type="submit" class="wa-send-btn" title="Send">➤</button>
                    </form>
                </div>
            }
            else
            {
                <div class="wa-closed-bar">⚫ This conversation is closed.</div>
            }
        }
    </div>
</div>

<style>
    .main-wrapper { padding: 0 !important; overflow: hidden; }

    .wa-shell {
        display: flex;
        height: calc(100vh - var(--header-height));
        background: #f0f2f5;
        overflow: hidden;
    }

    /* ── LEFT PANEL ── */
    .wa-left {
        width: 320px; min-width: 260px;
        display: flex; flex-direction: column;
        background: #fff;
        border-right: 1px solid var(--border-color);
        overflow: hidden; flex-shrink: 0;
    }
    .wa-left-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.85rem 1rem;
        background: #f0f2f5;
        border-bottom: 1px solid var(--border-color);
        gap: 0.5rem;
    }
    .wa-left-title {
        display: flex; align-items: center; gap: 0.5rem;
        font-weight: 700; font-size: 1rem; color: var(--text-primary);
    }
    .badge-urgent {
        background: var(--danger-color); color: #fff;
        border-radius: 10px; padding: 0.05rem 0.45rem;
        font-size: 0.7rem; font-weight: 700;
    }
    .wa-icon-btn {
        text-decoration: none; font-size: 1.1rem;
        padding: 0.3rem; border-radius: 50%; transition: background 0.2s;
    }
    .wa-icon-btn:hover { background: #e2e5e9; }

    /* Tabs */
    .wa-tabs { display: flex; border-bottom: 1px solid var(--border-color); background: #fff; }
    .wa-tab {
        flex: 1; text-align: center; padding: 0.6rem 0.3rem;
        font-size: 0.78rem; font-weight: 500; color: var(--text-secondary);
        text-decoration: none; border-bottom: 2px solid transparent;
        transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.3rem;
    }
    .wa-tab:hover { color: var(--primary-color); }
    .wa-tab.active { color: var(--primary-color); border-bottom-color: var(--primary-color); font-weight: 700; }
    .tab-count {
        background: var(--danger-color); color: #fff;
        border-radius: 10px; padding: 0.02rem 0.38rem;
        font-size: 0.67rem; font-weight: 700;
    }

    /* Search */
    .wa-search { padding: 0.6rem 0.85rem; background: #fff; border-bottom: 1px solid #f0f2f5; }
    .wa-search-input {
        width: 100%; padding: 0.45rem 0.85rem;
        border: 1px solid var(--border-color); border-radius: 20px;
        font-size: 0.85rem; background: #f0f2f5; outline: none; color: var(--text-primary);
    }
    .wa-search-input:focus { border-color: var(--primary-color); }

    /* Thread list */
    .wa-thread-list { flex: 1; overflow-y: auto; }
    .wa-thread {
        display: flex; align-items: center; gap: 0.75rem;
        padding: 0.75rem 1rem; border-bottom: 1px solid #f0f2f5;
        text-decoration: none; color: inherit; transition: background 0.15s; cursor: pointer;
    }
    .wa-thread:hover { background: #f5f6f7; }
    .wa-thread-active { background: #e8f4f8 !important; border-left: 3px solid var(--primary-color); }
    .wa-thread-unread { background: #fefbe8; }
    .wa-thread-unread .wa-thread-name { font-weight: 700; }

    .wa-avatar {
        width: 42px; height: 42px; border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 1rem; font-weight: 700; flex-shrink: 0;
    }
    .wa-avatar-lg { width: 42px; height: 42px; font-size: 1.1rem; }

    .wa-thread-info { flex: 1; min-width: 0; }
    .wa-thread-top { display: flex; justify-content: space-between; align-items: center; }
    .wa-thread-name { font-size: 0.88rem; font-weight: 600; color: var(--text-primary); }
    .wa-thread-time { font-size: 0.72rem; color: var(--text-secondary); white-space: nowrap; flex-shrink: 0; }
    .wa-thread-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 0.15rem; }
    .wa-thread-preview {
        font-size: 0.78rem; color: var(--text-secondary);
        overflow: hidden; white-space: nowrap; text-overflow: ellipsis; flex: 1;
    }
    .wa-unread-badge {
        background: #25D366; color: #fff; border-radius: 50%;
        width: 18px; height: 18px; font-size: 0.65rem;
        display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;
    }
    .wa-thread-tags { display: flex; align-items: center; gap: 0.3rem; margin-top: 0.2rem; }
    .wa-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
    .dot-red   { background: #dc3545; }
    .dot-green { background: #25D366; }
    .dot-grey  { background: #adb5bd; }
    .wa-tag-label { font-size: 0.7rem; color: var(--text-secondary); }
    .wa-empty-list { text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 0.88rem; }

    /* ── RIGHT PANEL ── */
    .wa-right { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #efeae2; }

    .wa-no-chat {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 0.75rem; color: var(--text-secondary); background: #f0f2f5;
    }
    .wa-no-chat h4 { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin: 0; }
    .wa-no-chat p  { font-size: 0.88rem; margin: 0; }
    .mt-2 { margin-top: 0.5rem; }

    /* Chat Header */
    .wa-chat-header {
        display: flex; align-items: center; gap: 0.85rem;
        padding: 0.75rem 1.25rem;
        background: #f0f2f5;
        border-bottom: 1px solid var(--border-color);
        flex-shrink: 0;
    }
    .wa-chat-header-info { flex: 1; min-width: 0; }
    .wa-chat-name { font-weight: 700; font-size: 0.95rem; color: var(--text-primary); }
    .wa-chat-phone { font-size: 0.77rem; color: var(--text-secondary); }
    .wa-chat-header-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; flex-wrap: wrap; }

    .wa-status-pill {
        font-size: 0.72rem; font-weight: 600;
        padding: 0.22rem 0.65rem; border-radius: 20px;
    }
    .status-red   { background: #f8d7da; color: #842029; }
    .status-green { background: #d1e7dd; color: #0a3622; }
    .status-grey  { background: #e9ecef; color: #495057; }

    /* Buttons */
    .btn-wa-primary {
        background: var(--primary-color); color: #fff;
        padding: 0.5rem 1.1rem; border-radius: var(--radius-sm);
        font-size: 0.85rem; font-weight: 600;
        text-decoration: none; border: none; cursor: pointer;
    }
    .btn-wa-secondary {
        background: #6c757d; color: #fff;
        padding: 0.5rem 1.1rem; border-radius: var(--radius-sm);
        font-size: 0.85rem; font-weight: 600;
        text-decoration: none; border: none; cursor: pointer;
    }
    .btn-wa-outline {
        background: transparent; color: var(--text-primary);
        padding: 0.4rem 0.85rem; border-radius: var(--radius-sm);
        font-size: 0.8rem; font-weight: 600;
        text-decoration: none; border: 1px solid var(--border-color); cursor: pointer;
        transition: background 0.2s;
    }
    .btn-wa-outline:hover { background: #e2e5e9; }

    .btn-wa-pause {
        background: #fff3cd; color: #856404;
        border: 1px solid #ffc107;
        padding: 0.4rem 0.9rem; border-radius: var(--radius-sm);
        font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .btn-wa-pause:hover { background: #ffc107; color: #212529; }

    .btn-wa-resume {
        background: #d1e7dd; color: #0a3622;
        border: 1px solid #25D366;
        padding: 0.4rem 0.9rem; border-radius: var(--radius-sm);
        font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .btn-wa-resume:hover { background: #25D366; color: #fff; }

    /* Human alert bar */
    .wa-human-bar {
        background: #fff3cd; border-left: 4px solid #ffc107;
        padding: 0.6rem 1.25rem; font-size: 0.84rem; color: #664d03; flex-shrink: 0;
    }

    /* Takeover / AI Resumed separators */
    .wa-takeover-sep { text-align: center; margin: 1rem 0 0.5rem; }
    .wa-takeover-sep span {
        background: #fff3cd; color: #856404;
        font-size: 0.72rem; font-weight: 700;
        padding: 0.22rem 0.85rem; border-radius: 20px; border: 1px solid #ffc107;
    }
    .wa-takeover-ai span {
        background: #e8f4f8; color: var(--primary-color);
        border-color: var(--primary-color);
    }

    /* Messages */
    .wa-messages {
        flex: 1; overflow-y: auto;
        padding: 1.25rem 1.5rem;
        display: flex; flex-direction: column; gap: 0.4rem;
        background: #efeae2;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c4c4c4' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .wa-date-sep { text-align: center; margin: 0.75rem 0; }
    .wa-date-sep span {
        background: rgba(225,221,214,0.92); color: #54656f;
        font-size: 0.75rem; font-weight: 600;
        padding: 0.2rem 0.75rem; border-radius: 8px;
    }

    .wa-msg-row { display: flex; align-items: flex-end; gap: 0.45rem; max-width: 72%; }
    .row-in  { align-self: flex-start; }
    .row-out { align-self: flex-end; flex-direction: row-reverse; }

    .wa-msg-avatar {
        width: 28px; height: 28px; border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 0.72rem; font-weight: 700; flex-shrink: 0;
    }

    .wa-bubble {
        padding: 0.5rem 0.85rem 0.4rem; border-radius: 10px;
        max-width: 100%; font-size: 0.88rem; line-height: 1.5;
        box-shadow: 0 1px 2px rgba(0,0,0,0.12); word-break: break-word;
    }
    .bubble-in    { background: #fff; border-bottom-left-radius: 3px; color: var(--text-primary); }
    .bubble-out   { background: #d9fdd3; border-bottom-right-radius: 3px; color: var(--text-primary); }
    .bubble-ai    { background: #1f2c34 !important; color: #fff !important; }
    .bubble-human { background: #e2f0fb !important; }

    .bubble-ai .wa-bubble-meta    { color: rgba(255,255,255,0.55) !important; }
    .bubble-ai .wa-sender-tag     { color: rgba(255,255,255,0.65) !important; border-color: rgba(255,255,255,0.2) !important; }
    .bubble-human .wa-sender-tag  { color: #0a58ca !important; }

    .wa-sender-tag {
        font-size: 0.7rem; font-weight: 700; color: var(--primary-color);
        margin-bottom: 0.2rem; padding-bottom: 0.2rem;
        border-bottom: 1px solid rgba(0,0,0,0.08);
    }
    .wa-bubble-text { white-space: pre-wrap; }
    .wa-bubble-meta {
        display: flex; align-items: center; justify-content: flex-end;
        gap: 0.3rem; font-size: 0.68rem; color: #667781; margin-top: 0.25rem;
    }
    .meta-sent { color: #53bdeb; }
    .meta-fail { color: #dc3545; }
    .wa-no-messages { text-align: center; color: var(--text-secondary); font-size: 0.88rem; margin: auto; }

    /* Reply Bar */
    .wa-reply-bar {
        background: #f0f2f5; border-top: 1px solid var(--border-color);
        padding: 0.6rem 1rem; flex-shrink: 0;
    }
    .wa-reply-notice {
        font-size: 0.75rem; color: #856404;
        margin-bottom: 0.4rem; padding-left: 0.25rem;
    }
    .wa-reply-form {
        display: flex; align-items: flex-end; gap: 0.6rem;
        background: #fff; border-radius: 24px;
        padding: 0.5rem 0.5rem 0.5rem 1rem;
        border: 1px solid var(--border-color);
    }
    .wa-reply-input {
        flex: 1; border: none; outline: none;
        font-size: 0.9rem; resize: none; max-height: 120px;
        overflow-y: auto; background: transparent;
        color: var(--text-primary); line-height: 1.5;
    }
    .wa-send-btn {
        width: 38px; height: 38px;
        background: #25D366; color: #fff;
        border: none; border-radius: 50%;
        font-size: 1rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; transition: background 0.2s;
    }
    .wa-send-btn:hover { background: var(--primary-color); }

    .wa-closed-bar {
        text-align: center; padding: 0.85rem;
        background: #f8f9fa; color: var(--text-secondary);
        font-size: 0.85rem; border-top: 1px solid var(--border-color);
    }

    @@media (max-width: 768px) {
        .wa-left { width: 100%; }
        .wa-right { display: none; }
    }
</style>

@section Scripts {
    <script>
        const chatWindow = document.getElementById('chatWindow');
        if (chatWindow) chatWindow.scrollTop = chatWindow.scrollHeight;

        document.getElementById('replyText')?.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                document.getElementById('replyForm').submit();
            }
        });

        document.getElementById('replyText')?.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });

        document.getElementById('searchInput')?.addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.wa-thread').forEach(el => {
                const name  = el.dataset.name  || '';
                const phone = el.dataset.phone || '';
                el.style.display = (name.includes(q) || phone.includes(q)) ? '' : 'none';
            });
        });

        @if (activeThread != null)
        {
            <text>
            let lastMsgId = @lastMsgId;
            const threadId = @activeThread.Id;

            setInterval(async () => {
                try {
                    const res  = await fetch(`/WhatsApp/GetNewMessages?threadId=${threadId}&afterMessageId=${lastMsgId}`);
                    const msgs = await res.json();
                    if (!msgs.length) return;

                    msgs.forEach(msg => {
                        const isIn    = msg.direction === 'inbound';
                        const isAI    = msg.senderType === 'ai';
                        const isHuman = msg.senderType === 'human';
                        const row     = document.createElement('div');
                        row.className = `wa-msg-row ${isIn ? 'row-in' : 'row-out'}`;

                        const senderTag = isAI
                            ? '<div class="wa-sender-tag">🤖 AI Agent</div>'
                            : isHuman
                                ? '<div class="wa-sender-tag">👤 Agent</div>'
                                : '';

                        const avatarHtml = isIn
                            ? `<div class="wa-msg-avatar">@(activeThread?.CustomerName.Substring(0,1).ToUpper())</div>`
                            : '';

                        const bubbleClass = isAI ? 'bubble-ai' : isHuman ? 'bubble-human' : '';

                        row.innerHTML = `
                            ${avatarHtml}
                            <div class="wa-bubble ${isIn ? 'bubble-in' : 'bubble-out'} ${bubbleClass}">
                                ${!isIn ? senderTag : ''}
                                <div class="wa-bubble-text">${msg.messageText}</div>
                                <div class="wa-bubble-meta">
                                    <span>${msg.sentAt}</span>
                                    ${!isIn ? '<span class="meta-sent">✓</span>' : ''}
                                </div>
                            </div>`;

                        chatWindow.appendChild(row);
                        lastMsgId = Math.max(lastMsgId, msg.id);
                    });

                    chatWindow.scrollTop = chatWindow.scrollHeight;
                } catch(e) { /* ignore */ }
            }, 5000);
            </text>
        }
    </script>
}