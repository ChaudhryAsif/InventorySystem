@{
    Layout = "_Layout";
    ViewData["Title"] = "Sales Report";
    var colCount = BranchSettings.Value.MultiBranchEnabled ? 12 : 11;
}

<link href="~/css/report.css" rel="stylesheet" asp-append-version="true" />
<style>
    .rpt-group-row td { background:#e8eef6; border-top:2px solid #2a5f87; padding:.65rem .9rem; cursor:pointer; }
    .rpt-group-row:hover td { background:#dde7f3; }
    .rpt-group-line { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.4rem 1.2rem; }
    .rpt-group-title { font-weight:700; color:#1e3a5f; }
    .rpt-group-title small { font-weight:500; color:#475569; margin-left:.4rem; }
    .rpt-group-stats { font-size:.86rem; color:#334155; font-variant-numeric:tabular-nums; }
    .rpt-group-stats b { color:#0f172a; }
    .rpt-g-hidden { display:none !important; }
    @@media print { .rpt-group-row td { background:#e8eef6 !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; } }
</style>

<div id="reportPage">
    <div class="pdf-brand"><partial name="_CompanyPrintHeader" /></div>

    <div class="rpt-page-header">
        <div>
            <h2 class="rpt-title">🧾 Sales Report</h2>
            <p class="rpt-subtitle">Summary of all sale invoices with item details</p>
        </div>
        <div class="rpt-header-actions" id="actionButtons">
            <button class="rpt-btn rpt-btn-ghost" id="expandAllBtn" onclick="expandAll()">⊞ Expand All</button>
            <button class="rpt-btn rpt-btn-outline" onclick="showAllGroups();PrintTab.open()">🖨️ Print</button>
            <button class="rpt-btn rpt-btn-primary" id="downloadBtn" onclick="downloadPDF()">⬇️ Download PDF</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="rpt-filter-panel" id="filterPanel">
        <div class="rpt-filter-grid">
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">Invoice No</label>
                <input type="number" class="rpt-filter-input" id="invoiceNoSearch"
                       placeholder="e.g. 1" min="1">
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">From Date</label>
                <input type="date" class="rpt-filter-input" id="fromDate">
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">To Date</label>
                <input type="date" class="rpt-filter-input" id="toDate">
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">Customer</label>
                <select class="rpt-filter-input" id="customerFilter">
                    <option value="">All Customers</option>
                </select>
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">Group by</label>
                <select class="rpt-filter-input" id="groupBy" data-default="order">
                    <option value="order">Production order</option>
                    <option value="none">No grouping</option>
                </select>
            </div>
            <div class="rpt-filter-actions">
                <button class="rpt-btn rpt-btn-primary" onclick="applyFilters()">🔍 Apply</button>
                <button class="rpt-btn rpt-btn-outline" onclick="resetFilters()">↺ Reset</button>
            </div>
        </div>

        <div class="rpt-quick-dates">
            <button type="button" class="rpt-btn rpt-btn-ghost" onclick="quickDate('today')">Today</button>
            <button type="button" class="rpt-btn rpt-btn-ghost" onclick="quickDate('week')">This week</button>
            <button type="button" class="rpt-btn rpt-btn-ghost" onclick="quickDate('month')">This month</button>
            <button type="button" class="rpt-btn rpt-btn-ghost" onclick="quickDate('lastmonth')">Last month</button>
            <button type="button" class="rpt-btn rpt-btn-ghost" onclick="quickDate('year')">This year</button>
        </div>

        <details class="rpt-advanced">
            <summary>Advanced filters</summary>
            <div class="rpt-filter-grid">
                @if (BranchSettings.Value.MultiBranchEnabled)
                {
                    <div class="rpt-filter-group">
                        <label class="rpt-filter-label">Branch</label>
                        <select class="rpt-filter-input" id="branchFilter">
                            <option value="">All Branches</option>
                            <option value="1">Main Branch</option>
                            <option value="2">Branch 2</option>
                            <option value="3">Branch 3</option>
                        </select>
                    </div>
                }
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Payment (Credit = unpaid on account)</label>
                    <select class="rpt-filter-input" id="paymentFilter">
                        <option value="">All Payments</option>
                        <option value="0">Credit</option>
                        <option value="1">Cash</option>
                        <option value="2">Cheque</option>
                        <option value="3">Bank Transfer</option>
                    </select>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Ref No</label>
                    <input type="text" class="rpt-filter-input" id="refNoSearch" maxlength="20" placeholder="Contains...">
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Production order</label>
                    <select class="rpt-filter-input" id="orderFilter">
                        <option value="">All Orders</option>
                    </select>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Item (invoice contains)</label>
                    <select class="rpt-filter-input" id="itemFilter">
                        <option value="">All Items</option>
                    </select>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Group (invoice contains)</label>
                    <select class="rpt-filter-input" id="categoryFilter">
                        <option value="">All Groups</option>
                    </select>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Total amount (min / max)</label>
                    <div class="rpt-range">
                        <input type="number" class="rpt-filter-input" id="minAmount" min="0" step="any" placeholder="Min" data-label="Min amount">
                        <input type="number" class="rpt-filter-input" id="maxAmount" min="0" step="any" placeholder="Max" data-label="Max amount">
                    </div>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Sort by</label>
                    <select class="rpt-filter-input" id="sortBy">
                        <option value="">Date</option>
                        <option value="amount">Total amount</option>
                        <option value="customer">Customer</option>
                        <option value="invoice">Invoice no</option>
                    </select>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Direction</label>
                    <select class="rpt-filter-input" id="sortDir" data-default="desc">
                        <option value="desc">Newest / highest first</option>
                        <option value="asc">Oldest / lowest first</option>
                    </select>
                </div>
            </div>
        </details>
    </div>

    <!-- PDF / Print content -->
    <div id="reportContent">

        <div class="rpt-print-header" id="printHeader">
            <h2>🧾 Sales Report</h2>
            <p>Generated: <span id="generatedDate"></span></p>
            <hr>
        </div>

        <div class="rpt-filter-summary" id="filterSummary"></div>

        <div class="rpt-summary-grid" id="summaryGrid">
            <div class="rpt-summary-card rpt-card-blue">
                <div class="rpt-card-icon">🧾</div>
                <div class="rpt-card-value" id="totalInvoices">–</div>
                <div class="rpt-card-label">Total Invoices</div>
            </div>
            <div class="rpt-summary-card rpt-card-green">
                <div class="rpt-card-icon">💰</div>
                <div class="rpt-card-value" id="totalAmount">–</div>
                <div class="rpt-card-label">Total Amount</div>
            </div>
            <div class="rpt-summary-card rpt-card-purple">
                <div class="rpt-card-icon">✅</div>
                <div class="rpt-card-value" id="netAmount">–</div>
                <div class="rpt-card-label">Net Amount</div>
            </div>
        </div>

        <div class="rpt-table-container">
            <table class="rpt-table rpt-master-table">
                <thead>
                    <tr>
                        <th style="width:40px;"></th>
                        <th style="width:40px;">#</th>
                        <th>Invoice No</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Ref No</th>
                        <th>Order</th>
                        @if (BranchSettings.Value.MultiBranchEnabled)
                        { <th>Branch</th> }
                        <th>Payment</th>
                        <th class="rpt-amount">Total Amount</th>
                        <th class="rpt-amount">Net Amount</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody id="saleTableBody">
                    <tr><td colspan="@colCount" class="rpt-loading">⏳ Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="rpt-pager" id="pager" style="display:none;">
            <button type="button" class="rpt-btn rpt-btn-outline" id="prevPage" onclick="goPage(-1)">← Previous</button>
            <span id="pageInfo"></span>
            <button type="button" class="rpt-btn rpt-btn-outline" id="nextPage" onclick="goPage(1)">Next →</button>
        </div>

        <div class="rpt-empty-state" id="emptyState" style="display:none;">
            <div class="rpt-empty-icon">🧾</div>
            <p>No sale records found for the selected filters.</p>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="~/js/report-filters.js" asp-append-version="true"></script>
<script>
    let allExpanded = false;
    let reportData  = [];
    let currentPage = 1;
    let totalPages  = 1;
    const PAGE_SIZE = 50;

    const filterIds = ['invoiceNoSearch', 'fromDate', 'toDate', 'customerFilter', 'paymentFilter', 'refNoSearch',
        'itemFilter', 'categoryFilter', 'minAmount', 'maxAmount', 'sortBy', 'sortDir', 'orderFilter', 'groupBy'];
    @if (BranchSettings.Value.MultiBranchEnabled) { <text>filterIds.unshift('branchFilter');</text> }
    RptFilters.init(filterIds);

    window.addEventListener('DOMContentLoaded', async function () {
        setDefaultDates();
        await Promise.all([loadCustomers(), loadItems(), loadCategories(), loadOrders()]);
        RptFilters.loadFromUrl();
        applyFilters();
    });

    function setDefaultDates() {
        const today     = new Date();
        const lastMonth = new Date(today.getFullYear(), today.getMonth() - 1, today.getDate());
        document.getElementById('toDate').value   = RptFilters.iso(today);
        document.getElementById('fromDate').value = RptFilters.iso(lastMonth);
    }

    function fillSelect(id, list) {
        const sel = document.getElementById(id);
        list.forEach(s => {
            const o = document.createElement('option');
            o.value = s.value;
            o.textContent = s.text;
            sel.appendChild(o);
        });
    }

    function loadCustomers()  { return fetch('/Report/GetCustomerList').then(r => r.json()).then(l => fillSelect('customerFilter', l)); }
    function loadOrders()     { return fetch('/Report/GetSaleOrderList').then(r => r.json()).then(l => fillSelect('orderFilter', l)); }
    function loadItems()      { return fetch('/Report/GetItemList').then(r => r.json()).then(l => fillSelect('itemFilter', l)); }
    function loadCategories() { return fetch('/Report/GetCategoryList?itemType=FinishedGoods').then(r => r.json()).then(l => fillSelect('categoryFilter', l)); }

    function quickDate(kind) {
        RptFilters.quickDate(kind, 'fromDate', 'toDate');
        applyFilters();
    }

    function goPage(step) {
        currentPage = Math.min(Math.max(1, currentPage + step), totalPages);
        loadData();
    }

    function applyFilters() {
        currentPage = 1;
        RptFilters.saveToUrl();
        RptFilters.writeSummary('filterSummary');
        loadData();
    }

    function loadData() {
        const tbody = document.getElementById('saleTableBody');

        tbody.innerHTML = '<tr><td colspan="@colCount" class="rpt-loading">⏳ Loading...</td></tr>';
        document.getElementById('emptyState').style.display = 'none';

        const params = new URLSearchParams({ page: currentPage, pageSize: PAGE_SIZE });
        [['invoiceNo', 'invoiceNoSearch'], ['from', 'fromDate'], ['to', 'toDate'], ['customerId', 'customerFilter'],
         ['paymentMode', 'paymentFilter'], ['refNo', 'refNoSearch'], ['itemId', 'itemFilter'], ['categoryId', 'categoryFilter'],
         ['minAmount', 'minAmount'], ['maxAmount', 'maxAmount'], ['sortBy', 'sortBy'], ['sortDir', 'sortDir'],
         ['branchId', 'branchFilter'], ['orderId', 'orderFilter'], ['groupBy', 'groupBy']].forEach(([key, id]) => {
            const el = document.getElementById(id);
            if (el && el.value !== '') params.set(key, el.value);
        });

        fetch(`/Report/GetSaleData?${params}`)
            .then(r => r.json())
            .then(result => {
                if (!result.success) {
                    tbody.innerHTML = `<tr><td colspan="@colCount" class="rpt-loading rpt-error">❌ ${result.message}</td></tr>`;
                    return;
                }

                reportData = result.data;

                document.getElementById('totalInvoices').textContent = result.summary.totalInvoices;
                document.getElementById('totalAmount').textContent   = 'Rs. ' + parseFloat(result.summary.totalAmount).toFixed(2);
                document.getElementById('netAmount').textContent     = 'Rs. ' + parseFloat(result.summary.netAmount).toFixed(2);

                totalPages = Math.max(1, Math.ceil(result.totalCount / PAGE_SIZE));
                document.getElementById('pager').style.display = result.totalCount > PAGE_SIZE ? 'flex' : 'none';
                document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages} · ${result.totalCount} invoices`;
                document.getElementById('prevPage').disabled = currentPage <= 1;
                document.getElementById('nextPage').disabled = currentPage >= totalPages;

                if (!reportData || reportData.length === 0) {
                    tbody.innerHTML = '';
                    document.getElementById('emptyState').style.display = 'block';
                    return;
                }

                tbody.innerHTML = renderRows(reportData, result.groups);
                allExpanded = false;
                document.getElementById('expandAllBtn').textContent = '⊞ Expand All';
            })
            .catch(() => {
                tbody.innerHTML = '<tr><td colspan="@colCount" class="rpt-loading rpt-error">❌ Failed to load data.</td></tr>';
            });
    }

    function groupKey(orderId) { return orderId ? 'o' + orderId : 'none'; }

    function renderRows(rows, groups) {
        if (!groups) return rows.map((r, i) => buildInvoiceRows(r, i)).join('');
        const byKey = {};
        groups.forEach(g => { byKey[groupKey(g.orderId)] = g; });
        const onPage = {};
        rows.forEach(r => { const k = groupKey(r.orderId); onPage[k] = (onPage[k] || 0) + 1; });
        let last = null, html = '';
        rows.forEach((r, i) => {
            const key = groupKey(r.orderId);
            if (key !== last) { html += buildGroupRow(key, byKey[key], onPage[key]); last = key; }
            html += buildInvoiceRows(r, i, key);
        });
        return html;
    }

    function buildGroupRow(key, g, shown) {
        if (!g) return '';
        const money = n => 'Rs. ' + parseFloat(n || 0).toFixed(2);
        const title = g.orderId
            ? 'Order #' + g.orderId + '<small>' + escHtml(g.productName || '') + (g.customerName ? ' · ' + escHtml(g.customerName) : '') + '</small>'
            : 'Sales without a production order';
        const boxes = g.orderId ? ' · <b>' + parseFloat(g.boxes) + '</b> boxes' + (g.producedQty != null ? ' of ' + g.producedQty + ' produced' : '') : '';
        const partial = shown < g.invoices ? ' · showing ' + shown + ' of ' + g.invoices + ' on this page' : '';
        return '<tr class="rpt-group-row" onclick="toggleGroup(\'' + key + '\')" title="Click to collapse or expand this group"><td colspan="@colCount"><div class="rpt-group-line">'
            + '<span class="rpt-group-title"><span id="gicon-' + key + '">▼</span> ' + title + '</span>'
            + '<span class="rpt-group-stats"><b>' + g.invoices + '</b> invoice' + (g.invoices === 1 ? '' : 's') + boxes
            + ' · Total <b>' + money(g.totalAmount) + '</b> · Net <b>' + money(g.netAmount) + '</b>' + partial + '</span></div></td></tr>';
    }

    function toggleGroup(key) {
        const rows = document.querySelectorAll('[data-g="' + key + '"]');
        const hide = !(rows.length && rows[0].classList.contains('rpt-g-hidden'));
        rows.forEach(r => r.classList.toggle('rpt-g-hidden', hide));
        const icon = document.getElementById('gicon-' + key);
        if (icon) icon.textContent = hide ? '▶' : '▼';
    }

    function showAllGroups() {
        document.querySelectorAll('.rpt-g-hidden').forEach(r => r.classList.remove('rpt-g-hidden'));
        document.querySelectorAll('[id^="gicon-"]').forEach(i => { i.textContent = '▼'; });
    }

    function buildInvoiceRows(r, i, key) {
        const itemsHtml = r.items && r.items.length > 0
            ? r.items.map(item => `
                <tr>
                    <td>${item.itemId ?? '–'}</td>
                    <td><strong>${escHtml(item.itemName)}</strong></td>
                    <td class="rpt-amount">${item.qty}</td>
                    <td class="rpt-amount">Rs. ${parseFloat(item.salePrice).toFixed(2)}</td>
                    <td class="rpt-amount">${item.discPer}%</td>
                    <td class="rpt-amount">Rs. ${parseFloat(item.discAmt).toFixed(2)}</td>
                    <td class="rpt-amount"><strong>Rs. ${parseFloat(item.total).toFixed(2)}</strong></td>
                </tr>`).join('')
            : '<tr><td colspan="7" style="text-align:center;color:#999;padding:0.75rem;">No items found</td></tr>';

        return `
            <tr class="rpt-master-row"${key ? ` data-g="${key}"` : ''} onclick="toggleDetails(${r.invoiceNo})" title="Click to expand">
                <td>
                    <span class="rpt-expand-icon" id="icon-${r.invoiceNo}">▶</span>
                </td>
                <td>${(currentPage - 1) * PAGE_SIZE + i + 1}</td>
                <td><strong class="rpt-invoice-no">#${r.invoiceNo}</strong></td>
                <td>${r.saleDate}</td>
                <td>${escHtml(r.customerName ?? '–')}</td>
                <td>${escapeHtml(r.refNo)}</td>
                <td>${r.orderId ? '#' + r.orderId : '–'}</td>
                ${@(BranchSettings.Value.MultiBranchEnabled ? "true" : "false") ? '<td>' + escapeHtml(r.branchName) + '</td>' : ''}
                <td><span class="rpt-badge rpt-badge-blue">${r.paymentMode}</span></td>
                <td class="rpt-amount">Rs. ${parseFloat(r.totalAmount).toFixed(2)}</td>
                <td class="rpt-amount"><strong>Rs. ${parseFloat(r.netAmount).toFixed(2)}</strong></td>
                <td class="rpt-remarks" title="${escHtml(r.remarks)}">${escHtml(r.remarks) || '–'}</td>
            </tr>
            <tr class="rpt-detail-row" id="detail-${r.invoiceNo}"${key ? ` data-g="${key}"` : ''}>
                <td colspan="@colCount">
                    <div class="rpt-detail-container">
                        <div class="rpt-detail-header">
                            <span class="rpt-detail-title">📦 Items — Invoice #${r.invoiceNo}</span>
                            <span class="rpt-detail-count">${r.items ? r.items.length : 0} item(s)</span>
                        </div>
                        <table class="rpt-detail-table">
                            <thead>
                                <tr>
                                    <th>Item ID</th>
                                    <th>Item Name</th>
                                    <th>Qty</th>
                                    <th>Sale Price</th>
                                    <th>Disc %</th>
                                    <th>Disc Amt</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>${itemsHtml}</tbody>
                        </table>
                    </div>
                </td>
            </tr>`;
    }

    function toggleDetails(invoiceNo) {
        const row  = document.getElementById(`detail-${invoiceNo}`);
        const icon = document.getElementById(`icon-${invoiceNo}`);
        const open = row.classList.toggle('open');
        icon.textContent = open ? '▼' : '▶';
        icon.classList.toggle('rotated', open);
    }

    function expandAll() {
        allExpanded = !allExpanded;
        reportData.forEach(r => {
            const row  = document.getElementById(`detail-${r.invoiceNo}`);
            const icon = document.getElementById(`icon-${r.invoiceNo}`);
            if (!row) return;
            row.classList.toggle('open', allExpanded);
            if (icon) {
                icon.textContent = allExpanded ? '▼' : '▶';
                icon.classList.toggle('rotated', allExpanded);
            }
        });
        document.getElementById('expandAllBtn').textContent = allExpanded ? '⊟ Collapse All' : '⊞ Expand All';
    }

    function resetFilters() {
        filterIds.forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
        document.getElementById('sortDir').value = 'desc';
        document.getElementById('groupBy').value = 'order';
        setDefaultDates();
        applyFilters();
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    window.addEventListener('beforeprint', () => { document.getElementById('generatedDate').textContent = new Date().toLocaleString(); showAllGroups(); });

    function downloadPDF() {
        const btn         = document.getElementById('downloadBtn');
        const filterPanel = document.getElementById('filterPanel');
        const actionBtns  = document.getElementById('actionButtons');
        const printHeader = document.getElementById('printHeader');

        showAllGroups();
        reportData.forEach(r => {
            const row = document.getElementById(`detail-${r.invoiceNo}`);
            if (row) row.classList.add('open');
        });

        document.getElementById('generatedDate').textContent = new Date().toLocaleString();
        filterPanel.style.display = 'none';
        actionBtns.style.display  = 'none';
        printHeader.style.display = 'block';
        btn.disabled    = true;
        btn.textContent = '⏳ Generating...';

        document.body.classList.add('pdf-exporting');
        html2pdf().set({
            margin:      [10, 8, 10, 8],
            filename:    `SaleReport_${new Date().toISOString().split('T')[0]}.pdf`,
            image:       { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, logging: false },
            jsPDF:       { unit: 'mm', format: 'a4', orientation: 'landscape' }
        }).from(document.getElementById('reportPage')).save().then(() => {
            document.body.classList.remove('pdf-exporting');
            filterPanel.style.display = '';
            actionBtns.style.display  = '';
            printHeader.style.display = 'none';
            btn.disabled    = false;
            btn.textContent = '⬇️ Download PDF';
        });
    }
</script>