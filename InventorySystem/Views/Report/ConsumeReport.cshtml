@{
    Layout = "_Layout";
    ViewData["Title"] = "Consumption Report";
}

<link href="~/css/report.css" rel="stylesheet" />

<div id="reportPage">

    <div class="rpt-page-header">
        <div>
            <h2 class="rpt-title">🏭 Raw Material Consumption Report</h2>
            <p class="rpt-subtitle">Summary of all raw material consumption vouchers with item details</p>
        </div>
        <div class="rpt-header-actions" id="actionButtons">
            <button class="rpt-btn rpt-btn-ghost" id="expandAllBtn" onclick="expandAll()">⊞ Expand All</button>
            <button class="rpt-btn rpt-btn-outline" onclick="window.print()">🖨️ Print</button>
            <button class="rpt-btn rpt-btn-primary" id="downloadBtn" onclick="downloadPDF()">⬇️ Download PDF</button>
        </div>
    </div>

    <!-- ── Filters ──────────────────────────────────────────────────────────── -->
    <div class="rpt-filter-panel" id="filterPanel">
        <div class="rpt-filter-grid">
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">Voucher No</label>
                <input type="number" class="rpt-filter-input" id="voucherNoSearch"
                       placeholder="e.g. 1" min="1">
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">From Date</label>
                <input type="date" class="rpt-filter-input" id="fromDate">
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">To Date</label>
                <input type="date" class="rpt-filter-input" id="toDate">
            </div>
            <div class="rpt-filter-actions">
                <button class="rpt-btn rpt-btn-primary" onclick="applyFilters()">🔍 Apply</button>
                <button class="rpt-btn rpt-btn-outline" onclick="resetFilters()">↺ Reset</button>
            </div>
        </div>
    </div>

    <!-- ── PDF / Print content ───────────────────────────────────────────────── -->
    <div id="reportContent">

        <div class="rpt-print-header" id="printHeader">
            <h2>🏭 Raw Material Consumption Report</h2>
            <p>Generated: <span id="generatedDate"></span></p>
            <hr>
        </div>

        <!-- ── Summary Cards ──────────────────────────────────────────────────── -->
        <div class="rpt-summary-grid" id="summaryGrid">
            <div class="rpt-summary-card rpt-card-blue">
                <div class="rpt-card-icon">📋</div>
                <div class="rpt-card-value" id="totalVouchers">–</div>
                <div class="rpt-card-label">Total Vouchers</div>
            </div>
            <div class="rpt-summary-card rpt-card-green">
                <div class="rpt-card-icon">📦</div>
                <div class="rpt-card-value" id="totalQty">–</div>
                <div class="rpt-card-label">Total Qty Consumed</div>
            </div>
        </div>

        <!-- ── Master Table ────────────────────────────────────────────────────── -->
        <div class="rpt-table-container">
            <table class="rpt-table rpt-master-table">
                <thead>
                    <tr>
                        <th style="width:40px;"></th>
                        <th style="width:40px;">#</th>
                        <th>Voucher No</th>
                        <th>Date</th>
                        <th>Branch</th>
                        <th>Ref No</th>
                        <th>Purpose / Dept</th>
                        <th class="rpt-amount">Items</th>
                        <th class="rpt-amount">Total Qty</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody id="consumeTableBody">
                    <tr><td colspan="10" class="rpt-loading">⏳ Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="rpt-empty-state" id="emptyState" style="display:none;">
            <div class="rpt-empty-icon">🏭</div>
            <p>No consumption records found for the selected filters.</p>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    let allExpanded = false;
    let reportData  = [];

    // ── Init ──────────────────────────────────────────────────────────────────
    window.addEventListener('DOMContentLoaded', function () {
        const today     = new Date();
        const lastMonth = new Date(today.getFullYear(), today.getMonth() - 1, today.getDate());
        document.getElementById('toDate').value   = today.toISOString().split('T')[0];
        document.getElementById('fromDate').value = lastMonth.toISOString().split('T')[0];
        applyFilters();
    });

    // ── Filters ───────────────────────────────────────────────────────────────
    function applyFilters() {
        const voucherNo = document.getElementById('voucherNoSearch').value;
        const from      = document.getElementById('fromDate').value;
        const to        = document.getElementById('toDate').value;
        const tbody     = document.getElementById('consumeTableBody');

        tbody.innerHTML = '<tr><td colspan="10" class="rpt-loading">⏳ Loading...</td></tr>';
        document.getElementById('emptyState').style.display = 'none';

        const params = new URLSearchParams();
        if (voucherNo) params.append('voucherNo', voucherNo);
        if (from)      params.append('from', from);
        if (to)        params.append('to', to);

        fetch(`/Report/GetConsumeData?${params}`)
            .then(r => r.json())
            .then(result => {
                if (!result.success) {
                    tbody.innerHTML = `<tr><td colspan="10" class="rpt-loading rpt-error">❌ ${result.message}</td></tr>`;
                    return;
                }

                reportData = result.data;

                // ── Summary cards ─────────────────────────────────────────────
                document.getElementById('totalVouchers').textContent = result.summary.totalVouchers;
                document.getElementById('totalQty').textContent      = parseFloat(result.summary.totalQty).toFixed(2);

                if (!reportData || reportData.length === 0) {
                    tbody.innerHTML = '';
                    document.getElementById('emptyState').style.display = 'block';
                    return;
                }

                tbody.innerHTML = reportData.map((r, i) => buildVoucherRows(r, i)).join('');
                allExpanded = false;
                document.getElementById('expandAllBtn').textContent = '⊞ Expand All';
            })
            .catch(() => {
                tbody.innerHTML = '<tr><td colspan="10" class="rpt-loading rpt-error">❌ Failed to load data.</td></tr>';
            });
    }

    // ── Build master + detail rows ────────────────────────────────────────────
    function buildVoucherRows(r, i) {
        const itemsHtml = r.items && r.items.length > 0
            ? r.items.map(item => `
                <tr>
                    <td>${item.itemId ?? '–'}</td>
                    <td><strong>${escHtml(item.itemName)}</strong></td>
                    <td class="rpt-amount"><strong>${parseFloat(item.qty).toFixed(2)}</strong></td>
                </tr>`).join('')
            : '<tr><td colspan="3" style="text-align:center;color:#999;padding:0.75rem;">No items found</td></tr>';

        return `
            <tr class="rpt-master-row" onclick="toggleDetails(${r.voucherNo})" title="Click to expand">
                <td>
                    <span class="rpt-expand-icon" id="icon-${r.voucherNo}">▶</span>
                </td>
                <td>${i + 1}</td>
                <td><strong class="rpt-invoice-no">#${r.voucherNo}</strong></td>
                <td>${r.consumeDate}</td>
                <td>${escHtml(r.branchName)}</td>
                <td>${escHtml(r.refNo)}</td>
                <td>${escHtml(r.purpose)}</td>
                <td class="rpt-amount">${r.totalItems}</td>
                <td class="rpt-amount"><strong>${parseFloat(r.totalQty).toFixed(2)}</strong></td>
                <td class="rpt-remarks" title="${escHtml(r.remarks)}">${escHtml(r.remarks) || '–'}</td>
            </tr>
            <tr class="rpt-detail-row" id="detail-${r.voucherNo}">
                <td colspan="10">
                    <div class="rpt-detail-container">
                        <div class="rpt-detail-header">
                            <span class="rpt-detail-title">📦 Items — Voucher #${r.voucherNo}</span>
                            <span class="rpt-detail-count">${r.items ? r.items.length : 0} item(s)</span>
                        </div>
                        <table class="rpt-detail-table">
                            <thead>
                                <tr>
                                    <th>Item ID</th>
                                    <th>Item Name</th>
                                    <th>Qty Consumed</th>
                                </tr>
                            </thead>
                            <tbody>${itemsHtml}</tbody>
                        </table>
                    </div>
                </td>
            </tr>`;
    }

    // ── Expand / Collapse ─────────────────────────────────────────────────────
    function toggleDetails(voucherNo) {
        const row  = document.getElementById(`detail-${voucherNo}`);
        const icon = document.getElementById(`icon-${voucherNo}`);
        const open = row.classList.toggle('open');
        icon.textContent = open ? '▼' : '▶';
        icon.classList.toggle('rotated', open);
    }

    function expandAll() {
        allExpanded = !allExpanded;
        reportData.forEach(r => {
            const row  = document.getElementById(`detail-${r.voucherNo}`);
            const icon = document.getElementById(`icon-${r.voucherNo}`);
            if (!row) return;
            row.classList.toggle('open', allExpanded);
            if (icon) {
                icon.textContent = allExpanded ? '▼' : '▶';
                icon.classList.toggle('rotated', allExpanded);
            }
        });
        document.getElementById('expandAllBtn').textContent = allExpanded ? '⊟ Collapse All' : '⊞ Expand All';
    }

    function resetFilters() {
        const today     = new Date();
        const lastMonth = new Date(today.getFullYear(), today.getMonth() - 1, today.getDate());
        document.getElementById('voucherNoSearch').value = '';
        document.getElementById('fromDate').value        = lastMonth.toISOString().split('T')[0];
        document.getElementById('toDate').value          = today.toISOString().split('T')[0];
        applyFilters();
    }

    // ── PDF Download ──────────────────────────────────────────────────────────
    function downloadPDF() {
        const btn         = document.getElementById('downloadBtn');
        const filterPanel = document.getElementById('filterPanel');
        const actionBtns  = document.getElementById('actionButtons');
        const printHeader = document.getElementById('printHeader');

        // Expand all so items appear in PDF
        reportData.forEach(r => {
            const row = document.getElementById(`detail-${r.voucherNo}`);
            if (row) row.classList.add('open');
        });

        document.getElementById('generatedDate').textContent = new Date().toLocaleString();
        filterPanel.style.display = 'none';
        actionBtns.style.display  = 'none';
        printHeader.style.display = 'block';
        btn.disabled    = true;
        btn.textContent = '⏳ Generating...';

        html2pdf().set({
            margin:      [10, 8, 10, 8],
            filename:    `ConsumeReport_${new Date().toISOString().split('T')[0]}.pdf`,
            image:       { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, logging: false },
            jsPDF:       { unit: 'mm', format: 'a4', orientation: 'landscape' }
        }).from(document.getElementById('reportPage')).save().then(() => {
            filterPanel.style.display = '';
            actionBtns.style.display  = '';
            printHeader.style.display = 'none';
            btn.disabled    = false;
            btn.textContent = '⬇️ Download PDF';
        });
    }

    // ── HTML escape helper ────────────────────────────────────────────────────
    function escHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
</script>