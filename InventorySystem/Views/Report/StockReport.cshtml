@{
    Layout = "_Layout";
    var presetType = ViewBag.ItemType as string ?? "";
    var reportTitle = presetType == "RawMaterial" ? "Raw Material Stock" : presetType == "FinishedGoods" ? "Finished Goods Stock" : "Stock Report";
    ViewData["Title"] = reportTitle;
    var showType = presetType == "";
    var colCount = (BranchSettings.Value.MultiBranchEnabled ? 8 : 7) + (showType ? 1 : 0);
}

<link href="~/css/report.css" rel="stylesheet" asp-append-version="true" />

<div id="reportPage">
    <div class="pdf-brand"><partial name="_CompanyPrintHeader" /></div>

    <div class="rpt-page-header">
        <div>
            <h2 class="rpt-title">📦 @reportTitle</h2>
            <p class="rpt-subtitle">@(BranchSettings.Value.MultiBranchEnabled ? "Real-time inventory levels across all branches" : "Material balances use estimated consumption; reconcile against physical stock regularly.")</p>
        </div>
        <div class="rpt-header-actions" id="actionButtons">
            @if ((string?)ViewBag.ItemType == "RawMaterial") { <a class="rpt-btn rpt-btn-outline" style="text-decoration:none;" href="/Production/PurchaseNeeds">🛒 Materials to Purchase</a> }
            <button class="rpt-btn rpt-btn-outline" onclick="PrintTab.open()">🖨️ Print</button>
            <button class="rpt-btn rpt-btn-primary" id="downloadBtn" onclick="downloadPDF()">⬇️ Download PDF</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="rpt-filter-panel" id="filterPanel">
        <div class="rpt-filter-grid">
            @if (BranchSettings.Value.MultiBranchEnabled)
            {
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Branch</label>
                    <select class="rpt-filter-input" id="branchFilter">
                        <option value="">All Branches</option>
                        <option value="1">Main Branch</option>
                        <option value="2">Branch 2</option>
                        <option value="3">Branch 3</option>
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" id="branchFilter" value="1" />
            }
            @if (showType)
            {
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Report Type</label>
                    <select class="rpt-filter-input" id="typeFilter">
                        <option value="">All Types</option>
                        <option value="RawMaterial">Raw Material</option>
                        <option value="FinishedGoods">Finished Goods</option>
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" id="typeFilter" value="@presetType" />
            }
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">Group Name</label>
                <select class="rpt-filter-input" id="categoryFilter">
                    <option value="">All Groups</option>
                </select>
            </div>
            <div class="rpt-filter-group">
                <label class="rpt-filter-label">Stock Status</label>
                <select class="rpt-filter-input" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="instock">✅ In Stock</option>
                    <option value="lowstock">⚠️ Low Stock</option>
                    <option value="outofstock">❌ Out of Stock</option>
                    <option value="neverstocked">🕳 Never stocked</option>
                </select>
            </div>
            <div class="rpt-filter-actions">
                <button class="rpt-btn rpt-btn-primary" onclick="applyFilters()">🔍 Apply</button>
                <button class="rpt-btn rpt-btn-outline" onclick="resetFilters()">↺ Reset</button>
            </div>
        </div>

        <details class="rpt-advanced">
            <summary>Advanced filters</summary>
            <div class="rpt-filter-grid">
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Item name or barcode</label>
                    <input type="text" class="rpt-filter-input" id="searchText" placeholder="Search..." maxlength="100">
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Quantity (min / max)</label>
                    <div class="rpt-range">
                        <input type="number" class="rpt-filter-input" id="minQty" placeholder="Min" step="any" data-label="Min quantity">
                        <input type="number" class="rpt-filter-input" id="maxQty" placeholder="Max" step="any" data-label="Max quantity">
                    </div>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Last updated (from / to)</label>
                    <div class="rpt-range">
                        <input type="date" class="rpt-filter-input" id="updatedFrom" data-label="Updated from">
                        <input type="date" class="rpt-filter-input" id="updatedTo" data-label="Updated to">
                    </div>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Sort by</label>
                    <select class="rpt-filter-input" id="sortBy">
                        <option value="">Item name</option>
                        <option value="quantity">Quantity</option>
                        <option value="updated">Last updated</option>
                        <option value="category">Category</option>
                    </select>
                </div>
                <div class="rpt-filter-group">
                    <label class="rpt-filter-label">Direction</label>
                    <select class="rpt-filter-input" id="sortDir">
                        <option value="">Ascending</option>
                        <option value="desc">Descending</option>
                    </select>
                </div>
            </div>
        </details>
    </div>

    <!-- PDF / Print content -->
    <div id="reportContent">

        <div class="rpt-print-header" id="printHeader">
            <h2>📦 @reportTitle</h2>
            <p>Generated: <span id="generatedDate"></span></p>
            <hr>
        </div>

        <div class="rpt-filter-summary" id="filterSummary"></div>

        <div class="rpt-summary-grid">
            <div class="rpt-summary-card rpt-card-blue">
                <div class="rpt-card-icon">📋</div>
                <div class="rpt-card-value" id="totalItems">–</div>
                <div class="rpt-card-label">Total Items</div>
            </div>
            <div class="rpt-summary-card rpt-card-green">
                <div class="rpt-card-icon">✅</div>
                <div class="rpt-card-value" id="inStockCount">–</div>
                <div class="rpt-card-label">In Stock</div>
            </div>
            <div class="rpt-summary-card rpt-card-orange">
                <div class="rpt-card-icon">⚠️</div>
                <div class="rpt-card-value" id="lowStockCount">–</div>
                <div class="rpt-card-label">Low Stock</div>
            </div>
            <div class="rpt-summary-card rpt-card-red">
                <div class="rpt-card-icon">❌</div>
                <div class="rpt-card-value" id="outOfStockCount">–</div>
                <div class="rpt-card-label">Out of Stock</div>
            </div>
        </div>

        <div class="rpt-table-container">
            <table class="rpt-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Item ID</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        @if (showType) { <th>Type</th> }
                        @if (BranchSettings.Value.MultiBranchEnabled)
                        { <th>Branch</th> }
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                    </tr>
                </thead>
                <tbody id="stockTableBody">
                    <tr><td colspan="@colCount" class="rpt-loading">⏳ Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="rpt-empty-state" id="emptyState" style="display:none;">
            <div class="rpt-empty-icon">📦</div>
            <p>No stock records found for the selected filters.</p>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="~/js/report-filters.js" asp-append-version="true"></script>
<script>
    const filterIds = ['categoryFilter', 'statusFilter', 'searchText', 'minQty', 'maxQty', 'updatedFrom', 'updatedTo', 'sortBy', 'sortDir'];
    @if (showType) { <text>filterIds.unshift('typeFilter');</text> }
    @if (BranchSettings.Value.MultiBranchEnabled) { <text>filterIds.unshift('branchFilter');</text> }
    RptFilters.init(filterIds);

    window.addEventListener('DOMContentLoaded', async function () {
        await loadCategories();
        RptFilters.loadFromUrl();
        applyFilters();
    });

    function loadCategories() {
        return fetch('/Report/GetCategoryList?itemType=' + encodeURIComponent(document.getElementById('typeFilter').value || ''))
            .then(r => r.json())
            .then(cats => {
                const sel = document.getElementById('categoryFilter');
                cats.forEach(c => {
                    const o = document.createElement('option');
                    o.value = c.value; o.textContent = c.text;
                    sel.appendChild(o);
                });
            });
    }

    function applyFilters() {
        const branchId   = document.getElementById('branchFilter').value || '0';
        const categoryId = document.getElementById('categoryFilter').value || '0';
        const status     = document.getElementById('statusFilter').value;
        const itemType   = document.getElementById('typeFilter').value;
        const tbody      = document.getElementById('stockTableBody');

        tbody.innerHTML = '<tr><td colspan="@colCount" class="rpt-loading">⏳ Loading...</td></tr>';
        document.getElementById('emptyState').style.display = 'none';

        const params = new URLSearchParams({ branchId, categoryId, status, itemType });
        [['search', 'searchText'], ['minQty', 'minQty'], ['maxQty', 'maxQty'], ['updatedFrom', 'updatedFrom'],
         ['updatedTo', 'updatedTo'], ['sortBy', 'sortBy'], ['sortDir', 'sortDir']].forEach(([key, id]) => {
            const v = document.getElementById(id).value;
            if (v !== '') params.set(key, v);
        });
        RptFilters.saveToUrl();
        RptFilters.writeSummary('filterSummary');

        fetch(`/Report/GetStockData?${params}`)
            .then(r => r.json())
            .then(result => {
                if (!result.success) {
                    tbody.innerHTML = `<tr><td colspan="@colCount" class="rpt-loading rpt-error">❌ ${result.message}</td></tr>`;
                    return;
                }
                document.getElementById('filterSummary').insertAdjacentHTML('beforeend', ` · <strong>Showing:</strong> ${result.summary.shown} item(s)`);
                document.getElementById('totalItems').textContent    = result.summary.total;
                document.getElementById('inStockCount').textContent  = result.summary.inStock;
                document.getElementById('lowStockCount').textContent = result.summary.lowStock;
                document.getElementById('outOfStockCount').textContent = result.summary.outOfStock;

                if (!result.data || result.data.length === 0) {
                    tbody.innerHTML = '';
                    document.getElementById('emptyState').style.display = 'block';
                    return;
                }

                tbody.innerHTML = result.data.map((r, i) => `
                    <tr>
                        <td>${i + 1}</td>
                        <td>${r.itemId}</td>
                        <td><strong>${escapeHtml(r.itemName)}</strong></td>
                        <td>${escapeHtml(r.categoryName)}</td>
                        ${@(showType ? "true" : "false") ? '<td>' + typeLabel(r.itemType) + '</td>' : ''}
                        ${@(BranchSettings.Value.MultiBranchEnabled ? "true" : "false") ? '<td>' + escapeHtml(r.branchName) + '</td>' : ''}
                        <td><strong>${r.quantity} ${escapeHtml((r.stockUnit||'').toUpperCase())}</strong></td>
                        <td><span class="rpt-badge ${badgeClass(r.stockStatus)}">${r.stockStatus}</span></td>
                        <td>${r.lastUpdated}</td>
                    </tr>`).join('');
            })
            .catch(() => {
                tbody.innerHTML = '<tr><td colspan="@colCount" class="rpt-loading rpt-error">❌ Failed to load data.</td></tr>';
            });
    }

    function badgeClass(status) {
        if (status === 'In Stock')    return 'rpt-badge-green';
        if (status === 'Low Stock')   return 'rpt-badge-orange';
        return 'rpt-badge-red';
    }

    function resetFilters() {
        document.getElementById('branchFilter').value   = '@(BranchSettings.Value.MultiBranchEnabled ? "" : "1")';
        document.getElementById('categoryFilter').value = '';
        document.getElementById('statusFilter').value   = '';
        document.getElementById('typeFilter').value     = '@presetType';
        ['searchText', 'minQty', 'maxQty', 'updatedFrom', 'updatedTo', 'sortBy', 'sortDir'].forEach(id => document.getElementById(id).value = '');
        applyFilters();
    }

    function typeLabel(t) {
        return t === 'FinishedGoods' ? 'Finished Goods' : 'Raw Material';
    }

    window.addEventListener('beforeprint', () => document.getElementById('generatedDate').textContent = new Date().toLocaleString());

    function downloadPDF() {
        const btn          = document.getElementById('downloadBtn');
        const filterPanel  = document.getElementById('filterPanel');
        const actionBtns   = document.getElementById('actionButtons');
        const printHeader  = document.getElementById('printHeader');

        document.getElementById('generatedDate').textContent = new Date().toLocaleString();
        filterPanel.style.display = 'none';
        actionBtns.style.display  = 'none';
        printHeader.style.display = 'block';
        btn.disabled = true;
        btn.textContent = '⏳ Generating...';

        document.body.classList.add('pdf-exporting');
        html2pdf().set({
            margin:      [10, 8, 10, 8],
            filename:    `@(reportTitle.Replace(" ", ""))_${new Date().toISOString().split('T')[0]}.pdf`,
            image:       { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, logging: false },
            jsPDF:       { unit: 'mm', format: 'a4', orientation: 'landscape' }
        }).from(document.getElementById('reportPage')).save().then(() => {
            document.body.classList.remove('pdf-exporting');
            filterPanel.style.display = '';
            actionBtns.style.display  = '';
            printHeader.style.display = 'none';
            btn.disabled    = false;
            btn.textContent = '⬇️ Download PDF';
        });
    }
</script>
