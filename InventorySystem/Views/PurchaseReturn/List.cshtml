@{
    Layout = "_Layout";
    ViewData["Title"] = "Purchase Returns";
}

<style>
    .sl-wrap { padding: 1rem 1.5rem; }
    .sl-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem; }
    .sl-header h2 { margin:0; }
    .sl-filters { display:flex; gap:.5rem; flex-wrap:wrap; align-items:end; margin-bottom:1rem; background:#f8fafc; padding:1rem; border-radius:10px; }
    .sl-filters .fg { display:flex; flex-direction:column; gap:.25rem; }
    .sl-filters label { font-size:.75rem; color:#64748b; font-weight:600; }
    .sl-filters input { padding:.5rem .75rem; border:1px solid #cbd5e1; border-radius:8px; }
    .sl-table { width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .sl-table th, .sl-table td { padding:.7rem .9rem; text-align:left; border-bottom:1px solid #eef2f7; font-size:.9rem; }
    .sl-table th { background:#0f172a; color:#fff; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; }
    .sl-table tbody tr:hover { background:#f1f5f9; }
    .sl-num { text-align:right; font-variant-numeric:tabular-nums; }
    .sl-badge { padding:.2rem .55rem; border-radius:999px; font-size:.72rem; font-weight:700; }
    .b-credit { background:#fef3c7; color:#92400e; }
    .b-paid   { background:#dcfce7; color:#166534; }
    .sl-btn { border:none; border-radius:7px; padding:.35rem .6rem; cursor:pointer; font-size:.78rem; font-weight:600; color:#fff; }
    .sl-view { background:#0ea5e9; } .sl-edit { background:#f59e0b; } .sl-del { background:#ef4444; } .sl-print { background:#64748b; }
    .sl-actions { display:flex; gap:.35rem; flex-wrap:wrap; }
    .sl-empty { text-align:center; padding:2.5rem; color:#94a3b8; }
</style>

<div class="sl-wrap">
    <div class="sl-header">
        <h2>↩️ Purchase Returns</h2>
        <a href="/PurchaseReturn/Index" class="sl-btn" style="background:#16a34a;text-decoration:none;">➕ New Return</a>
    </div>

    <label><input type="checkbox" id="includeCancelled" onchange="loadReturns()"> Include cancelled documents</label>
    <div class="sl-filters">
        <div class="fg"><label>Search</label><input type="text" id="fSearch" placeholder="Vendor, Ref, or #" onkeyup="if(event.key==='Enter')loadReturns()"></div>
        <div class="fg"><label>From</label><input type="date" id="fFrom"></div>
        <div class="fg"><label>To</label><input type="date" id="fTo"></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#0f172a;" onclick="loadReturns()">🔍 Filter</button></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#94a3b8;" onclick="clearFilters()">✖ Clear</button></div>
    </div>

    <table class="sl-table">
        <thead>
            <tr>
                <th style="width:70px;">Ret #</th>
                <th>Date</th>
                <th>Vendor</th>
                <th>Ref No</th>
                <th>Payment</th>
                <th class="sl-num">Items</th>
                <th class="sl-num">Net Amount</th>
                <th style="width:230px;">Actions</th>
            </tr>
        </thead>
        <tbody id="returnsBody">
            <tr><td colspan="8" class="sl-empty">Loading…</td></tr>
        </tbody>
    </table>
</div>


<script>
    const canEditRecords = @(User.IsInRole("SuperAdmin") ? "true" : "false");
function fmt(n){ return (parseFloat(n)||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }

async function loadReturns(){
    const s = document.getElementById('fSearch').value.trim();
    const f = document.getElementById('fFrom').value;
    const t = document.getElementById('fTo').value;
    const qs = new URLSearchParams();
    if(document.getElementById("includeCancelled").checked) qs.set("includeCancelled", "true");
    if(s) qs.append('search', s);
    if(f) qs.append('from', f);
    if(t) qs.append('to', t);

    const body = document.getElementById('returnsBody');
    body.innerHTML = '<tr><td colspan="8" class="sl-empty">Loading…</td></tr>';
    try{
        const res = await fetch('/PurchaseReturn/GetPurchaseReturns?' + qs.toString());
        if (!res.ok) throw new Error('Load failed');
        const payload = await res.json();
        if (payload.success === false || !Array.isArray(payload.data)) throw new Error('Load failed');
        const data = payload.data || [];
        if(!data || data.length === 0){
            const matching = !!(s || f || t);
            PosListState.show(body, { columns:8,
                title:matching ? 'No matching purchase returns found' : 'No purchase returns yet',
                message:matching ? 'Try a different search or clear the date filters.' : 'Create a purchase return to get started.',
                actionText:matching ? 'Clear filters' : 'Create purchase return',
                onAction:matching ? clearFilters : undefined,
                href:matching ? undefined : '/PurchaseReturn/Index' });
            return;
        }
        body.innerHTML = data.map(r => `
            <tr>
                <td>${r.isCancelled ? "<span>Cancelled</span> " : ""}<strong>#${r.purchaseReturnId}</strong></td>
                <td>${r.returnDate || '-'}</td>
                <td>${escapeHtml(r.vendorName || '-')}</td>
                <td>${escapeHtml(r.refNo || '-')}</td>
                <td><span class="sl-badge ${r.paymentMode==='Credit'?'b-credit':'b-paid'}">${r.paymentMode}</span></td>
                <td class="sl-num">${r.itemCount}</td>
                <td class="sl-num">${fmt(r.netAmount)}</td>
                <td>
                    ${AM.wrap(`<button class="sl-btn sl-view" onclick="viewReturn(${r.purchaseReturnId})">👁 View</button>`, [
                        canEditRecords ? `<a href="${r.isCancelled ? "#" : `/PurchaseReturn/Index?id=${r.purchaseReturnId}`}">✏ Edit</a>` : '',
                        `<a target="_blank" href="/PurchaseReturn/Print/${r.purchaseReturnId}">🖨 Print</a>`,
                        '-',
                        `<button ${r.isCancelled ? "disabled" : ""} class="am-danger" onclick="deleteReturn(${r.purchaseReturnId})">🗑 Delete</button>`])}
                </td>
            </tr>`).join('');
    }catch(e){
        PosListState.show(body, { columns:8, error:true, title:'Could not load purchase returns', message:'Check your connection and try again.', actionText:'Try again', onAction:loadReturns });
    }
}

function clearFilters(){
    document.getElementById('fSearch').value='';
    document.getElementById('fFrom').value='';
    document.getElementById('fTo').value='';
    loadReturns();
}

function viewReturn(id){ ViewPopup.open('Purchase Return #' + id, '/PurchaseReturn/Print/' + id + '?popup=1', '/PurchaseReturn/Print/' + id); }

async function deleteReturn(id){
    if(!(await confirmDialog(`Delete Purchase Return #${id}? This cancels the document and will reverse stock and its ledger entries.`, { danger: true }))) return;
    try{
        const res = await fetch('/PurchaseReturn/Delete?id=' + id, { method:'POST' });
        const data = await res.json();
        if(data.success){ await alertDialog('✅ ' + data.message); loadReturns(); }
        else await alertDialog('❌ ' + (data.message || 'Delete failed.'));
    }catch(e){ await alertDialog('Error deleting return.', { type: 'error' }); }
}

document.addEventListener('DOMContentLoaded', loadReturns);
</script>
