@{
    Layout = "_Layout";
    ViewData["Title"] = "Purchase Invoices";
}

<style>
    .sl-wrap { padding: 1rem 1.5rem; }
    .sl-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem; }
    .sl-header h2 { margin:0; }
    .sl-filters { display:flex; gap:.5rem; flex-wrap:wrap; align-items:end; margin-bottom:1rem; background:#f8fafc; padding:1rem; border-radius:10px; }
    .sl-filters .fg { display:flex; flex-direction:column; gap:.25rem; }
    .sl-filters label { font-size:.75rem; color:#64748b; font-weight:600; }
    .sl-filters input { padding:.5rem .75rem; border:1px solid #cbd5e1; border-radius:8px; }
    .sl-table { width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .sl-table th, .sl-table td { padding:.7rem .9rem; text-align:left; border-bottom:1px solid #eef2f7; font-size:.9rem; }
    .sl-table th { background:#0f172a; color:#fff; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; }
    .sl-table tbody tr:hover { background:#f1f5f9; }
    .sl-num { text-align:right; font-variant-numeric:tabular-nums; }
    .sl-badge { padding:.2rem .55rem; border-radius:999px; font-size:.72rem; font-weight:700; }
    .b-credit { background:#fef3c7; color:#92400e; }
    .b-paid   { background:#dcfce7; color:#166534; }
    .sl-btn { border:none; border-radius:7px; padding:.35rem .6rem; cursor:pointer; font-size:.78rem; font-weight:600; color:#fff; }
    .sl-view { background:#0ea5e9; } .sl-edit { background:#f59e0b; } .sl-del { background:#ef4444; } .sl-print { background:#64748b; }
    .sl-actions { display:flex; gap:.35rem; flex-wrap:wrap; }
    .sl-modal-bg { position:fixed; inset:0; background:rgba(0,0,0,.5); display:none; align-items:center; justify-content:center; z-index:1000; }
    .sl-modal-bg.show { display:flex; }
    .sl-modal { background:#fff; border-radius:12px; width:min(760px,94vw); max-height:90vh; overflow:auto; padding:1.5rem; }
    .sl-modal h3 { margin-top:0; }
    .sl-meta { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:.6rem; margin-bottom:1rem; }
    .sl-meta div span { display:block; font-size:.72rem; color:#64748b; }
    .sl-meta div b { font-size:.95rem; }
    .sl-empty { text-align:center; padding:2.5rem; color:#94a3b8; }
</style>

<div class="sl-wrap">
    <div class="sl-header">
        <h2>📦 Purchase Invoices</h2>
        <a href="/Purchase/Index" class="sl-btn" style="background:#16a34a;text-decoration:none;">➕ New Purchase</a>
    </div>

    <div class="sl-filters">
        <div class="fg"><label>Search</label><input type="text" id="fSearch" placeholder="Vendor, Bill No, or #" onkeyup="if(event.key==='Enter')loadPurchases()"></div>
        <div class="fg"><label>From</label><input type="date" id="fFrom"></div>
        <div class="fg"><label>To</label><input type="date" id="fTo"></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#0f172a;" onclick="loadPurchases()">🔍 Filter</button></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#94a3b8;" onclick="clearFilters()">✖ Clear</button></div>
    </div>

    <table class="sl-table">
        <thead>
            <tr>
                <th style="width:70px;">Inv #</th>
                <th>Date</th>
                <th>Vendor</th>
                <th>Bill No</th>
                <th>Payment</th>
                <th class="sl-num">Items</th>
                <th class="sl-num">Net Amount</th>
                <th style="width:230px;">Actions</th>
            </tr>
        </thead>
        <tbody id="purchasesBody">
            <tr><td colspan="8" class="sl-empty">Loading…</td></tr>
        </tbody>
    </table>
</div>

<!-- View modal -->
<div class="sl-modal-bg" id="viewModal" onclick="if(event.target===this)closeView()">
    <div class="sl-modal">
        <h3 id="vmTitle">Invoice</h3>
        <div class="sl-meta" id="vmMeta"></div>
        <table class="sl-table">
            <thead><tr><th>#</th><th>Item</th><th class="sl-num">Qty</th><th class="sl-num">Price</th><th class="sl-num">Disc</th></tr></thead>
            <tbody id="vmBody"></tbody>
        </table>
        <div style="text-align:right;margin-top:1rem;display:flex;gap:.5rem;justify-content:flex-end;">
            <a id="vmPrint" class="sl-btn sl-print" target="_blank" style="text-decoration:none;">🖨 Print</a>
            <button class="sl-btn" style="background:#0f172a;" onclick="closeView()">Close</button>
        </div>
    </div>
</div>

<script>
function fmt(n){ return (parseFloat(n)||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }

async function loadPurchases(){
    const s = document.getElementById('fSearch').value.trim();
    const f = document.getElementById('fFrom').value;
    const t = document.getElementById('fTo').value;
    const qs = new URLSearchParams();
    if(s) qs.append('search', s);
    if(f) qs.append('from', f);
    if(t) qs.append('to', t);

    const body = document.getElementById('purchasesBody');
    body.innerHTML = '<tr><td colspan="8" class="sl-empty">Loading…</td></tr>';
    try{
        const res = await fetch('/Purchase/GetPurchases?' + qs.toString());
        const payload = await res.json();
        const data = payload.data || [];
        if(!data || data.length === 0){
            body.innerHTML = '<tr><td colspan="8" class="sl-empty">No invoices found.</td></tr>';
            return;
        }
        body.innerHTML = data.map(p => `
            <tr>
                <td><strong>#${p.purchaseId}</strong></td>
                <td>${p.purchaseDate || '-'}</td>
                <td>${p.vendorName || '-'}</td>
                <td>${p.billNo || '-'}</td>
                <td><span class="sl-badge ${p.paymentMode==='Credit'?'b-credit':'b-paid'}">${p.paymentMode}</span></td>
                <td class="sl-num">${p.itemCount}</td>
                <td class="sl-num">${fmt(p.netAmount)}</td>
                <td>
                    <div class="sl-actions">
                        <button class="sl-btn sl-view" onclick="viewPurchase(${p.purchaseId})">👁 View</button>
                        <a class="sl-btn sl-edit" style="text-decoration:none;" href="/Purchase/Index?id=${p.purchaseId}">✏ Edit</a>
                        <a class="sl-btn sl-print" style="text-decoration:none;" target="_blank" href="/Purchase/Print/${p.purchaseId}">🖨</a>
                        <button class="sl-btn sl-del" onclick="deletePurchase(${p.purchaseId})">🗑</button>
                    </div>
                </td>
            </tr>`).join('');
    }catch(e){
        body.innerHTML = '<tr><td colspan="8" class="sl-empty" style="color:#dc2626;">Error loading invoices.</td></tr>';
    }
}

function clearFilters(){
    document.getElementById('fSearch').value='';
    document.getElementById('fFrom').value='';
    document.getElementById('fTo').value='';
    loadPurchases();
}

async function viewPurchase(id){
    try{
        const res = await fetch('/Purchase/GetPurchaseById?id=' + id);
        if(!res.ok){ await alertDialog('Invoice not found.'); return; }
        const inv = await res.json();
        document.getElementById('vmTitle').textContent = 'Purchase Invoice #' + inv.purchaseId;
        document.getElementById('vmPrint').href = '/Purchase/Print/' + inv.purchaseId;
        document.getElementById('vmMeta').innerHTML = `
            <div><span>Date</span><b>${inv.purchaseDate||'-'}</b></div>
            <div><span>Vendor</span><b>${inv.vendorName||'-'}</b></div>
            <div><span>Bill No</span><b>${inv.billNo||'-'}</b></div>
            <div><span>GST</span><b>${fmt(inv.gstAmount)}</b></div>
            <div><span>Discount</span><b>${fmt(inv.discount)}</b></div>
            <div><span>Net Amount</span><b>${fmt(inv.netAmount)}</b></div>`;
        document.getElementById('vmBody').innerHTML = (inv.items||[]).map((it,i)=>`
            <tr>
                <td>${i+1}</td>
                <td>${it.descr||('#'+it.itemid)}</td>
                <td class="sl-num">${fmt(it.quantity)}</td>
                <td class="sl-num">${fmt(it.purPrice)}</td>
                <td class="sl-num">${fmt(it.discAmt)}</td>
            </tr>`).join('');
        document.getElementById('viewModal').classList.add('show');
    }catch(e){ await alertDialog('Error loading invoice.'); }
}
function closeView(){ document.getElementById('viewModal').classList.remove('show'); }

async function deletePurchase(id){
    if(!(await confirmDialog(`Delete Purchase Invoice #${id}? This will reverse stock and its ledger entries.`, { danger: true }))) return;
    try{
        const res = await fetch('/Purchase/Delete?id=' + id, { method:'POST' });
        const data = await res.json();
        if(data.success){ await alertDialog('✅ ' + data.message); loadPurchases(); }
        else await alertDialog('❌ ' + (data.message || 'Delete failed.'));
    }catch(e){ await alertDialog('Error deleting invoice.'); }
}

document.addEventListener('DOMContentLoaded', loadPurchases);
</script>
