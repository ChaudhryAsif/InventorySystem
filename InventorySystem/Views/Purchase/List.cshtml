@{
    Layout = "_Layout";
    ViewData["Title"] = "Purchase Invoices";
}

<style>
    .sl-wrap { padding: 1rem 1.5rem; }
    .sl-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem; }
    .sl-header h2 { margin:0; }
    .sl-filters { display:flex; gap:.5rem; flex-wrap:wrap; align-items:end; margin-bottom:1rem; background:#f8fafc; padding:1rem; border-radius:10px; }
    .sl-filters .fg { display:flex; flex-direction:column; gap:.25rem; }
    .sl-filters label { font-size:.75rem; color:#64748b; font-weight:600; }
    .sl-filters input, .sl-filters select { padding:.5rem .75rem; border:1px solid #cbd5e1; border-radius:8px; }
    .sl-table { width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .sl-table th, .sl-table td { padding:.7rem .9rem; text-align:left; border-bottom:1px solid #eef2f7; font-size:.9rem; }
    .sl-table th { background:#0f172a; color:#fff; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; }
    .sl-table tbody tr:hover { background:#f1f5f9; }
    .sl-num { text-align:right; font-variant-numeric:tabular-nums; }
    .sl-badge { padding:.2rem .55rem; border-radius:999px; font-size:.72rem; font-weight:700; }
    .b-credit { background:#fef3c7; color:#92400e; }
    .b-paid   { background:#dcfce7; color:#166534; }
    .sl-btn { border:none; border-radius:7px; padding:.35rem .6rem; cursor:pointer; font-size:.78rem; font-weight:600; color:#fff; }
    .sl-view { background:#0ea5e9; } .sl-edit { background:#f59e0b; } .sl-del { background:#ef4444; } .sl-print { background:#64748b; }
    .sl-actions { display:flex; gap:.35rem; flex-wrap:wrap; }
    .sl-empty { text-align:center; padding:2.5rem; color:#94a3b8; }
</style>

<div class="sl-wrap">
    <div class="sl-header">
        <h2>📦 Purchase Invoices</h2>
        <a href="/Purchase/Index" class="sl-btn" style="background:#16a34a;text-decoration:none;">➕ New Purchase</a>
    </div>

    <label><input type="checkbox" id="includeCancelled" onchange="loadPurchases()"> Show cancelled documents only</label>
    <div class="sl-filters">
        <div class="fg"><label>Search</label><input type="text" id="fSearch" placeholder="Group, Bill No, or #" onkeyup="if(event.key==='Enter')loadPurchases()"></div>
        <div class="fg"><label for="fGroup">Group Name</label><select id="fGroup" onchange="loadPurchases()"><option value="">All Groups</option></select></div>
        <div class="fg"><label>From</label><input type="date" id="fFrom"></div>
        <div class="fg"><label>To</label><input type="date" id="fTo"></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#0f172a;" onclick="loadPurchases()">🔍 Filter</button></div>
        <div class="fg"><label>&nbsp;</label><button class="sl-btn" style="background:#94a3b8;" onclick="clearFilters()">✖ Clear</button></div>
    </div>

    <table class="sl-table">
        <thead>
            <tr>
                <th style="width:70px;">Inv #</th>
                <th>Date</th>
                <th>Vendor</th>
                <th>Bill No</th>
                <th>Payment</th>
                <th class="sl-num">Items</th>
                <th class="sl-num">Net Amount</th>
                <th style="width:230px;">Actions</th>
            </tr>
        </thead>
        <tbody id="purchasesBody">
            <tr><td colspan="8" class="sl-empty">Loading…</td></tr>
        </tbody>
    </table>
</div>


<script>
function fmt(n){ return (parseFloat(n)||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }

let purchaseListRequest = 0;
async function loadPurchases(){
    const request = ++purchaseListRequest;
    const s = document.getElementById('fSearch').value.trim();
    const f = document.getElementById('fFrom').value;
    const t = document.getElementById('fTo').value;
    const g = document.getElementById('fGroup').value;
    const qs = new URLSearchParams();
    if(document.getElementById("includeCancelled").checked) qs.set("cancelledOnly", "true");
    if(g) qs.set('groupId',g);
    if(s) qs.append('search', s);
    if(f) qs.append('from', f);
    if(t) qs.append('to', t);

    const body = document.getElementById('purchasesBody');
    body.innerHTML = '<tr><td colspan="8" class="sl-empty">Loading…</td></tr>';
    try{
        const res = await fetch('/Purchase/GetPurchases?' + qs.toString());
        if (!res.ok) throw new Error('Load failed');
        const payload = await res.json();
        if (request !== purchaseListRequest) return;
        if (payload.success === false || !Array.isArray(payload.data)) throw new Error('Load failed');
        const data = payload.data || [];
        if(!data || data.length === 0){
            const matching = !!(s || f || t || g || document.getElementById("includeCancelled").checked);
            body.innerHTML = '';
            PosListState.show(body, { columns:8,
                title:matching ? 'No matching purchase invoices found' : 'No purchase invoices yet',
                message:matching ? 'Try another group or clear the filters.' : 'Create a purchase invoice to get started.',
                actionText:matching ? 'Clear filters' : 'Create purchase invoice',
                onAction:matching ? clearFilters : undefined,
                href:matching ? undefined : '/Purchase/Index' });
            return;
        }
        body.innerHTML = data.map(p => `
            <tr>
                <td>${p.isCancelled ? "<span>Cancelled</span> " : ""}<strong>#${p.purchaseId}</strong></td>
                <td>${p.purchaseDate || '-'}</td>
                <td>${escapeHtml(p.vendorName || '-')}</td>
                <td>${escapeHtml(p.billNo || '-')}</td>
                <td><span class="sl-badge ${p.paymentMode==='Credit'?'b-credit':'b-paid'}">${p.paymentMode}</span></td>
                <td class="sl-num">${p.itemCount}</td>
                <td class="sl-num">${fmt(p.netAmount)}</td>
                <td>
                    ${AM.wrap(`<button class="sl-btn sl-view" onclick="viewPurchase(${p.purchaseId})">👁 View</button>`, [
                        `<a target="_blank" href="/Purchase/Print/${p.purchaseId}">🖨 Print</a>`,
                        '-',
                        `<button ${p.isCancelled ? "disabled" : ""} class="am-danger" onclick="deletePurchase(${p.purchaseId})">🗑 Delete</button>`])}
                </td>
            </tr>`).join('');
    }catch(e){
        if (request !== purchaseListRequest) return;
        body.innerHTML = '';
        PosListState.show(body, { columns:8, error:true, title:'Could not load purchase invoices', message:'Check your connection and try again.', actionText:'Try again', onAction:loadPurchases });
    }
}

function clearFilters(){
    document.getElementById('fGroup').value='';
    document.getElementById('includeCancelled').checked=false;
    document.getElementById('fSearch').value='';
    document.getElementById('fFrom').value='';
    document.getElementById('fTo').value='';
    loadPurchases();
}

function viewPurchase(id){ ViewPopup.open('Purchase Invoice #' + id, '/Purchase/Print/' + id + '?popup=1', '/Purchase/Print/' + id); }

async function deletePurchase(id){
    if(!(await confirmDialog(`Delete Purchase Invoice #${id}? This cancels the document and will reverse stock and its ledger entries.`, { danger: true }))) return;
    try{
        const res = await fetch('/Purchase/Delete?id=' + id, { method:'POST' });
        const data = await res.json();
        if(data.success){ await alertDialog('✅ ' + data.message); loadPurchases(); }
        else await alertDialog('❌ ' + (data.message || 'Delete failed.'));
    }catch(e){ await alertDialog('Error deleting invoice.'); }
}

async function loadPurchaseGroups() {
    const select = document.getElementById('fGroup');
    try {
        const res = await fetch('/Purchase/GetSupplierGroups?includeInactive=true');
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error('Group lookup failed');
        select.innerHTML = '<option value="">All Groups</option>';
        data.suppliers.forEach(group => {
            const option = document.createElement('option');
            option.value = group.groupId; option.textContent = group.partyName;
            select.appendChild(option);
        });
    } catch {
        select.innerHTML = '<option value="">Groups unavailable</option>';
        await alertDialog('Could not load group names. Refresh the page to try again.');
    }
}
document.addEventListener('DOMContentLoaded', () => { loadPurchaseGroups(); loadPurchases(); });
</script>


