@{
    Layout = "_Layout";
    ViewData["Title"] = "Stock Adjustment";
}

<link href="~/css/sale.css" rel="stylesheet" />

<style>
    /* ========== RESPONSIVE BASE STYLES ========== */
    * { box-sizing: border-box; }
    
    .sa-wrapper { 
        max-width: 1400px; 
        margin: 0 auto; 
        padding: 0 1rem;
    }
    
    .sa-card { 
        background: #fff; 
        border-radius: 12px; 
        box-shadow: 0 2px 12px rgba(0,0,0,.08); 
        padding: 1.5rem; 
        margin-bottom: 1.2rem; 
    }
    
    .sa-section-title { 
        font-size: .78rem; 
        font-weight: 700; 
        text-transform: uppercase; 
        letter-spacing: .07em;
        color: #fff; 
        background: #1e3a5f; 
        padding: .4rem .9rem; 
        border-radius: 6px;
        margin-bottom: 1rem; 
        display: inline-block; 
    }
    
    /* ========== RESPONSIVE GRID SYSTEM ========== */
    .sa-grid-2 { 
        display: grid; 
        grid-template-columns: 1fr 1fr; 
        gap: 1.2rem; 
    }
    
    .sa-grid-3 { 
        display: grid; 
        grid-template-columns: repeat(3, 1fr); 
        gap: 1.2rem; 
    }
    
    .sa-grid-4 { 
        display: grid; 
        grid-template-columns: repeat(4, 1fr); 
        gap: 1rem; 
    }

    /* Tablet: 768px and below */
    @@media (max-width: 1024px) {
        .sa-grid-4 {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        
        .sa-grid-3 {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
    }

    /* Mobile: 640px and below */
    @@media (max-width: 768px) {
        .sa-wrapper {
            padding: 0 0.75rem;
        }

        .sa-card {
            padding: 1.2rem;
            margin-bottom: 1rem;
        }

        .sa-grid-2,
        .sa-grid-3,
        .sa-grid-4 {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .sa-fg label {
            font-size: 0.75rem;
        }

        .sa-input {
            padding: 0.4rem 0.6rem;
            font-size: 0.85rem;
        }
    }
    
    /* ========== FORM GROUP ========== */
    .sa-fg { 
        display: flex; 
        flex-direction: column; 
        gap: .5rem; 
    }
    
    .sa-fg label { 
        font-size: .78rem; 
        font-weight: 600; 
        color: #374151; 
    }
    
    .sa-input { 
        padding: .45rem .7rem; 
        border: 1px solid #d1d5db; 
        border-radius: 7px; 
        font-size: .87rem;
        width: 100%; 
        box-sizing: border-box; 
        transition: all 0.2s ease;
    }
    
    .sa-input:focus { 
        outline: none; 
        border-color: #3b82f6; 
        box-shadow: 0 0 0 3px rgba(59,130,246,.12); 
    }
    
    .sa-input[readonly] { 
        background: #f3f4f6; 
        color: #6b7280; 
    }

    /* ========== TABLE STYLES ========== */
    .items-table { 
        width: 100%; 
        border-collapse: collapse; 
        font-size: .83rem; 
        margin-top: 1rem;
        overflow-x: auto;
    }
    
    .items-table thead tr { 
        background: #1e3a5f; 
        color: #fff; 
    }
    
    .items-table th, .items-table td { 
        padding: .5rem .6rem; 
        text-align: left; 
        border-bottom: 1px solid #e5e7eb; 
    }
    
    .items-table tbody tr { 
        transition: background 0.2s ease;
    }
    
    .items-table tbody tr:hover { 
        background: #f8faff; 
    }
    
    .items-table .num { 
        text-align: right; 
    }

    /* Responsive table wrapper */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 768px) {
        .items-table {
            font-size: 0.75rem;
        }

        .items-table th, .items-table td {
            padding: 0.4rem 0.4rem;
        }

        .items-table thead th:nth-child(n+4) {
            display: none;
        }

        .items-table tbody td:nth-child(n+4) {
            display: none;
        }
    }
    
    /* ========== ITEM INPUT ========== */
    .item-input { 
        padding: .3rem .5rem; 
        border: 1px solid #d1d5db; 
        border-radius: 5px; 
        font-size: .82rem;
        width: 100%; 
        box-sizing: border-box; 
        transition: all 0.2s ease;
    }
    
    .item-input.calc { 
        background: #eff6ff; 
        font-weight: 600; 
        color: #1e40af; 
    }

    /* ========== BUTTONS ========== */
    .btn-add-item { 
        background: #059669; 
        color: #fff; 
        border: none; 
        border-radius: 7px; 
        padding: .4rem 1rem;
        font-size: .82rem; 
        cursor: pointer; 
        margin-top: .5rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .btn-add-item:hover {
        background: #047857;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
    }

    .btn-remove { 
        background: #ef4444; 
        color: #fff; 
        border: none; 
        border-radius: 5px; 
        padding: .25rem .6rem;
        font-size: .8rem; 
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-remove:hover {
        background: #dc2626;
        transform: translateY(-1px);
    }
    
    .sa-action-bar { 
        display: flex; 
        gap: .75rem; 
        justify-content: flex-end; 
        margin-top: 1.2rem;
        flex-wrap: wrap;
    }

    @@media (max-width: 768px) {
        .sa-action-bar {
            flex-direction: column;
            gap: 0.6rem;
        }

        .sa-action-bar button,
        .sa-action-bar a {
            width: 100%;
        }
    }

    /* ========== LOOKUP ========== */
    .lookup-wrap { 
        display: flex; 
        gap: .4rem;
        flex-wrap: wrap;
    }
    
    .lookup-wrap input { 
        flex: 1;
        min-width: 150px;
    }
    
    .btn-lookup { 
        padding: .45rem .8rem; 
        background: #1e3a5f; 
        color: #fff; 
        border: none; 
        border-radius: 7px; 
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .btn-lookup:hover {
        background: #162d48;
        transform: translateY(-1px);
    }

    /* ========== MODAL STYLES ========== */
    .item-modal { 
        display: none; 
        position: fixed; 
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%; 
        background: rgba(0, 0, 0, 0.65); 
        z-index: 1000;
        backdrop-filter: blur(2px);
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    .item-modal-dialog { 
        background: #fff; 
        border-radius: 12px; 
        max-width: 1000px; 
        margin: 1rem auto;
        padding: 2rem; 
        position: relative; 
        max-height: 90vh; 
        overflow-y: auto;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-40px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@media (max-width: 768px) {
        .item-modal-dialog {
            margin: 0.5rem;
            padding: 1.5rem;
            max-width: calc(100% - 1rem);
            max-height: 95vh;
            border-radius: 10px;
        }
    }
    
    .item-modal-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e5e7eb;
    }
    
    .item-modal-title { 
        font-size: 1.4rem; 
        font-weight: 700;
        color: #1e3a5f;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .item-modal-title {
            font-size: 1.1rem;
        }
    }
    
    /* ========== ENHANCED CLOSE BUTTON ========== */
    .item-modal-close { 
        position: absolute; 
        top: 1.5rem; 
        right: 1.5rem; 
        width: 40px; 
        height: 40px; 
        border-radius: 50%;
        background: #f3f4f6;
        border: 2px solid #e5e7eb;
        font-size: 24px;
        color: #6b7280;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        font-weight: 300;
        line-height: 1;
        padding: 0;
    }
    
    .item-modal-close:hover { 
        background: #fee2e2; 
        border-color: #fca5a5;
        color: #dc2626;
        transform: rotate(90deg) scale(1.1);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }

    .item-modal-close:active {
        transform: rotate(90deg) scale(0.95);
    }

    @@media (max-width: 768px) {
        .item-modal-close {
            top: 1rem;
            right: 1rem;
            width: 36px;
            height: 36px;
            font-size: 20px;
        }
    }
    
    .item-modal-body { 
        max-height: 60vh; 
        overflow-y: auto;
        padding: 0.5rem 0;
    }

    /* ========== SEARCH FILTERS ========== */
    .item-search-filters { 
        display: grid; 
        grid-template-columns: 2fr 1fr; 
        gap: 1rem; 
        margin-bottom: 1.5rem; 
        padding: 1.2rem; 
        background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
        border-radius: 10px; 
        border: 1px solid #dbeafe;
    }

    @@media (max-width: 768px) {
        .item-search-filters {
            grid-template-columns: 1fr;
            gap: 0.8rem;
            padding: 1rem;
        }
    }
    
    .item-search-input, .item-filter-select { 
        padding: 0.75rem 1rem; 
        border: 2px solid #e5e7eb; 
        border-radius: 8px; 
        font-size: 0.88rem; 
        width: 100%; 
        box-sizing: border-box;
        transition: all 0.2s ease;
        background: #fff;
    }
    
    .item-search-input:focus, .item-filter-select:focus { 
        outline: none; 
        border-color: #3b82f6; 
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); 
        background: #ffffff;
    }
    
    .item-search-input::placeholder { 
        color: #9ca3af; 
    }

    /* ========== SUMMARY BOX ========== */
    .summary-box { 
        background: #f8faff; 
        border: 1px solid #dbeafe; 
        border-radius: 10px; 
        padding: 1rem; 
        margin-top: 1rem;
    }
    
    .summary-row { 
        display: flex; 
        justify-content: space-between; 
        padding: .4rem 0;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    
    .summary-label { 
        font-weight: 600; 
        color: #374151; 
    }
    
    .summary-value { 
        font-size: 1.1rem; 
        font-weight: 700; 
        color: #1e40af; 
    }

    @@media (max-width: 768px) {
        .summary-box {
            padding: 0.8rem;
        }

        .summary-value {
            font-size: 1rem;
        }
    }

    /* ========== PAGE HEADER ========== */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .page-header h2 {
        margin: 0;
        font-size: 1.8rem;
    }

    .page-header p {
        margin: 0;
        color: #666;
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header h2 {
            font-size: 1.4rem;
        }
    }

    /* ========== CARD HEADER ========== */
    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    @@media (max-width: 768px) {
        .card-header-flex {
            flex-direction: column;
            align-items: stretch;
        }

        .card-header-flex button {
            width: 100%;
        }
    }
</style>

<div class="sa-wrapper">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2>📦 Stock Adjustment</h2>
            <p>Add existing inventory without purchase invoice</p>
        </div>
        <a href="/StockAdjustment/Index" class="btn btn-outline-secondary">← Back to List</a>
    </div>

    <!-- Header Info -->
    <div class="sa-card">
        <div class="sa-grid-4">
            <div class="sa-fg">
                <label>Adjustment No</label>
                <input class="sa-input" id="adjustmentNo" readonly>
            </div>
            <div class="sa-fg">
                <label>Date</label>
                <input type="date" class="sa-input" id="adjustmentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
            <div class="sa-fg">
                <label>Adjustment Type</label>
                <select class="sa-input" id="adjustmentType">
                    <option value="Opening Stock">Opening Stock</option>
                    <option value="Physical Count">Physical Count</option>
                    <option value="Correction">Correction</option>
                    <option value="Manual Addition">Manual Addition</option>
                </select>
            </div>
            @* <div class="sa-fg">
                <label>Branch</label>
                <select class="sa-input" id="branchId">
                    <option value="1">Main Branch</option>
                    <option value="2">Branch 2</option>
                </select>
            </div> *@
        </div>
    </div>

    <!-- Items Table -->
    <div class="sa-card">
        <div class="card-header-flex">
            <span class="sa-section-title">📋 Adjustment Items</span>
            <button type="button" class="btn-add-item" onclick="openItemModal()">➕ Add Item</button>
        </div>

        <div class="table-responsive">
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th style="width: 70px;">Item ID</th>
                        <th style="width: 250px;">Item Name</th>
                        <th style="width: 150px;">Description</th>
                        <th style="width: 120px;">Current Stock</th>
                        <th style="width: 120px;">Quantity to Add</th>
                        <th style="width: 120px;">Unit Cost</th>
                        <th style="width: 120px;">Total Cost</th>
                        <th style="width: 180px;">Reason</th>
                        <th style="width: 50px;"></th>
                    </tr>
                </thead>
                <tbody id="itemsTableBody">
                    <tr>
                        <td colspan="10" style="text-align: center; padding: 2rem; color: #6b7280;">
                            No items added yet. Click "Add Item" to start.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="summary-box">
            <div class="summary-row">
                <span class="summary-label">Total Items:</span>
                <span class="summary-value" id="totalItems">0</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Total Quantity:</span>
                <span class="summary-value" id="totalQuantity">0</span>
            </div>
            <div class="summary-row" style="border-top: 2px solid #bfdbfe; margin-top: .5rem; padding-top: .5rem;">
                <span class="summary-label">Total Cost:</span>
                <span class="summary-value" id="totalCost">0.00</span>
            </div>
        </div>
    </div>

    <!-- Remarks -->
    <div class="sa-card">
        <div class="sa-fg">
            <label>Remarks / Notes</label>
            <textarea class="sa-input" id="remarks" rows="3" placeholder="Enter any additional notes or remarks..."></textarea>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="sa-action-bar">
        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">🔄 Reset</button>
        <button type="button" class="btn btn-primary" onclick="saveDraft()">💾 Save as Draft</button>
        <button type="button" class="btn btn-success" onclick="saveAndPost()">✅ Save & Post to Stock</button>
    </div>
</div>

<!-- Item Selection Modal -->
<div class="item-modal" id="itemModal">
    <div class="item-modal-dialog">
        <div class="item-modal-header">
            <h3 class="item-modal-title">🔍 Select Item</h3>
            <button class="item-modal-close" onclick="closeItemModal()">&times;</button>
        </div>
        <div class="item-modal-body">
            <div class="item-search-filters">
                <input type="text" class="item-search-input" id="itemSearch" 
                       placeholder="🔍 Search by item name..." oninput="searchItems()">
                <select class="item-filter-select" id="categoryFilter" onchange="searchItems()">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="table-responsive">
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Item ID</th>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Sale Price</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="itemSearchResults">
                        <tr><td colspan="6" style="text-align: center; padding: 2rem;">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/stockadjustment.js"></script>
}