@model InventorySystem.Models.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<link href="~/css/dashboard.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<main class="main-content">
    <div class="page-header">
        <h2>📊 Dashboard</h2>
        <div class="breadcrumb">
            <span>Home</span><span>›</span><span>Dashboard</span>
        </div>
    </div>

    <!-- ── STAT CARDS ──────────────────────────────────────────────────── -->
    <div class="stats-grid">

        <div class="stat-card success">
            <div class="stat-header">
                <span class="stat-label">Total Sales Today</span>
                <span class="stat-icon">💵</span>
            </div>
            <div class="stat-value">@Model.TodaySales.ToString("N0")</div>
            <div class="stat-change @(Model.SalesChangePercent >= 0 ? "positive" : "negative")">
                @(Model.SalesChangePercent >= 0 ? "↑" : "↓") @Math.Abs(Model.SalesChangePercent)% from yesterday
            </div>
        </div>

        <div class="stat-card info">
            <div class="stat-header">
                <span class="stat-label">Total Purchases Today</span>
                <span class="stat-icon">📦</span>
            </div>
            <div class="stat-value">@Model.TodayPurchases.ToString("N0")</div>
            <div class="stat-change @(Model.PurchaseChangePercent >= 0 ? "positive" : "negative")">
                @(Model.PurchaseChangePercent >= 0 ? "↑" : "↓") @Math.Abs(Model.PurchaseChangePercent)% from last week
            </div>
        </div>

        <div class="stat-card warning">
            <div class="stat-header">
                <span class="stat-label">Inventory Items</span>
                <span class="stat-icon">🏷️</span>
            </div>
            <div class="stat-value">@Model.TotalItems.ToString("N0")</div>
            <div class="stat-change">⚠️ @Model.LowStockCount items low stock</div>
        </div>

        <div class="stat-card danger">
            <div class="stat-header">
                <span class="stat-label">Pending / Active Orders</span>
                <span class="stat-icon">⏳</span>
            </div>
            <div class="stat-value">@Model.PendingOrders</div>
            <div class="stat-change negative">@Model.YesterdayPendingOrders new yesterday</div>
        </div>

    </div>

    <!-- ── QUICK ACTIONS ───────────────────────────────────────────────── -->
    <div class="card">
        <div class="card-header"><h3 class="card-title">Quick Actions</h3></div>
        <div class="quick-actions">
            <a href="/Sale/Index" class="quick-action-btn">
                <div class="quick-action-icon">🛒</div>
                <div class="quick-action-label">New Sale</div>
            </a>
            <a href="/Purchase/Index" class="quick-action-btn">
                <div class="quick-action-icon">📥</div>
                <div class="quick-action-label">New Purchase</div>
            </a>
            <a href="/Item/Index" class="quick-action-btn">
                <div class="quick-action-icon">➕</div>
                <div class="quick-action-label">Add Item</div>
            </a>
            <a href="/Parties/Index" class="quick-action-btn">
                <div class="quick-action-icon">👥</div>
                <div class="quick-action-label">Parties</div>
            </a>
            <a href="/Report/StockReport" class="quick-action-btn">
                <div class="quick-action-icon">📊</div>
                <div class="quick-action-label">Reports</div>
            </a>
            <a href="/StockAdjustment/Create" class="quick-action-btn">
                <div class="quick-action-icon">📦</div>
                <div class="quick-action-label">Stock Adjust</div>
            </a>
            <a href="/Production/Create" class="quick-action-btn">
                <div class="quick-action-icon">🏭</div>
                <div class="quick-action-label">New Order</div>
            </a>
            <a href="/Accounts/PaymentVoucher" class="quick-action-btn">
                <div class="quick-action-icon">💳</div>
                <div class="quick-action-label">Payment</div>
            </a>
        </div>
    </div>

    <!-- ── CHARTS ROW ──────────────────────────────────────────────────── -->
    <div class="dashboard-grid">

        <div class="chart-card">
            <div class="card-header">
                <h3 class="card-title">📈 Sales & Purchases (Last 7 Days)</h3>
            </div>
            <canvas id="salesChart" height="120"></canvas>
        </div>

        <!-- Recent Activity -->
        <div class="chart-card">
            <div class="card-header">
                <h3 class="card-title">🕐 Recent Activity</h3>
            </div>
            <ul class="activity-list">
                @if (!Model.RecentActivities.Any())
                {
                    <li class="activity-item"><div class="activity-content"><div class="activity-title">No recent activity</div></div></li>
                }
                @foreach (var a in Model.RecentActivities)
                {
                    <li class="activity-item">
                        <div class="activity-icon">@a.Icon</div>
                        <div class="activity-content">
                            <div class="activity-title">@a.Title</div>
                            <div class="activity-time">@a.Time</div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- ── TOP SELLING ITEMS ───────────────────────────────────────────── -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">🏆 Top Selling Items — This Month</h3>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item ID</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Qty Sold</th>
                        <th>Revenue</th>
                        <th>Stock</th>
                        <th>Stock Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TopSellingItems.Any())
                    {
                        <tr><td colspan="7" style="text-align:center">No sales data this month</td></tr>
                    }
                    @foreach (var item in Model.TopSellingItems)
                    {
                        <tr>
                            <td>@item.ItemId</td>
                            <td>@item.ItemName</td>
                            <td>@item.Category</td>
                            <td>@item.QuantitySold.ToString("N0")</td>
                            <td>@item.Revenue.ToString("N2")</td>
                            <td>@item.CurrentStock.ToString("N0")</td>
                            <td>
                                @if (item.CurrentStock <= 10)
                                {
                                    <span style="color:red;font-weight:600">⚠️ Low</span>
                                }
                                else
                                {
                                    <span style="color:green;font-weight:600">✅ OK</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── BOTTOM GRID: Low Stock + Top Customers + Top Suppliers ─────── -->
    <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">

        <!-- Low Stock Alerts -->
        <div class="chart-card">
            <div class="card-header">
                <h3 class="card-title">⚠️ Low Stock Alerts</h3>
            </div>
            <table class="data-table">
                <thead><tr><th>Item</th><th>Category</th><th>Stock</th></tr></thead>
                <tbody>
                    @if (!Model.LowStockAlerts.Any())
                    {
                        <tr><td colspan="3" style="text-align:center">✅ All items have sufficient stock</td></tr>
                    }
                    @foreach (var s in Model.LowStockAlerts)
                    {
                        <tr>
                            <td>@s.ItemName</td>
                            <td>@s.Category</td>
                            <td style="color:red;font-weight:600">@s.CurrentStock.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Top Customers -->
        <div class="chart-card">
            <div class="card-header">
                <h3 class="card-title">👑 Top Customers — This Month</h3>
            </div>
            <table class="data-table">
                <thead><tr><th>Customer</th><th>Invoices</th><th>Total</th></tr></thead>
                <tbody>
                    @if (!Model.TopCustomers.Any())
                    {
                        <tr><td colspan="3" style="text-align:center">No customer data</td></tr>
                    }
                    @foreach (var c in Model.TopCustomers)
                    {
                        <tr>
                            <td>@c.PartyName</td>
                            <td>@c.TotalInvoices</td>
                            <td>@c.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Top Suppliers -->
        <div class="chart-card">
            <div class="card-header">
                <h3 class="card-title">🏢 Top Suppliers — This Month</h3>
            </div>
            <table class="data-table">
                <thead><tr><th>Supplier</th><th>Invoices</th><th>Total</th></tr></thead>
                <tbody>
                    @if (!Model.TopSuppliers.Any())
                    {
                        <tr><td colspan="3" style="text-align:center">No supplier data</td></tr>
                    }
                    @foreach (var s in Model.TopSuppliers)
                    {
                        <tr>
                            <td>@s.PartyName</td>
                            <td>@s.TotalInvoices</td>
                            <td>@s.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</main>

<!-- ── CHART.JS SCRIPT ─────────────────────────────────────────────────── -->
<script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
    const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartSalesData));
    const purchaseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartPurchaseData));

    const ctx = document.getElementById('salesChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Sales',
                    data: salesData,
                    backgroundColor: 'rgba(34, 197, 94, 0.7)',
                    borderColor: 'rgba(34, 197, 94, 1)',
                    borderWidth: 2,
                    borderRadius: 6,
                },
                {
                    label: 'Purchases',
                    data: purchaseData,
                    backgroundColor: 'rgba(59, 130, 246, 0.7)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 2,
                    borderRadius: 6,
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'top' },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.dataset.label + ': ' + Number(ctx.raw).toLocaleString()
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: val => Number(val).toLocaleString()
                    }
                }
            }
        }
    });
</script>
