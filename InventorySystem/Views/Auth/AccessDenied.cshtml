@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 140px);">
    <div style="text-align: center; max-width: 500px; padding: 2rem;">
        <!-- Icon -->
        <div style="font-size: 5rem; margin-bottom: 1.5rem; opacity: 0.8;">
            🔒
        </div>

        <!-- Title -->
        <h1 style="font-size: 2.2rem; color: var(--text-primary); margin-bottom: 0.5rem; font-weight: 700;">
            Access Denied
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 2rem; line-height: 1.6;">
            You don't have permission to access this resource. <br>
            Please contact your system administrator if you believe this is an error.
        </p>

        <!-- Details Box -->
        <div style="background: rgba(220, 53, 69, 0.05); border: 2px solid rgba(220, 53, 69, 0.2); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 2rem; text-align: left;">
            <div style="display: flex; gap: 0.8rem; margin-bottom: 1rem;">
                <span style="font-size: 1.5rem;">⚠️</span>
                <div>
                    <strong style="color: var(--text-primary); display: block;">Permission Required</strong>
                    <p style="margin: 0.3rem 0 0 0; color: var(--text-secondary); font-size: 0.95rem;">
                        Your account does not have the required permissions to view this page.
                    </p>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; gap: 1rem; justify-content: center; margin-bottom: 2rem;">
            <a href="javascript:history.back()" class="admin-btn admin-btn-secondary" style="padding: 0.6rem 1.5rem;">
                ← Go Back
            </a>
            <a asp-controller="Home" asp-action="Index" class="admin-btn admin-btn-primary" style="padding: 0.6rem 1.5rem;">
                🏠 Home
            </a>
        </div>

        <!-- Help Text -->
        <div style="padding: 1rem; background: #f8fafc; border-radius: var(--radius-sm); border-left: 4px solid var(--primary-color);">
            <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary);">
                💡 <strong>Need Help?</strong> Contact your administrator to request the required permissions.
            </p>
        </div>

        <!-- Footer Info -->
        <p style="margin-top: 2rem; font-size: 0.85rem; color: var(--text-secondary);">
            Error Code: <code style="background: #f8fafc; padding: 0.2rem 0.5rem; border-radius: 4px;">403 Forbidden</code>
        </p>
    </div>
</div>

<style>
    /* Responsive design */
    @@media (max-width: 768px) {
        div {
            padding: 1rem !important;
        }

        h1 {
            font-size: 1.8rem !important;
        }

        p {
            font-size: 1rem !important;
        }

        .admin-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>