@model IEnumerable<dynamic>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cost Sheet List";
}

<link href="~/css/report.css" rel="stylesheet" asp-append-version="true" />
<style>
    .cs-index-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; }
    .cs-table { width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 6px rgba(0,0,0,.08); }
    .cs-table thead tr { background:#1e3a5f; color:#fff; }
    .cs-table th, .cs-table td { padding:.75rem 1rem; font-size:.875rem; text-align:left; border-bottom:1px solid #f0f0f0; }
    .cs-table tbody tr:hover { background:#f8faff; }
    .badge-draft  { background:#fff3cd; color:#856404; padding:.2rem .6rem; border-radius:20px; font-size:.75rem; font-weight:600; }
    .badge-final  { background:#d1fae5; color:#065f46; padding:.2rem .6rem; border-radius:20px; font-size:.75rem; font-weight:600; }
    .cs-actions   { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; }
    .btn-sm       { display:inline-block; padding:.35rem .75rem; border-radius:6px; font-size:.78rem; font-weight:600;
                    border:none; cursor:pointer; text-decoration:none; line-height:1.2; white-space:nowrap; }
    .btn-edit     { background:#3b82f6; color:#fff; }
    .btn-print    { background:#0f172a; color:#fff; }
    .btn-delete   { background:#ef4444; color:#fff; }
    .btn-produce  { background:#16a34a; color:#fff; }
</style>

<!-- Add this top section for info and actions -->
<div class="cs-index-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
    <div>
        <h2>📋 Cost Sheet List</h2>
        <p style="color:#666; margin:0;">Reusable product recipes. Select the customer and agreed price on each production order.</p>
    </div>
    <div style="display:flex; gap:0.75rem;">
        <a href="/CostSheet/Create" class="btn btn-primary">
            ➕ Create Cost Sheet
        </a>
    </div>
</div>

<div class="responsive-list-scroll" role="region" aria-label="Cost sheets" tabindex="0"><table class="cs-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Sheet No</th>
            <th>Date</th>
            <th>Item / Product</th>
            <th>Box Style</th>
            <th style="text-align:right">Final Cost (W/O GST)</th>
            <th style="text-align:right">Final Rate (W/ GST)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            foreach (var s in Model)
            {
                <tr>
                    <td>@i</td>
                    <td><strong>#@s.CostSheetId</strong></td>
                    <td>@(s.SheetDate != null ? ((DateTime)s.SheetDate).ToString("dd-MMM-yyyy") : "–")</td>
                    <td>@(s.ItemName ?? "–")</td>
                    <td>@(s.BoxStyle ?? "–")</td>
                    <td style="text-align:right;"><strong>@(s.FinalCostWOGST != null ? ((decimal)s.FinalCostWOGST).ToString("N2") : "–")</strong></td>
                    <td style="text-align:right;"><strong>@(s.FinalRateWithGST != null ? ((decimal)s.FinalRateWithGST).ToString("N2") : "–")</strong></td>
                    <td>
                        @if (s.Status == "Final")
                        { <span class="badge-final">✅ Final</span> }
                        else
                        { <span class="badge-draft">✏️ Draft</span> }
                    </td>
                    <td>
                        <div class="am">
                            @if (s.Status != "Final")
                            {
                                <button class="btn-sm btn-produce" onclick="markFinal(@s.CostSheetId)">✅ Mark as Final</button>
                            }
                            else
                            {
                                <a href="/Production/Create?costSheetId=@s.CostSheetId" class="btn-sm btn-produce">🏭 Produce</a>
                            }
                            <button type="button" class="am-toggle" aria-haspopup="menu" aria-expanded="false" title="More actions">&#8943;</button>
                            <div class="am-menu" role="menu">
                                @if (ViewBag.CanEditSheets == true) { <a href="/CostSheet/Edit/@s.CostSheetId">✏️ Edit</a> }
                                <a href="/CostSheet/Print/@s.CostSheetId" target="_blank" rel="noopener">🖨 Print</a>
                                <hr>
                                <button class="am-danger" onclick="deleteSheet(@s.CostSheetId)">🗑️ Delete</button>
                            </div>
                        </div>
                    </td>
                </tr>
                i++;
            }
        }
        @if (!Model.Any())
        {
            <partial name="_ListEmptyState" model='new InventorySystem.Models.ListEmptyState(9, "No cost sheets yet", "Create a cost sheet to estimate material requirements and pricing for your product.", "+ Create Cost Sheet", "/CostSheet/Create")' />
        }
    </tbody>
</table></div>

<script>
async function markFinal(id) {
    if (!(await confirmDialog('Mark this cost sheet as Final? It can then be used in Production.'))) return;
    fetch(`/CostSheet/MarkFinal/${id}`, { method: 'POST' })
        .then(r => r.json())
        .then(async d => { if (d.success) location.reload(); else await alertDialog('❌ ' + (d.message || 'Could not mark Final.')); })
        .catch(async () => await alertDialog('❌ Error marking cost sheet Final.'));
}

async function deleteSheet(id) {
    if (!(await confirmDialog('Delete this cost sheet? This cannot be undone.', { danger: true }))) return;
    fetch(`/CostSheet/Delete/${id}`, { method: 'POST' })
        .then(r => r.json())
        .then(async d => { if (d.success) location.reload(); else await alertDialog('❌ Could not delete.'); })
        .catch(async () => await alertDialog('❌ Error deleting cost sheet.'));
}
</script>
