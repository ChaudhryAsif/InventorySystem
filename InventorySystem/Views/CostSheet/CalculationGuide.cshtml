@model InventorySystem.Core.Models.CostSheetSettings
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cost Sheet Calculation Guide - Complete Documentation";
}

<link href="~/css/calculationguide.css" rel="stylesheet" />

<div class="guide-wrapper">

    <!-- HERO SECTION -->
    <div class="hero-section">
        <h1>💼 Cost Sheet Calculation Guide</h1>
        <p>Complete documentation on how cost sheets are calculated step-by-step</p>
        <span class="hero-tag">📚 Educational Material for Clients & Team Members</span>
    </div>

    <!-- NAVIGATION -->
    <div class="guide-nav no-print">
        <h3>📑 Quick Navigation</h3>
        <div class="nav-links">
            <a href="#section-1" class="nav-link">📐 Dimensions</a>
            <a href="#section-2" class="nav-link">📦 Materials</a>
            <a href="#section-3" class="nav-link">⚙️ Variable Costs</a>
            <a href="#section-4" class="nav-link">🏭 Overhead</a>
            <a href="#section-5" class="nav-link">💼 Commission</a>
            <a href="#section-6" class="nav-link">💵 Final Price</a>
            <a href="#section-7" class="nav-link">📊 Summary</a>
        </div>
    </div>

    <!-- SECTION 1: DIMENSIONS -->
    <div class="section variant-1" id="section-1">
        <div class="section-header">
            <div class="section-number">1</div>
            <div class="section-title">
                <h2>📐 Box Dimensions & Sheet Calculation</h2>
                <p>Converting box dimensions to printable sheet dimensions</p>
            </div>
        </div>

        <p style="color: #4b5563; margin-bottom: 1.5rem;">
            The first step is to convert the carton/box dimensions into the actual sheet size needed for printing and manufacturing.
            This involves understanding the box structure and accounting for waste allowances.
        </p>

        <div class="content-grid">
            <div class="content-box">
                <h4>Input Parameters</h4>
                <p>
                    <strong>Length (L):</strong> Box length in mm<br>
                    <strong>Width (W):</strong> Box width in mm<br>
                    <strong>Height (H):</strong> Box height in mm<br>
                    <strong>Flap:</strong> Additional flap length
                </p>
            </div>
            <div class="content-box">
                <h4>What Happens</h4>
                <p>
                    The system calculates how much paper is needed to create one box unit. It accounts for all the panels (front, back, sides) plus flaps for closing.
                </p>
            </div>
            <div class="content-box">
                <h4>Why It Matters</h4>
                <p>
                    Sheet dimensions determine material quantity, which directly affects your cost. Precise calculations prevent waste and ensure profitability.
                </p>
            </div>
        </div>

        <div class="formula-section">
            <div class="formula-title">📐 Dimension Formulas</div>

            <div class="formula-box">
                <strong>Sheet Width (inches):</strong><br>
                <code>SheetWidth(in) = (Height + Width + AutoFlapGap) ÷ 25.4</code>
                <div class="formula-note">Combines height and width panels in perpendicular direction</div>
            </div>

            <div class="formula-box">
                <strong>Sheet Length (inches):</strong><br>
                <code>SheetLength(in) = (2×Length + 2×Width + 2×Flap) ÷ 25.4</code>
                <div class="formula-note">Accounts for front, back, and two side panels plus flap areas</div>
            </div>

            <div class="formula-box">
                <strong>Total Sheet Area (Square Inches):</strong><br>
                <code>TotalSheetArea = AdjustedWidth(in) × AdjustedLength(in)</code>
                <div class="formula-note">Adjusted dimensions include 2mm width and 3mm length buffers for cutting tolerance</div>
            </div>
        </div>

        <div class="example-box">
            <h4>📝 Example Calculation</h4>
            <p>
                <strong>Input:</strong> Box dimensions 300L × 200W × 150H mm<br><br>
                <strong>Calculation:</strong><br>
                Sheet Width = (150 + 200 + 0) ÷ 25.4 = <code>13.78 inches</code><br>
                Sheet Length = (2×300 + 2×200 + 2×100) ÷ 25.4 = <code>44.09 inches</code><br>
                Total Area = 13.78 × 44.09 = <code>607.6 square inches</code>
            </p>
        </div>
    </div>

    <!-- SECTION 2: MATERIALS -->
    <div class="section variant-2" id="section-2">
        <div class="section-header">
            <div class="section-number">2</div>
            <div class="section-title">
                <h2>📦 Material & Paper Costs</h2>
                <p>Calculating the cost of raw materials needed for production</p>
            </div>
        </div>

        <p style="color: #4b5563; margin-bottom: 1.5rem;">
            Materials are the foundation of your cost. This includes paper ply layers, glue, lamination, and printing. Each material has a rate per kilogram.
        </p>

        <div class="info-box">
            <p>
                <strong>💡 Key Concept:</strong> Each ply (paper layer) is a separate line item. For example, a 3-ply carton needs rates for kraft paper, liner, and medium flute.
            </p>
        </div>

        <div class="formula-section">
            <div class="formula-title">📦 Material Cost Formulas</div>

            <div class="formula-box">
                <strong>Ply Cost (for each layer):</strong><br>
                <code>PlyCost = Rate/KG × KG Used</code>
                <div class="formula-note">Each ply layer is multiplied: rate per kilogram × actual kilograms used</div>
            </div>

            <div class="formula-box">
                <strong>Total Ply Cost:</strong><br>
                <code>TotalPlyCost = Σ(Ply1 + Ply2 + Ply3 + ...)</code>
                <div class="formula-note">Sum of all ply layers in the carton</div>
            </div>

            <div class="formula-box">
                <strong>Glue & Silicate Cost:</strong><br>
                <code>GlueSilicateCost = GlueSilicateKG × (GlueRate + SilicateRate)</code>
                <div class="formula-note">Combined rate of glue and silicate powder per kilogram</div>
            </div>

            <div class="formula-box">
                <strong>Total Paper Cost:</strong><br>
                <code>PaperCost = ΣPlies + GlueSilicate + Lamination + Dickel + Printing</code>
                <div class="formula-note">All material components combined</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="content-box">
                <h4>🧻 Paper Plies</h4>
                <p>Kraft, Liner, Flute - each ply has its own rate based on GSM and quality. Rates come from your last purchase invoices.</p>
            </div>
            <div class="content-box">
                <h4>💧 Glue & Silicate</h4>
                <p>Used for lamination and correction. Fixed rates per kilogram based on your supplier prices.</p>
            </div>
            <div class="content-box">
                <h4>✨ Lamination</h4>
                <p>Optional protective coating. If applied, adds fixed cost per unit (or calculated per square inch).</p>
            </div>
            <div class="content-box">
                <h4>🎨 Printing</h4>
                <p>Color printing costs based on number of colors and printing area. Fixed cost per unit.</p>
            </div>
        </div>

        <div class="example-box">
            <h4>📝 Example Material Calculation</h4>
            <p>
                <strong>Ply Breakdown:</strong><br>
                • Kraft Paper: 150 KG ₹40/KG = <code>₹6,000</code><br>
                • Liner Paper: 100 KG  ₹35/KG = <code>₹3,500</code><br>
                • Flute: 50 KG  ₹30/KG = <code>₹1,500</code><br>
                <strong>Subtotal Plies:</strong> <code>₹11,000</code><br><br>
                <strong>Additional:</strong><br>
                • Glue: 5 KG (₹150+₹50)/KG = <code>₹1,000</code><br>
                • Printing (4 color): <code>₹500</code><br><br>
                <strong>Total Paper Cost: ₹12,500</strong>
            </p>
        </div>
    </div>

    <!-- SECTION 3: VARIABLE COSTS -->
    <div class="section variant-3" id="section-3">
        <div class="section-header">
            <div class="section-number">3</div>
            <div class="section-title">
                <h2>⚙️ Variable / Weight-Based Costs</h2>
                <p>Costs that scale based on material weight</p>
            </div>
        </div>

        <p style="color: #4b5563; margin-bottom: 1.5rem;">
            Production requires labor, energy, and transport. These are calculated per kilogram of material, making them variable costs.
        </p>

        <div class="step-flow">
            <div class="step-item input">
                <div class="step-label">INPUT</div>
                <div class="step-content">Total Weight (KG)</div>
            </div>
            <div class="step-arrow">→</div>
            <div class="step-item process">
                <div class="step-label">PROCESS</div>
                <div class="step-content">Multiply by Rate/KG</div>
            </div>
            <div class="step-arrow">→</div>
            <div class="step-item output">
                <div class="step-label">OUTPUT</div>
                <div class="step-content">Total Cost</div>
            </div>
        </div>

        <div class="formula-section">
            <div class="formula-title">⚙️ Variable Cost Formulas</div>

            <div class="formula-box">
                <strong>Labour Cost:</strong><br>
                <code>LabourCost = LabourRate × Total Weight (KG)</code>
                <div class="formula-note">Default: @Model?.LabourRate per KG</div>
            </div>

            <div class="formula-box">
                <strong>Energy Cost:</strong><br>
                <code>EnergyCost = EnergyRate × Total Weight (KG)</code>
                <div class="formula-note">Default: @Model?.EnergyRate per KG (includes utilities, power, fuel)</div>
            </div>

            <div class="formula-box">
                <strong>Freight Cost:</strong><br>
                <code>FreightCost = FreightRate × Total Weight (KG)</code>
                <div class="formula-note">Default: @Model?.DefaultFreightRate per KG</div>
            </div>

            <div class="formula-box">
                <strong>Binding Cost:</strong><br>
                <code>If Type = "Pins": Cost = Number of Pins × 0.05<br>
                If Type = "Stitching": Cost = Manual Entry<br>
                If Type = "None": Cost = 0</code>
                <div class="formula-note">Fixed cost based on binding method</div>
            </div>

            <div class="formula-box">
                <strong>Sub-Total:</strong><br>
                <code>SubTotal = PaperCost + LabourCost + EnergyCost + BindingCost + FreightCost</code>
                <div class="formula-note">This is your base production cost before overhead</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="content-box">
                <h4>👷 Labour</h4>
                <p>Includes machine operators, supervisors, and manual workers involved in production and packing.</p>
            </div>
            <div class="content-box">
                <h4>⚡ Energy</h4>
                <p>Electricity, fuel, compressed air, and utilities consumed during manufacturing process.</p>
            </div>
            <div class="content-box">
                <h4>📦 Freight</h4>
                <p>Transportation cost from factory to customer, calculated per kilogram of finished product.</p>
            </div>
            <div class="content-box">
                <h4>🔗 Binding</h4>
                <p>Cost of binding method - pins, stitching, tape, or glue based on carton type and customer requirement.</p>
            </div>
        </div>

        <div class="example-box">
            <h4>📝 Example Variable Cost Calculation</h4>
            <p>
                <strong>Given:</strong> Total weight = 250 KG<br><br>
                <strong>Calculation:</strong><br>
                Labour: 250 KG × @Model?.LabourRate = <code>₹@(250m * (Model?.LabourRate ?? 0m))</code><br>
                Energy: 250 KG × @Model?.EnergyRate = <code>₹@(250m * (Model?.EnergyRate ?? 0m))</code><br>
                Freight: 250 KG × @Model?.DefaultFreightRate = <code>₹@(250m * (Model?.DefaultFreightRate ?? 0m))</code><br>
                Binding (Stitching): <code>₹50</code><br><br>
                <strong>Sub-Total = ₹@(250m * (Model?.LabourRate ?? 0m) + 250m * (Model?.EnergyRate ?? 0m) + 250m * (Model?.DefaultFreightRate ?? 0m) + 50m)</strong>
            </p>
        </div>
    </div>

    <!-- SECTION 4: OVERHEAD -->
    <div class="section variant-4" id="section-4">
        <div class="section-header">
            <div class="section-number">4</div>
            <div class="section-title">
                <h2>🏭 Overhead Allocation</h2>
                <p>Distributing indirect costs proportionally across production</p>
            </div>
        </div>

        <p style="color: #4b5563; margin-bottom: 1.5rem;">
            Overhead costs are indirect expenses that support production but aren't directly traceable to a single unit. They're calculated as percentages of the sub-total.
        </p>

        <div class="info-box">
            <p>
                <strong>💡 Key Concept:</strong> Overhead allocation ensures that every product bears its fair share of facility costs, management, waste, etc.
            </p>
        </div>

        <div class="formula-section">
            <div class="formula-title">🏭 Overhead Formula</div>

            <div class="formula-box">
                <strong>Base Formula:</strong><br>
                <code>OverheadItem = SubTotal × (Percentage ÷ 100)</code>
                <div class="formula-note">Apply this formula to each overhead item using the configured percentage</div>
            </div>
        </div>

        <div style="margin: 1.5rem 0;">
            <table class="calc-table">
                <thead>
                    <tr>
                        <th>Overhead Item</th>
                        <th>Purpose</th>
                        <th class="percentage">Default %</th>
                        <th>Formula</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Waste Allowance</strong></td>
                        <td>Material spoilage during production</td>
                        <td class="percentage">@Model?.WastePercentage%</td>
                        <td>SubTotal × @Model?.WastePercentage%</td>
                    </tr>
                    <tr>
                        <td><strong>Admin Expense</strong></td>
                        <td>Office staff, utilities, rent allocation</td>
                        <td class="percentage">@Model?.AdminExpPercentage%</td>
                        <td>SubTotal × @Model?.AdminExpPercentage%</td>
                    </tr>
                    <tr>
                        <td><strong>Selling & Distribution</strong></td>
                        <td>Sales team, marketing, distribution</td>
                        <td class="percentage">@Model?.SellingDistPercentage%</td>
                        <td>SubTotal × @Model?.SellingDistPercentage%</td>
                    </tr>
                    <tr>
                        <td><strong>Repair & Maintenance</strong></td>
                        <td>Equipment maintenance and repairs</td>
                        <td class="percentage">@Model?.RepairMaintenancePercentage%</td>
                        <td>SubTotal × @Model?.RepairMaintenancePercentage%</td>
                    </tr>
                    <tr>
                        <td><strong>Store & Spares</strong></td>
                        <td>Spare parts inventory</td>
                        <td class="percentage">@Model?.StoreSparesPercentage%</td>
                        <td>SubTotal × @Model?.StoreSparesPercentage%</td>
                    </tr>
                    <tr>
                        <td><strong>Manufacturing Overhead</strong></td>
                        <td>General factory overhead</td>
                        <td class="percentage">@Model?.ManufacturingCostPercentage%</td>
                        <td>SubTotal × @Model?.ManufacturingCostPercentage%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="formula-section">
            <div class="formula-title">📌 Total Manufacturing Cost</div>

            <div class="formula-box">
                <code>ManufacturingTotal = SubTotal + (Sum of All Overhead Items)</code>
                <div class="formula-note">This represents your complete in-house cost</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="content-box">
                <h4>📊 Why Percentages?</h4>
                <p>Overhead costs grow with production volume. A 6% waste allowance on a heavy box differs from a light box, making it fair and proportional.</p>
            </div>
            <div class="content-box">
                <h4>🔧 Customizable</h4>
                <p>Each percentage can be adjusted in Settings to match your actual business operations and cost structure.</p>
            </div>
            <div class="content-box">
                <h4>💰 Impact</h4>
                <p>Overhead typically adds 8-10% to your manufacturing cost. It's crucial for long-term sustainability.</p>
            </div>
        </div>

        <div class="example-box">
            <h4>📝 Example Overhead Calculation</h4>
            <p>
                <strong>Given SubTotal: ₹12,945</strong><br><br>
                <strong>Overhead Breakdown:</strong><br>
                • Waste (@Model?.WastePercentage%): ₹12,945 × @Model?.WastePercentage% = <code>₹@(12945m * ((Model?.WastePercentage ?? 0m) / 100m))</code><br>
                • Admin (@Model?.AdminExpPercentage%): ₹12,945 × @Model?.AdminExpPercentage% = <code>₹@(12945m * ((Model?.AdminExpPercentage ?? 0m) / 100m))</code><br>
                • Selling (@Model?.SellingDistPercentage%): ₹12,945 × @Model?.SellingDistPercentage% = <code>₹@(12945m * ((Model?.SellingDistPercentage ?? 0m) / 100m))</code><br>
                • Repair (@Model?.RepairMaintenancePercentage%): ₹12,945 × @Model?.RepairMaintenancePercentage% = <code>₹@(12945m * ((Model?.RepairMaintenancePercentage ?? 0m) / 100m))</code><br>
                • Spares (@Model?.StoreSparesPercentage%): ₹12,945 × @Model?.StoreSparesPercentage% = <code>₹@(12945m * ((Model?.StoreSparesPercentage ?? 0m) / 100m))</code><br>
                • Mfg (@Model?.ManufacturingCostPercentage%): ₹12,945 × @Model?.ManufacturingCostPercentage% = <code>₹@(12945m * ((Model?.ManufacturingCostPercentage ?? 0m) / 100m))</code><br><br>
                <strong>Total Overhead: ₹@((12945m * ((Model?.WastePercentage ?? 0m) / 100m)) + (12945m * ((Model?.AdminExpPercentage ?? 0m) / 100m)) + (12945m * ((Model?.SellingDistPercentage ?? 0m) / 100m)) + (12945m * ((Model?.RepairMaintenancePercentage ?? 0m) / 100m)) + (12945m * ((Model?.StoreSparesPercentage ?? 0m) / 100m)) + (12945m * ((Model?.ManufacturingCostPercentage ?? 0m) / 100m)))</strong><br>
                <strong>Manufacturing Total: ₹@(12945m + ((12945m * ((Model?.WastePercentage ?? 0m) / 100m)) + (12945m * ((Model?.AdminExpPercentage ?? 0m) / 100m)) + (12945m * ((Model?.SellingDistPercentage ?? 0m) / 100m)) + (12945m * ((Model?.RepairMaintenancePercentage ?? 0m) / 100m)) + (12945m * ((Model?.StoreSparesPercentage ?? 0m) / 100m)) + (12945m * ((Model?.ManufacturingCostPercentage ?? 0m) / 100m))))</strong>
            </p>
        </div>
    </div>

    <!-- SECTION 5: COMMISSION -->
    <div class="section variant-5" id="section-5">
        <div class="section-header">
            <div class="section-number">5</div>
            <div class="section-title">
                <h2>💼 Commission & Profit</h2>
                <p>Sales incentives and profit margin calculation</p>
            </div>
        </div>

        <p style="color: #4b5563; margin-bottom: 1.5rem;">
            Commissions reward your sales team. Profit is your margin above all costs. Both are calculated as percentages of the manufacturing total.
        </p>

        <div class="formula-section">
            <div class="formula-title">💼 Commission Formula</div>

            <div class="formula-box">
                <strong>Commission (for each salesperson):</strong><br>
                <code>CommissionAmount = ManufacturingTotal × (CommissionPercentage ÷ 100)</code>
                <div class="formula-note">Can have multiple salespeople with different percentages</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="content-box">
                <h4>💰 Salesperson A</h4>
                <p>Main account handler - typically earns a percentage commission on manufacturing cost.</p>
            </div>
            <div class="content-box">
                <h4>💰 Salesperson B</h4>
                <p>Secondary contact or region manager - may earn additional percentage if applicable.</p>
            </div>
            <div class="content-box">
                <h4>🎯 Why Commission?</h4>
                <p>Motivates sales team to push high-volume orders and maintain client relationships.</p>
            </div>
        </div>

        <div class="formula-section">
            <div class="formula-title">📈 Profit Calculation</div>

            <div class="formula-box">
                <strong>Before Profit Total:</strong><br>
                <code>AfterCommission = ManufacturingTotal + CommissionA + CommissionB</code>
                <div class="formula-note">Manufacturing cost plus commissions</div>
            </div>

            <div class="formula-box">
                <strong>Profit Amount:</strong><br>
                <code>ProfitAmount = AfterCommission × (ProfitPercentage ÷ 100)</code>
                <div class="formula-note">Default: @Model?.DefaultProfitPct% profit margin</div>
            </div>

            <div class="formula-box">
                <strong>Withholding Tax:</strong><br>
                <code>WHT = AfterCommission × (WHTPercentage ÷ 100)</code>
                <div class="formula-note">Government tax compliance (typically 1-5%)</div>
            </div>
        </div>

        <div class="example-box">
            <h4>📝 Example Commission & Profit Calculation</h4>
            <p>
                <strong>Given Manufacturing Total: ₹14,659</strong><br><br>
                <strong>Commission:</strong><br>
                • Salesman A (5%): ₹14,659 × 5% = <code>₹732.95</code><br>
                • Salesman B (3%): ₹14,659 × 3% = <code>₹439.77</code><br>
                <strong>After Commission: ₹14,659 + ₹732.95 + ₹439.77 = ₹15,831.72</strong><br><br>
                <strong>Profit & Tax:</strong><br>
                • Profit (@Model?.DefaultProfitPct%): ₹15,831.72 × @Model?.DefaultProfitPct% = <code>₹@(15831.72m * ((Model?.DefaultProfitPct ?? 0m) / 100m))</code><br>
                • WHT (1%): ₹15,831.72 × 1% = <code>₹158.32</code><br><br>
                <strong>Cost before Tax: ₹@(15831.72m + (15831.72m * ((Model?.DefaultProfitPct ?? 0m) / 100m)) + 158.32m)</strong>
            </p>
        </div>
    </div>

    <!-- SECTION 6: FINAL PRICING -->
    <div class="section" id="section-6" style="border-top-color: #10b981;">
        <div class="section-header">
            <div class="section-number">6</div>
            <div class="section-title">
                <h2>💵 Final Rate & GST Calculation</h2>
                <p>Converting cost into customer quote price</p>
            </div>
        </div>

        <p style="color: #4b5563; margin-bottom: 1.5rem;">
            The final step is adding taxes to your cost to get the quoted price. This is what the customer pays.
        </p>

        <div class="flow-diagram">
            <div class="flow-container">
                <div class="flow-box output">
                    <span style="font-size: 0.8rem; font-weight: 700;">COST</span>
                    <span>Cost W/O GST</span>
                </div>
                <div class="flow-arrow">➕</div>
                <div class="flow-box calculation">
                    <span style="font-size: 0.8rem; font-weight: 700;">TAX</span>
                    <span>GST (18%)</span>
                </div>
                <div class="flow-arrow">➕</div>
                <div class="flow-box calculation">
                    <span style="font-size: 0.8rem; font-weight: 700;">TAX</span>
                    <span>Additional Tax</span>
                </div>
                <div class="flow-arrow">→</div>
                <div class="flow-box" style="background: #dcfce7; color: #15803d; border: 2px solid #10b981;">
                    <span style="font-size: 0.8rem; font-weight: 700;">CUSTOMER QUOTE</span>
                    <span>Final Rate with GST</span>
                </div>
            </div>
        </div>

        <div class="formula-section">
            <div class="formula-title">💵 Final Price Formulas</div>

            <div class="formula-box">
                <strong>Cost Without GST:</strong><br>
                <code>CostWOGST = AfterCommission + ProfitAmount + WHT</code>
                <div class="formula-note">Your minimum selling price before any tax</div>
            </div>

            <div class="formula-box">
                <strong>GST (Goods & Service Tax):</strong><br>
                <code>GSTAmount = CostWOGST × (GSTPct ÷ 100)</code>
                <div class="formula-note">Government tax, typically 18% in India</div>
            </div>

            <div class="formula-box">
                <strong>Additional Tax:</strong><br>
                <code>AdditionalTax = CostWOGST × (TaxPct ÷ 100)</code>
                <div class="formula-note">State or local tax if applicable</div>
            </div>

            <div class="formula-box">
                <strong>Final Quoted Rate (WITH GST):</strong><br>
                <code>FinalRate = CostWOGST + GST + AdditionalTax</code>
                <div class="formula-note">💰 THIS IS WHAT YOU QUOTE TO YOUR CUSTOMER</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="content-box">
                <h4>🧾 W/O GST Price</h4>
                <p>Your internal cost. This is used for cost accounting and internal reporting.</p>
            </div>
            <div class="content-box">
                <h4>📊 GST 18%</h4>
                <p>Government Goods & Service Tax. You collect this from customer and pay to government.</p>
            </div>
            <div class="content-box">
