@model InventorySystem.Core.Models.CostSheet
@{
    Layout = "_Layout";
    bool isEdit = Model != null && Model.CostSheetId > 0;
    ViewData["Title"] = isEdit ? "Edit Cost Sheet" : "Create Cost Sheet";
}

<link href="~/css/sale.css" rel="stylesheet" />
<style>
    /* ── Cost Sheet specific styles ────────────────────────────────────────── */
    .cs-wrapper        { max-width:1400px; margin:0 auto; }
    .cs-card           { background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,.08); padding:1.5rem; margin-bottom:1.2rem; }
    .cs-section-title  { font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em;
                         color:#fff; background:#1e3a5f; padding:.4rem .9rem; border-radius:6px;
                         margin-bottom:1rem; display:inline-block; }
    .cs-grid-2  { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .cs-grid-3  { display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem; }
    .cs-grid-4  { display:grid; grid-template-columns:repeat(4,1fr); gap:.75rem; }
    .cs-grid-5  { display:grid; grid-template-columns:repeat(5,1fr); gap:.75rem; }
    .cs-fg      { display:flex; flex-direction:column; gap:.3rem; }
    .cs-fg label{ font-size:.78rem; font-weight:600; color:#374151; }
    .cs-input   { padding:.45rem .7rem; border:1px solid #d1d5db; border-radius:7px; font-size:.87rem;
                  width:100%; box-sizing:border-box; }
    .cs-input:focus { outline:none; border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,.12); }
    .cs-input[readonly] { background:#f3f4f6; color:#6b7280; }
    .cs-input.calc      { background:#eff6ff; font-weight:600; color:#1e40af; }
    .cs-input.final     { background:#f0fdf4; font-weight:700; color:#065f46; font-size:1rem; }

    /* Ply table */
    .ply-table          { width:100%; border-collapse:collapse; font-size:.83rem; }
    .ply-table thead tr { background:#1e3a5f; color:#fff; }
    .ply-table th, .ply-table td { padding:.5rem .6rem; text-align:left; border-bottom:1px solid #e5e7eb; }
    .ply-table tbody tr:hover { background:#f8faff; }
    .ply-table .num     { text-align:right; }
    .ply-input  { padding:.3rem .5rem; border:1px solid #d1d5db; border-radius:5px; font-size:.82rem;
                  width:100%; box-sizing:border-box; }
    .ply-input.calc { background:#eff6ff; font-weight:600; color:#1e40af; }
    .btn-add-ply   { background:#059669; color:#fff; border:none; border-radius:7px; padding:.4rem 1rem;
                     font-size:.82rem; cursor:pointer; margin-top:.5rem; }
    .btn-remove-ply{ background:#ef4444; color:#fff; border:none; border-radius:5px; padding:.25rem .6rem;
                     font-size:.8rem; cursor:pointer; }

    /* Cost summary panel */
    .cost-panel       { background:#f8faff; border:1px solid #dbeafe; border-radius:10px; padding:1.2rem; }
    .cost-row         { display:flex; justify-content:space-between; align-items:center;
                        padding:.3rem 0; border-bottom:1px solid #e5e7eb; font-size:.85rem; }
    .cost-row:last-child { border-bottom:none; }
    .cost-label       { color:#374151; display:flex; align-items:center; gap:.5rem; }
    .cost-pct         { width:70px; padding:.25rem .4rem; border:1px solid #d1d5db; border-radius:5px;
                        font-size:.8rem; text-align:right; }
    .cost-val         { width:90px; padding:.25rem .4rem; border:1px solid #d1d5db; border-radius:5px;
                        font-size:.83rem; text-align:right; }
    .cost-val.calc    { background:#eff6ff; color:#1e40af; font-weight:600; }
    .cost-section-sep { background:#1e3a5f; color:#fff; font-size:.75rem; font-weight:700;
                        padding:.25rem .6rem; border-radius:4px; margin:.6rem 0 .3rem; }
    .final-box        { background:#1e3a5f; color:#fff; border-radius:10px; padding:1rem 1.5rem;
                        text-align:center; margin-top:.75rem; }
    .final-box .amount{ font-size:1.8rem; font-weight:700; letter-spacing:.02em; }
    .final-box .label { font-size:.8rem; opacity:.8; margin-bottom:.2rem; }

    /* Action bar */
    .cs-action-bar { display:flex; gap:.75rem; justify-content:flex-end; margin-top:1.2rem; }

    /* Item lookup modal styles */
    .item-modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.6); z-index:1000; }
    .item-modal-dialog { background:#fff; border-radius:8px; max-width:800px; margin:2rem auto; padding:1.5rem; position:relative; }
    .item-modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; }
    .item-modal-title { font-size:1.25rem; font-weight:600; }
    .item-modal-close { position:absolute; top:1rem; right:1rem; font-size:1.2rem; color:#666; cursor:pointer; }
    .item-modal-body { max-height:60vh; overflow-y:auto; }
    .item-modal-footer { display:flex; justify-content:flex-end; gap:.5rem; margin-top:1rem; }
    .item-search-filters { display:flex; gap:.5rem; margin-bottom:1rem; }
    .item-search-input { padding:.6rem .9rem; border:1px solid #d1d5db; border-radius:7px; font-size:.87rem;
                         width:100%; box-sizing:border-box; }
    .item-filter-select { padding:.6rem .9rem; border:1px solid #d1d5db; border-radius:7px; font-size:.87rem;
                         width:auto; min-width:120px; box-sizing:border-box; }
    .item-table { width:100%; border-collapse:collapse; font-size:.83rem; }
    .item-table thead tr { background:#1e3a5f; color:#fff; }
    .item-table th, .item-table td { padding:.5rem .6rem; text-align:left; border-bottom:1px solid #e5e7eb; }
    .item-table tbody tr:hover { background:#f8faff; }
    .item-empty-state { text-align:center; padding:.5rem 0; color:#666; }
    .item-empty-icon { font-size:2rem; margin-bottom:.5rem; }
    .btn-select-item { background:#059669; color:#fff; border:none; border-radius:7px; padding:.5rem 1rem;
                       font-size:.82rem; cursor:pointer; }

    @@media screen and (max-width:1024px) {
        .cs-grid-4, .cs-grid-5 { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .cs-dimensions, .cs-cost-columns { grid-template-columns:minmax(0,1fr) !important; }
    }
    @@media screen and (max-width:600px) {
        .cs-grid-2, .cs-grid-3, .cs-grid-4, .cs-grid-5 { grid-template-columns:minmax(0,1fr); }
        .cs-fg { min-width:0; }
        .cs-card { padding:1rem; min-width:0; }
        .cs-action-bar, .item-search-filters { flex-wrap:wrap; }
        .cs-action-bar > * { flex:1 1 auto; }
        .item-modal-dialog { margin:1rem; padding:1rem; }
        .cost-row { flex-wrap:wrap; gap:.35rem; }
        .cost-label { flex-wrap:wrap; }
    }
    .mobile-table-scroll { overflow-x:auto; max-width:100%; }
    .mobile-table-scroll .ply-table { min-width:760px; }

    @@media screen and (max-width:768px) {
        .mobile-page-header { flex-wrap:wrap; gap:1rem; }
        .mobile-page-header > div { min-width:0; }
        .mobile-page-header h2 { overflow-wrap:anywhere; }
    }

</style>

<div class="cs-wrapper">

    <div class="mobile-page-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <div>
            <h2>📋 @(isEdit ? "Edit Cost Sheet" : "Create Cost Sheet")</h2>
            <p style="color:#666; margin:0;">Carton / Box product costing & rate calculation</p>
        </div>
        <div style="display:flex; gap:.5rem;">
            <a href="/CostSheet/Settings" class="btn btn-outline-secondary">⚙️ Settings</a>
            <a href="/CostSheet/Index"    class="btn btn-outline-secondary">← Back</a>
        </div>
    </div>

    <!-- ── Row 1: Header ───────────────────────────────────────────────────── -->
    <div class="cs-card">
        <div class="cs-grid-4">
            <div class="cs-fg">
                <label>Sheet No</label>
                <input class="cs-input" id="sheetNo" readonly>
            </div>
            <div class="cs-fg">
                <label>Date</label>
                <input type="date" class="cs-input" id="sheetDate"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
            <div class="cs-fg">
                <label>Status</label>
                <select class="cs-input" id="status">
                    <option value="Draft">Draft</option>
                    <option value="Final">Final</option>
                </select>
            </div>
            @if (BranchSettings.Value.MultiBranchEnabled)
            {
                <div class="cs-fg">
                    <label>Branch</label>
                    <select class="cs-input" id="branchId">
                        <option value="1">Main Branch</option>
                        <option value="2">Branch 2</option>
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" id="branchId" value="1" />
            }
        </div>
        <div class="cs-grid-2" style="margin-top:.75rem;">
            <p class="cs-fg">Reusable box recipe: use this cost sheet for different customers. Choose the customer, quantity and agreed selling price when creating each production order.</p>
            <div class="cs-fg">
                <label>Finished Box Item (pieces)</label>
                <select class="cs-input" id="finishedItemId"><option value="">Select a finished-box item...</option></select>
                <small>Create the finished item under Items first. Material weights below are kg per ONE box.</small>
                <label>Item / Product Name</label>
                <input class="cs-input" id="itemName" placeholder="e.g. Rice Dresser Set">
            </div>
        </div>
    </div>

    <div class="cs-card">
        <div class="cs-fg"><label for="costingMethod">Calculation method</label>
            <select class="cs-input" id="costingMethod" onchange="applyCostingMethod(true)"><option value="Client">Client carton cost sheet</option><option value="Manual">Manual weights / existing method</option></select>
        </div>
        <div id="clientCostingPanel" style="margin-top:1rem">
            <span class="cs-section-title">Client costing rates & allowances</span>
            <p>Paper KG is calculated from sheet area, GSM and layer type. Operating charges = paper KG × rate per KG. GST uses base cost plus profit. Lamination No excludes the sheet, glue-lamination and lamination-chemical costs and stock quantities.</p>
            <div class="cs-grid-4"><div class="cs-fg"><label for="client_widthAllowanceIn">Width allowance (in)</label><input id="client_widthAllowanceIn" data-client-option="widthAllowanceIn" type="number" min="0" step="0.000001" value="0.63" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_lengthAllowanceIn">Length allowance (in)</label><input id="client_lengthAllowanceIn" data-client-option="lengthAllowanceIn" type="number" min="0" step="0.000001" value="0.55" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_fluteFactor">Flute factor</label><input id="client_fluteFactor" data-client-option="fluteFactor" type="number" min="0" step="0.000001" value="1.55" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_deckelUp">Deckel up</label><input id="client_deckelUp" data-client-option="deckelUp" type="number" min="0" step="0.000001" value="2" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_printingRate">Printing rate / 1,000 sq.in / colour</label><input id="client_printingRate" data-client-option="printingRate" type="number" min="0" step="0.000001" value="1" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_laminationRate">Lamination sheet rate / sq.ft</label><input id="client_laminationRate" data-client-option="laminationRate" type="number" min="0" step="0.000001" value="1" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_pinRate">Rate per pin</label><input id="client_pinRate" data-client-option="pinRate" type="number" min="0" step="0.000001" value="1.25" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_woodRate">Wood rate / paper KG</label><input id="client_woodRate" data-client-option="woodRate" type="number" min="0" step="0.000001" value="4" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_starchRate">Starch & chemicals rate / paper KG</label><input id="client_starchRate" data-client-option="starchRate" type="number" min="0" step="0.000001" value="4.5" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_glueApplications">Glue applications</label><input id="client_glueApplications" data-client-option="glueApplications" type="number" min="0" step="0.000001" value="2" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_silicateApplications">Silicate applications</label><input id="client_silicateApplications" data-client-option="silicateApplications" type="number" min="0" step="0.000001" value="2" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_glueLaminationApplications">Glue lamination applications</label><input id="client_glueLaminationApplications" data-client-option="glueLaminationApplications" type="number" min="0" step="0.000001" value="1" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_laminationChemicalApplications">Lamination chemical applications</label><input id="client_laminationChemicalApplications" data-client-option="laminationChemicalApplications" type="number" min="0" step="0.000001" value="1" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_glueLaminationRate">Glue lamination rate / KG</label><input id="client_glueLaminationRate" data-client-option="glueLaminationRate" type="number" min="0" step="0.000001" value="640" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_laminationChemicalRate">Lamination chemical rate / KG</label><input id="client_laminationChemicalRate" data-client-option="laminationChemicalRate" type="number" min="0" step="0.000001" value="200" class="cs-input" oninput="recalcAll()"></div>
<div class="cs-fg"><label for="client_glueLaminationItemId">Glue Lamination Stock Item (kg)</label><select id="client_glueLaminationItemId" class="cs-input client-stock" data-client-stock="glueLaminationItemId" onchange="recalcAll()"><option value="">Select stock item</option></select></div><div class="cs-fg"><label for="client_laminationChemicalItemId">Lamination Chemicals Stock Item (kg)</label><select id="client_laminationChemicalItemId" class="cs-input client-stock" data-client-stock="laminationChemicalItemId" onchange="recalcAll()"><option value="">Select stock item</option></select></div></div><p>For Lamination Yes, select the lamination adhesive stock items before Final, or set unused applications to 0. Lamination No requires neither item and consumes neither material. Do not repeat these materials under Other Materials.</p>
            <div class="cs-grid-4"><div class="cs-fg"><label>Paper weight / box (KG)</label><input id="client_paperWeightKg" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Deckel (in)</label><input id="client_deckelIn" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Wood cost</label><input id="client_woodCost" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Starch & chemical cost</label><input id="client_starchCost" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Glue lamination cost</label><input id="client_glueLaminationCost" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Lamination chemical cost</label><input id="client_laminationChemicalCost" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Operating costs incl. adhesives</label><input id="client_operatingCost" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>GST amount (cost + profit)</label><input id="client_gstAmount" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Additional tax amount</label><input id="client_additionalTaxAmount" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>W/H amount</label><input id="client_withholdingAmount" class="cs-input calc" readonly value="0"></div><div class="cs-fg"><label>Price after MOQ divisor</label><input id="client_pricePerUnit" class="cs-input calc" readonly value="0"></div></div><p>Commission A, commission B, profit and additional tax each use base cost × percentage ÷ 100. GST uses base cost plus profit. MOQ divides base cost + commissions + profit; GST, additional tax and withholding are added after division.</p>
        </div>
    </div>

    <!-- ── Row 2: Construction  +  Printing/Die ───────────────────────────── -->
    <div class="cs-dimensions" style="display:grid; grid-template-columns:1fr auto; gap:1rem;">

        <!-- Construction -->
        <div class="cs-card">
            <span class="cs-section-title">🏗️ Box Construction</span>
            <div class="cs-grid-3" style="margin-bottom:.75rem;">
                <div class="cs-fg">
                    <label>Box Style</label>
                    <select class="cs-input" id="boxStyle">
                        <option>Regular Slotted Carton (RSC)</option>
                        <option>Full Overlap Slotted (FOL)</option>
                        <option>Half Slotted Container (HSC)</option>
                        <option>Die Cut Box</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="cs-fg">
                    <label>Size Type</label>
                    <select class="cs-input" id="sizeType">
                        <option value="External">External</option>
                        <option value="Internal">Internal</option>
                    </select>
                </div>
                <div class="cs-fg">
                    <label>Unit</label>
                    <select class="cs-input" id="sizeUnit" onchange="recalcDimensions()">
                        <option value="mm">Millimeters</option>
                        <option value="in">Inches</option>
                    </select>
                </div>
            </div>
            <div class="cs-grid-4" style="margin-bottom:.75rem;">
                <div class="cs-fg">
                    <label>L</label>
                    <input type="number" class="cs-input" id="dimL" placeholder="0" oninput="recalcDimensions()">
                </div>
                <div class="cs-fg">
                    <label>W</label>
                    <input type="number" class="cs-input" id="dimW" placeholder="0" oninput="recalcDimensions()">
                </div>
                <div class="cs-fg">
                    <label>H</label>
                    <input type="number" class="cs-input" id="dimH" placeholder="0" oninput="recalcDimensions()">
                </div>
                <div class="cs-fg">
                    <label>Flap</label>
                    <input type="number" class="cs-input" id="dimFlap" placeholder="0" oninput="recalcDimensions()">
                </div>
            </div>
            <div class="cs-grid-4">
                <div class="cs-fg">
                    <label>Both Flap Gap</label>
                    <input type="number" class="cs-input" id="autoFlapGap" value="0" oninput="recalcDimensions()">
                </div>
                <div class="cs-fg">
                    <label>Sheet Width (in)</label>
                    <input type="number" class="cs-input calc" id="sheetWidthIn" step="0.01">
                </div>
                <div class="cs-fg">
                    <label>Sheet Length (in)</label>
                    <input type="number" class="cs-input calc" id="sheetLengthIn" step="0.01">
                </div>
                <div class="cs-fg">
                    <label>With Flap (in)</label>
                    <input type="number" class="cs-input calc" id="withFlap" step="0.01">
                </div>
            </div>
            <div class="cs-grid-4" style="margin-top:.75rem;">
                <div class="cs-fg">
                    <label>Adj. Width (in)</label>
                    <input type="number" class="cs-input calc" id="adjWidthIn" step="0.01">
                </div>
                <div class="cs-fg">
                    <label>Adj. Length 1 (in)</label>
                    <input type="number" class="cs-input calc" id="adjLength1In" step="0.01">
                </div>
                <div class="cs-fg">
                    <label>Adj. Length 2 (in)</label>
                    <input type="number" class="cs-input calc" id="adjLength2In" step="0.01">
                </div>
                <div class="cs-fg">
                    <label>Adj. Width (mm)</label>
                    <input type="number" class="cs-input calc" id="adjWidthMm" step="0.01">
                </div>
            </div>
            <div class="cs-grid-3" style="margin-top:.75rem;">
                <div class="cs-fg">
                    <label>Adj. Length (mm)</label>
                    <input type="number" class="cs-input calc" id="adjLengthMm" step="0.01">
                </div>
                <div class="cs-fg">
                    <label>Total Sheet (Sq.In)</label>
                    <input type="number" class="cs-input calc" id="totalSheetSqIn" step="0.01">
                </div>
                <div class="cs-fg" style="align-self:flex-end;">
                    <small style="color:#6b7280; font-size:.75rem;">
                        💡 Dimensions follow the selected calculation method
                    </small>
                </div>
            </div>
        </div>

        <!-- Printing + Die -->
        <div style="display:flex; flex-direction:column; gap:1rem; min-width:240px;">
            <div class="cs-card">
                <span class="cs-section-title">🖨️ Printing</span>
                <div class="cs-fg" style="margin-bottom:.5rem;">
                    <label>Type</label>
                    <select class="cs-input" id="printingType">
                        <option value="">None</option>
                        <option value="Pantone">Pantone</option>
                        <option value="Flexo">Flexo</option>
                        <option value="Offset">Offset</option>
                        <option value="Digital">Digital</option>
                    </select>
                </div>
                <div class="cs-fg" style="margin-bottom:.5rem;">
                    <label>Colors</label>
                    <input type="number" class="cs-input" id="printingColors" value="0" min="0" oninput="recalcAll()">
                </div>
                <div class="cs-fg">
                    <label>Cost</label>
                    <input type="number" class="cs-input" id="printingCost" value="0" step="0.01"
                           oninput="recalcAll()">
                </div>
            </div>
            <div class="cs-card">
                <span class="cs-section-title">✂️ Die / Tooling</span>
                <div class="cs-fg">
                    <label>Die / Tooling Cost</label>
                    <input type="number" class="cs-input" id="dickelCost" value="0" step="0.01"
                           oninput="recalcAll()">
                </div>
            </div>
        </div>
    </div>

    <!-- ── Row 3: Ply Table  +  Glue/Lamination ──────────────────────────── -->
    <div class="cs-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem;">
            <span class="cs-section-title">📄 Ply / Paper Layers</span>
        </div>

        <div class="mobile-table-scroll" role="region" aria-label="Ply details" tabindex="0"><table class="ply-table">
            <thead>
                <tr>
                    <th style="width:35px;">#</th>
                    <th style="width:55px;">Item ID</th>
                    <th style="width:180px;">Item Name</th>
                    <th style="width:120px;">Specification</th>
                    <th style="width:120px;">GSM / Layer Type</th>
                    <th style="width:110px;">Rate (per KG)</th>
                    <th style="width:100px;">KG / Box</th>
                    <th style="width:100px;">Cost</th>
                    <th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody id="plyBody"></tbody>
        </table></div>
        <button type="button" class="btn-add-ply" id="addPlyBtn">➕ Add Ply Layer</button>

        <!-- Glue / Silicate / Lamination row -->
        <div class="cs-grid-4" style="margin-top:1.2rem; padding-top:.75rem; border-top:2px dashed #e5e7eb;">
            <div class="cs-fg">
                <label>Lamination</label>
                <select class="cs-input" id="hasLamination" onchange="recalcAll()">
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                </select>
            </div>
            <div class="cs-fg">
                <label>Lamination Cost</label>
                <input type="number" class="cs-input" id="laminationCost" value="0" step="0.01"
                       oninput="recalcAll()">
            </div>
            <div class="cs-fg">
                <label>Glue Stock Item</label><select class="cs-input" id="glueItemId"><option value="">No glue</option></select>
                <label>Glue KG / Box</label><input type="number" class="cs-input" id="glueKgPerBox" min="0" step="0.000001" value="0" oninput="recalcAll()">
                <label>Glue Rate / KG</label>
                <input type="number" class="cs-input" id="glueRate" value="0" step="0.01" oninput="recalcAll()">
            </div>
            <div class="cs-fg">
                <label>Silicate Stock Item</label><select class="cs-input" id="silicateItemId"><option value="">No silicate</option></select>
                <label>Silicate KG / Box</label><input type="number" class="cs-input" id="silicateKgPerBox" min="0" step="0.000001" value="0" oninput="recalcAll()">
                <label>Silicate Rate / KG</label>
                <input type="number" class="cs-input" id="silicateRate" value="0" step="0.01" oninput="recalcAll()">
            </div>
        </div>
        <div class="cs-grid-3" style="margin-top:.75rem;">
            <div class="cs-fg">
                <label>Total Adhesive KG / Box (estimated)</label>
                <input type="number" class="cs-input" id="glueSilicateKg" value="0" step="0.000001" readonly
                       oninput="recalcAll()">
            </div>
            <div class="cs-fg">
                <label>Glue + Silicate Cost</label>
                <input type="number" class="cs-input calc" id="glueSilicateCost" value="0" step="0.01" readonly>
            </div>
            <div class="cs-fg">
                <label>📦 Paper Cost Total</label>
                <input type="number" class="cs-input calc" id="paperCost" value="0" readonly>
            </div>
        </div>
    </div>

    <!-- ── Other Materials (kg or pcs) ───────────────────────────────────── -->
    <div class="cs-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem;">
            <span class="cs-section-title">🧰 Other Materials (tape, labels, any raw material)</span>
        </div>
        <div class="mobile-table-scroll" role="region" aria-label="Other materials" tabindex="0"><table class="ply-table">
            <thead>
                <tr>
                    <th style="width:35px;">#</th>
                    <th style="width:240px;">Raw Material</th>
                    <th style="width:70px;">Unit</th>
                    <th style="width:120px;">Qty / Box</th>
                    <th style="width:110px;">Rate (per unit)</th>
                    <th style="width:100px;">Cost</th>
                    <th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody id="matBody"></tbody>
        </table></div>
        <button type="button" class="btn-add-ply" id="addMatBtn">➕ Add Material</button>
        <div class="cs-grid-3" style="margin-top:.75rem;">
            <div class="cs-fg">
                <label>Other Materials Cost (included in Paper Cost Total)</label>
                <input type="number" class="cs-input calc" id="otherMaterialsCost" value="0" readonly>
            </div>
        </div>
    </div>

    <!-- ── Row 4: Labour/Energy/Binding/Freight  +  Overheads  +  Final ──── -->
    <div class="cs-cost-columns" style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">

        <!-- Left: variable costs -->
        <div class="cs-card">
            <span class="cs-section-title">⚙️ Variable Costs</span>
            <div class="cost-panel">
                <div class="cost-row">
                    <span class="cost-label" data-client-weight-label="Labour">Labour Rate</span>
                    <input type="number" class="cost-pct" id="labourRate" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="labourCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-weight-label="Energy">Energy Rate</span>
                    <input type="number" class="cost-pct" id="energyRate" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="energyCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label">Binding</span>
                    <select class="cost-pct" id="bindingType" style="width:90px;" onchange="recalcAll()">
                        <option value="None">None</option>
                        <option value="Pins">Pins</option>
                        <option value="Glue">Glue</option>
                        <option value="Stitching">Stitching</option>
                    </select>
                    <span style="font-size:.8rem; color:#6b7280;">Pins</span>
                    <input type="number" class="cost-pct" id="bindingPins" value="0" min="0"
                           style="width:60px;" oninput="recalcAll()">
                    <input type="number" class="cost-val calc" id="bindingCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-weight-label="Freight">Freight Rate</span>
                    <input type="number" class="cost-pct" id="freightRate" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="freightCost" value="0" readonly>
                </div>
                <div class="cost-row" style="border-top:2px solid #bfdbfe; margin-top:.3rem; padding-top:.4rem;">
                    <strong class="cost-label">Sub-Total</strong>
                    <input type="number" class="cost-val calc" id="subTotal" value="0" readonly
                           style="width:120px; font-weight:700;">
                </div>
            </div>

            <span class="cs-section-title" style="margin-top:1rem; display:inline-block;">🏭 Overhead Costs</span>
            <div class="cost-panel">
                <div class="cost-row">
                    <span class="cost-label" data-client-rate-label="Waste">Waste %</span>
                    <input type="number" class="cost-pct" id="wastePct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="wasteCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-rate-label="Admin Exp">Admin Exp %</span>
                    <input type="number" class="cost-pct" id="adminExpPct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="adminExpCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-rate-label="Selling & Dist">Selling & Dist %</span>
                    <input type="number" class="cost-pct" id="sellingDistPct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="sellingDistCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-rate-label="Repair & Maint">Repair & Maint %</span>
                    <input type="number" class="cost-pct" id="repairMaintPct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="repairMaintCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-rate-label="Store & Spares">Store & Spares %</span>
                    <input type="number" class="cost-pct" id="storeSparesPct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="storeSparesCost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label" data-client-rate-label="Mfg Cost">Mfg Cost %</span>
                    <input type="number" class="cost-pct" id="mfgCostPct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Cost</span>
                    <input type="number" class="cost-val calc" id="mfgCostValue" value="0" readonly>
                </div>
                <div class="cost-row" style="border-top:2px solid #bfdbfe; margin-top:.3rem; padding-top:.4rem;">
                    <strong class="cost-label">Manufacturing Total</strong>
                    <input type="number" class="cost-val calc" id="manufacturingTotal" value="0" readonly
                           style="width:120px; font-weight:700;">
                </div>
            </div>
        </div>

        <!-- Right: Commission + Final -->
        <div class="cs-card">
            <span class="cs-section-title">💼 Commission</span>
            <div class="cost-panel" style="margin-bottom:1rem;">
                <div class="cost-row">
                    <span class="cost-label">Commission Person A</span>
                    <input type="text" class="cost-pct" id="commPersonA" placeholder="Name"
                           style="width:90px;" oninput="recalcAll()">
                    <input type="number" class="cost-pct" id="commPersonAPct" value="0" step="0.01" oninput="recalcAll()">
                    <input type="number" class="cost-val calc" id="commPersonACost" value="0" readonly>
                </div>
                <div class="cost-row">
                    <span class="cost-label">Commission Person B</span>
                    <input type="text" class="cost-pct" id="commPersonB" placeholder="Name"
                           style="width:90px;" oninput="recalcAll()">
                    <input type="number" class="cost-pct" id="commPersonBPct" value="0" step="0.01" oninput="recalcAll()">
                    <input type="number" class="cost-val calc" id="commPersonBCost" value="0" readonly>
                </div>
            </div>

            <span class="cs-section-title">🧾 Tax & Profit</span>
            <div class="cost-panel" style="margin-bottom:1rem;">
                <div class="cost-row">
                    <span class="cost-label">W/H Tax %</span>
                    <input type="number" class="cost-pct" id="whTaxPct" value="0" step="0.01" oninput="recalcAll()">
                </div>
                <div class="cost-row">
                    <span class="cost-label">GST %</span>
                    <input type="number" class="cost-pct" id="gstPct" value="0" step="0.01" oninput="recalcAll()">
                </div>
                <div class="cost-row">
                    <span class="cost-label">Profit %</span>
                    <input type="number" class="cost-pct" id="profitPct" value="0" step="0.01" oninput="recalcAll()">
                    <span style="font-size:.8rem; color:#6b7280;">→ Amt</span>
                    <input type="number" class="cost-val calc" id="profitAmount" value="0" readonly>
                </div>
            </div>

            <!-- Final amounts -->
            <div class="final-box">
                <div class="label">Final Cost (W/O GST)</div>
                <div class="amount" id="finalCostDisplay">0.00</div>
                <input type="hidden" id="finalCostWOGST" value="0">
            </div>

            <div class="cs-grid-2" style="margin-top:.75rem;">
                <div class="cs-fg">
                    <label>Based on MOQ</label>
                    <input type="number" class="cs-input" id="moq" value="1" min="1" oninput="recalcAll()">
                </div>
                <div class="cs-fg">
                    <label id="additionalTaxLabel">Tax % (on Final)</label>
                    <input type="number" class="cs-input" id="taxPct" value="0" step="0.01" oninput="recalcAll()">
                </div>
            </div>

            <div class="final-box" style="margin-top:.75rem; background:#065f46;">
                <div class="label">Final Rate (W/ GST)</div>
                <div class="amount" id="finalRateDisplay">0.00</div>
                <input type="hidden" id="finalRateWithGST" value="0">
            </div>

            <div class="cs-fg" style="margin-top:.75rem;">
                <label>Remarks</label>
                <textarea class="cs-input" id="remarks" rows="2" placeholder="Any additional notes..."></textarea>
            </div>
        </div>
    </div>

    <!-- ── Action buttons ─────────────────────────────────────────────────── -->
    <div class="cs-action-bar">
        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">🔄 Reset</button>
        <button type="button" class="btn btn-primary" onclick="saveDraft()">💾 Save as Draft</button>
        <button type="button" class="btn btn-success" onclick="saveFinal()">✅ Save as Final</button>
    </div>

</div><!-- cs-wrapper -->


<!-- ── Ply Item Lookup Modal ──────────────────────────────────────────────── -->
<div class="modal item-modal" id="plyItemModal">
    <div class="item-modal-dialog">
        <div class="item-modal-header">
            <h3 class="item-modal-title">🔍 Select Raw Material for Ply</h3>
            <button class="item-modal-close" onclick="closePlyItemModal()">&times;</button>
        </div>
        <div class="item-modal-body">
            <div class="item-search-filters">
                <input type="text" class="item-search-input" id="plyItemSearch"
                       placeholder="🔍 Search by item name or group..."
                       oninput="filterPlyItems()">
                <select class="item-filter-select" id="plyCategoryFilter" onchange="filterPlyItems()">
                    <option value="">All Groups</option>
                </select>
            </div>
            <div class="item-table-container">
                <table class="item-table">
                    <thead>
                        <tr>
                            <th style="width:60px;">ID</th>
                            <th>Item Name</th>
                            <th>Group Name</th>
                            <th style="width:110px;">Last Pur. Price</th>
                            <th style="width:100px;">Stock (KG)</th>
                        </tr>
                    </thead>
                    <tbody id="plyItemTableBody">
                        <tr><td colspan="5" style="text-align:center;padding:2rem;">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
            <div id="plyItemEmptyState" class="item-empty-state" style="display:none;">
                <div class="item-empty-icon">📦</div>
                <p>No items found. Please add items via Items first.</p>
            </div>
        </div>
        <div class="item-modal-footer">
            <button type="button" class="btn btn-danger" onclick="closePlyItemModal()">✖ Cancel</button>
            <button type="button" class="btn-select-item" id="selectPlyItemBtn"
                    onclick="confirmPlyItem()" disabled>✓ Select Item</button>
        </div>
    </div>
</div>

<input type="hidden" id="editCostSheetId" value="@(isEdit ? Model!.CostSheetId.ToString() : "0")">
<script src="~/js/client-costing.js" asp-append-version="true"></script>
<script src="~/js/costsheet.js" asp-append-version="true"></script>
