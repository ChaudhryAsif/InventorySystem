@using System.Security.Claims
@inject InventorySystem.Core.Services.IMenuService MenuService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - POS System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        .sidebar-submenu {
            list-style: none;
            padding: 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: #f8fafc;
        }

            .sidebar-item.open > .sidebar-submenu {
                max-height: 1000px; /* was 200px — increased to fit large submenus */
            }

        .sidebar-sublink {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.6rem 1rem 0.6rem 3.6rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.875rem;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }

        .sidebar-sublink:hover {
            background: #e8f4f8;
            color: var(--primary-color);
        }

        .sidebar-sublink.active {
            background: #e8f4f8;
            color: var(--primary-color);
            border-left-color: var(--primary-color);
            font-weight: 600;
        }

        .sidebar-arrow {
            margin-left: auto;
            font-size: 0.65rem;
            transition: transform 0.3s;
        }

        .sidebar-item.open > .sidebar-link .sidebar-arrow {
            transform: rotate(180deg);
        }

        /* ── User info in header ── */
        .header-user {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-left: auto;
        }

        .header-user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: 2px solid rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 700;
            color: white;
        }

        .header-user-name {
            font-size: 0.88rem;
            font-weight: 600;
            color: rgba(255,255,255,0.92);
            line-height: 1.2;
        }

        .header-user-role {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.6);
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.45rem 1rem;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            color: white;
            font-size: 0.83rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            text-decoration: none;
        }

        .btn-logout:hover {
            background: rgba(220, 53, 69, 0.55);
            border-color: rgba(220, 53, 69, 0.7);
        }

        /* Admin badge */
        .admin-badge {
            display: inline-block;
            background: #dc3545;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }

        /* SuperAdmin badge */
        .super-admin-badge {
        display: inline-block;
        background: linear-gradient(135deg, #6f42c1, #e83e8c);
        color: white;
        padding: 0.25rem 0.55rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        margin-left: 0.5rem;
        letter-spacing: 0.03em;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="main-header">
        <div class="header-content">
            <div class="header-left">
                <button class="menu-toggle">☰</button>
                <div class="header-logo">
                    <span style="font-size: 1.8rem;">📦</span>
                    <h1>POS System</h1>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                var isSuperAdmin = role == "SuperAdmin";
                var initials = string.Concat(fullName.Split(' ').Take(2).Select(w => w[0])).ToUpper();

                <div class="header-user">
                    <div class="header-user-avatar">@initials</div>
                    <div>
                        <div class="header-user-name">
                            @fullName
                            @if (isSuperAdmin)
                            {
                                <span class="super-admin-badge">⭐ SUPER ADMIN</span>
                            }
                        </div>
                        <div class="header-user-role">@role</div>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">🚪 Logout</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <!-- Sidebar with Dynamic Menu -->
    <aside class="sidebar" id="sidebarId">
        <ul class="sidebar-menu">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var userId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                var isSuperAdmin = role == "SuperAdmin";

                // SuperAdmin gets ALL menus; others get only permitted menus
                var menuItems = await MenuService.GetMenuForUserAsync(userId, isSuperAdmin);

                @foreach (var item in menuItems)
                {
                    if (item.Children != null && item.Children.Count > 0)
                    {
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var isOpen = item.Children.Any(c => c.Controller == currentController);
                        var menuIdSafe = System.Text.RegularExpressions.Regex.Replace(item.Name, @"[^\w]", "");

                        <li class="sidebar-item @(isOpen ? "open" : "")" id="@menuIdSafe">
                            <a href="#" class="sidebar-link"
                                   onclick="event.preventDefault(); document.getElementById('@menuIdSafe').classList.toggle('open')">
                                <span class="sidebar-icon">@item.Icon</span>
                                <span class="sidebar-text">@item.Name</span>
                                <span class="sidebar-arrow">▼</span>
                            </a>
                            <ul class="sidebar-submenu">
                                @foreach (var subitem in item.Children)
                                {
                                    var isSubActive = ViewContext.RouteData.Values["controller"]?.ToString() == subitem.Controller &&
                                                      ViewContext.RouteData.Values["action"]?.ToString() == subitem.Action;
                                    <li>
                                        <a asp-controller="@subitem.Controller" asp-action="@subitem.Action"
                                               class="sidebar-sublink @(isSubActive ? "active" : "")">
                                            @subitem.Icon @subitem.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        var isActive = ViewContext.RouteData.Values["controller"]?.ToString() == item.Controller;
                        <li class="sidebar-item">
                            <a asp-controller="@item.Controller" asp-action="@item.Action"
                                   class="sidebar-link @(isActive ? "active" : "")">
                                <span class="sidebar-icon">@item.Icon</span>
                                <span class="sidebar-text">@item.Name</span>
                            </a>
                        </li>
                    }
                }

                <!-- Admin Panel link — visible to SuperAdmin only -->
                @if (isSuperAdmin)
                {
                    <li class="sidebar-item" style="border-top: 1px solid #e0e0e0; margin-top: 1rem; padding-top: 1rem;">
                        <a asp-controller="Admin" asp-action="Dashboard"
                               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                            <span class="sidebar-icon">⚙️</span>
                            <span class="sidebar-text">Admin Panel</span>
                        </a>
                    </li>
                }

                <li class="sidebar-item" style="margin-top: auto; border-top: 1px solid #e0e0e0; padding-top: 1rem;">
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="width: 100%; margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-link" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer;">
                            <span class="sidebar-icon">🚪</span>
                            <span class="sidebar-text">Logout</span>
                        </button>
                    </form>
                </li>
            }
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-wrapper" id="mainContent">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

