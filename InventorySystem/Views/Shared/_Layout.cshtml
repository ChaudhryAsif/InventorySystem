<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - POS System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .sidebar-submenu {
            list-style: none;
            padding: 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: #f8fafc;
        }

        .sidebar-item.open > .sidebar-submenu {
            max-height: 200px;
        }

        .sidebar-sublink {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.6rem 1rem 0.6rem 3.6rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.875rem;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }

            .sidebar-sublink:hover {
                background: #e8f4f8;
                color: var(--primary-color);
            }

            .sidebar-sublink.active {
                background: #e8f4f8;
                color: var(--primary-color);
                border-left-color: var(--primary-color);
                font-weight: 600;
            }

        .sidebar-arrow {
            margin-left: auto;
            font-size: 0.65rem;
            transition: transform 0.3s;
        }

        .sidebar-item.open > .sidebar-link .sidebar-arrow {
            transform: rotate(180deg);
        }

        /* ── User info in header ── */
        .header-user {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-left: auto;
        }

        .header-user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: 2px solid rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 700;
            color: white;
        }

        .header-user-name {
            font-size: 0.88rem;
            font-weight: 600;
            color: rgba(255,255,255,0.92);
            line-height: 1.2;
        }

        .header-user-role {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.6);
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.45rem 1rem;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            color: white;
            font-size: 0.83rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            text-decoration: none;
        }

        .btn-logout:hover {
            background: rgba(220, 53, 69, 0.55);
            border-color: rgba(220, 53, 69, 0.7);
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="main-header">
        <div class="header-content">
            <div class="header-left">
                <button class="menu-toggle">☰</button>
                <div class="header-logo">
                    <span style="font-size: 1.8rem;">📦</span>
                    <h1>POS System</h1>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
                var role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                var initials = string.Concat(fullName.Split(' ').Take(2).Select(w => w[0])).ToUpper();

                <div class="header-user">
                    <div class="header-user-avatar">@initials</div>
                    <div>
                        <div class="header-user-name">@fullName</div>
                        <div class="header-user-role">@role</div>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">🚪 Logout</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebarId">
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a asp-controller="Home" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <span class="sidebar-icon">📊</span>
                    <span class="sidebar-text">Dashboard</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a asp-controller="Category" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                    <span class="sidebar-icon">📦</span>
                    <span class="sidebar-text">Item Category</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a asp-controller="Item" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Item" ? "active" : "")">
                    <span class="sidebar-icon">🏷️</span>
                    <span class="sidebar-text">Item Management</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a asp-controller="ItemRateList" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ItemRateList" ? "active" : "")">
                    <span class="sidebar-icon">💰</span>
                    <span class="sidebar-text">Product List</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a asp-controller="Parties" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Parties" ? "active" : "")">
                    <span class="sidebar-icon">👥</span>
                    <span class="sidebar-text">Parties (Accounts)</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a asp-controller="Purchase" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase" ? "active" : "")">
                    <span class="sidebar-icon">📝</span>
                    <span class="sidebar-text">Purchase Invoice</span>
                </a>
            </li>

            <li class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockAdjustment" ? "open" : "")"
                id="stockAdjustmentMenuItem">
                <a href="#" class="sidebar-link"
                   onclick="event.preventDefault(); document.getElementById('stockAdjustmentMenuItem').classList.toggle('open')">
                    <span class="sidebar-icon">📦</span>
                    <span class="sidebar-text">Stock Adjustment</span>
                    <span class="sidebar-arrow">▼</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="StockAdjustment" asp-action="Index"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockAdjustment" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            📋 All Adjustments
                        </a>
                    </li>
                    <li>
                        <a asp-controller="StockAdjustment" asp-action="Create"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockAdjustment" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                            ➕ New Adjustment
                        </a>
                    </li>
                </ul>
            </li>

            <li class="sidebar-item">
                <a asp-controller="Sale" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sale" ? "active" : "")">
                    <span class="sidebar-icon">🧾</span>
                    <span class="sidebar-text">Sale Invoice</span>
                </a>
            </li>

             <li class="sidebar-item">
                <a asp-controller="Consume" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consume" ? "active" : "")">
                    <span class="sidebar-icon">🏭</span>
                    <span class="sidebar-text">Raw Material Consume</span>
                </a>
            </li>

            <li class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() is "CostSheet" ? "open" : "")"
                id="costSheetMenuItem">
                <a href="#" class="sidebar-link"
                   onclick="event.preventDefault(); document.getElementById('costSheetMenuItem').classList.toggle('open')">
                    <span class="sidebar-icon">📦</span>
                    <span class="sidebar-text">Cost Sheet</span>
                    <span class="sidebar-arrow">▼</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="CostSheet" asp-action="Index"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "CostSheet" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            📋 All Cost Sheets
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CostSheet" asp-action="Create"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "CostSheet" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                            ➕ New Cost Sheet
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CostSheet" asp-action="Settings"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "CostSheet" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                            ⚙️ Settings
                        </a>
                    </li>
                </ul>
            </li>
            <li class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Production" ? "open" : "")"
                id="productionMenuItem">
                <a href="#" class="sidebar-link"
                   onclick="event.preventDefault(); document.getElementById('productionMenuItem').classList.toggle('open')">
                    <span class="sidebar-icon">🏭</span>
                    <span class="sidebar-text">Production</span>
                    <span class="sidebar-arrow">▼</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="Production" asp-action="Index"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Production" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            📋 All Orders
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Production" asp-action="Create"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Production" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                            ➕ New Order
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Returns submenu -->
            <li class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() is "PurchaseReturn" or "SaleReturn" ? "open" : "")"
                id="returnsMenuItem">
                <a href="#" class="sidebar-link"
                   onclick="event.preventDefault(); document.getElementById('returnsMenuItem').classList.toggle('open')">
                    <span class="sidebar-icon">↩️</span>
                    <span class="sidebar-text">Returns</span>
                    <span class="sidebar-arrow">▼</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="PurchaseReturn" asp-action="Index"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseReturn" ? "active" : "")">
                            📦 Purchase Return
                        </a>
                    </li>
                    <li>
                        <a asp-controller="SaleReturn" asp-action="Index"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "SaleReturn" ? "active" : "")">
                            🔄 Sale Return
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Reports submenu -->
            <li class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "open" : "")"
                id="reportsMenuItem">
                <a href="#" class="sidebar-link"
                   onclick="event.preventDefault(); document.getElementById('reportsMenuItem').classList.toggle('open')">
                    <span class="sidebar-icon">📈</span>
                    <span class="sidebar-text">Reports</span>
                    <span class="sidebar-arrow">▼</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="Report" asp-action="StockReport"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "StockReport" ? "active" : "")">
                            📦 Stock Report
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Report" asp-action="PurchaseReport"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "PurchaseReport" ? "active" : "")">
                            🧾 Purchase Report
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Report" asp-action="SaleReport"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "SaleReport" ? "active" : "")">
                            💵 Sale Report
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Report" asp-action="ConsumeReport"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "ConsumeReport" ? "active" : "")">
                            🏭 Consume Report
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Accounts submenu -->
            @* <li class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" ? "open" : "")"
                id="accountsMenuItem">
                <a href="#" class="sidebar-link"
                   onclick="event.preventDefault(); document.getElementById('accountsMenuItem').classList.toggle('open')">
                    <span class="sidebar-icon">💳</span>
                    <span class="sidebar-text">Accounts</span>
                    <span class="sidebar-arrow">▼</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="Accounts" asp-action="PaymentVoucher"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" && ViewContext.RouteData.Values["action"]?.ToString() == "PaymentVoucher" ? "active" : "")">
                            💸 Payment / Receipt
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Accounts" asp-action="PartyLedger"
                           class="sidebar-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" && ViewContext.RouteData.Values["action"]?.ToString() == "PartyLedger" ? "active" : "")">
                            📒 Party Ledger
                        </a>
                    </li>
                </ul>
            </li>

            <li class="sidebar-item">
                <a href="#" class="sidebar-link">
                    <span class="sidebar-icon">⚙️</span>
                    <span>Settings</span>
                </a>
            </li> *@
        </ul>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper" id="mainWrapper">
        <div class="content-area">
            @RenderBody()
        </div>
    </div>

    <script>
        // Sidebar toggle (hamburger)
        document.querySelector('.menu-toggle')?.addEventListener('click', () => {
            document.getElementById('sidebarId').classList.toggle('collapsed');
            document.getElementById('mainWrapper').classList.toggle('expanded');
        });
    </script>

    <!-- jQuery - loaded globally so all views can use it -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>